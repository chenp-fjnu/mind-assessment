# 微信小程序配置
WX_APPID=your_appid
WX_SECRET=your_secret

# 微信支付配置
WX_MCH_ID=your_mch_id
WX_MCH_SERIAL_NO=your_mch_serial_no
WX_MCH_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WX_API_V3_KEY=your_api_v3_key
# P3-18: 替换为实际部署域名
WX_NOTIFY_URL=https://api.mind-assessment.com/api/pay/notify
# 微信支付平台证书路径（用于回调验签）
WX_PLATFORM_CERT_PATH=./cert/wxpay_platform_cert.pem

# JWT 密钥（用于登录鉴权，请使用随机长字符串）
JWT_SECRET=please-change-this-to-a-random-long-string

# 服务端口
PORT=3000

# CORS 允许的来源（逗号分隔，生产环境必须配置）
CORS_ORIGINS=https://mind-assessment.com

# 存储适配器（memory | redis | mysql，默认 memory）
STORE_ADAPTER=memory
