<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">心理测评</text>
    <text class="hero-sub">用科学量表，先看清自己</text>
    <text class="hero-tag">{{moduleCount}} 套量表 · 9 大心理维度</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索量表名称 / 关键字"
      placeholder-class="search-ph"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" role="button" aria-label="清除搜索">✕</text>
  </view>

  <scroll-view class="type-bar" scroll-x="true">
    <view class="type-chip {{activeType === '' ? 'on' : ''}}" bindtap="onType" data-type="">全部</view>
    <view
      class="type-chip {{activeType === item.type ? 'on' : ''}}"
      wx:for="{{types}}"
      wx:key="type"
      wx:for-item="item"
      bindtap="onType"
      data-type="{{item.type}}"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{!groups.length}}" class="empty-search">
    <text class="empty-search-icon">🔎</text>
    <text class="empty-search-text">没有找到匹配的量表</text>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="type" wx:for-item="g">
    <view class="group-title">{{g.label}}</view>
    <view
      class="card item"
      wx:for="{{g.list}}"
      wx:key="id"
      wx:for-item="m"
      bindtap="goDetail"
      data-id="{{m.id}}"
      role="button"
      aria-label="{{m.name}}，{{m.desc}}，共 {{m.questionCount}} 题，约 {{m.duration}} 分钟"
    >
      <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
      <view class="item-body">
        <view class="item-head">
          <text class="item-name">{{m.name}}</text>
          <text class="badge-free">免费</text>
        </view>
        <text class="item-desc">{{m.desc}}</text>
        <view class="item-meta">
          <text>{{m.questionCount}} 题</text>
          <text class="dot">·</text>
          <text>约 {{m.duration}} 分钟</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
</view>
