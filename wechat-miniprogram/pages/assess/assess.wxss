/* ============================================
   测评列表页 - 统一设计系统
   ============================================ */

.hero {
  padding: 56rpx 40rpx 40rpx;
  background: var(--grad-assess-page);
}
.hero-title {
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-hero);
  font-weight: var(--font-weight-extrabold);
  letter-spacing: 4rpx;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--font-size-lg);
  margin-top: 16rpx;
  font-weight: var(--font-weight-medium);
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.95);
}
.pill .num {
  font-weight: var(--font-weight-bold);
  margin-right: 4rpx;
}
.pill.link {
  background: rgba(255, 255, 255, 0.26);
  color: var(--text-inverse);
  font-weight: var(--font-weight-semibold);
}
.group {
  margin: 24rpx 32rpx 0;
}
.group-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
  margin: 16rpx 4rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-xxl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.item-body {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.item-head {
  display: flex;
  align-items: center;
}
.item-name {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.badge-free {
  font-size: var(--font-size-xs);
  color: var(--text-success);
  background: var(--badge-success-bg);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  margin-left: 12rpx;
}
.item-desc {
  display: block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: var(--line-height-normal);
}
.item-meta {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 12rpx;
}
.arrow {
  color: var(--border-medium);
  font-size: var(--font-size-4xl);
  margin-left: 8rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 0 24rpx;
  height: 72rpx;
  background: var(--search-bg);
  border-radius: var(--radius-full);
  box-shadow: var(--search-shadow);
}
.search-icon {
  font-size: var(--font-size-2xl);
  margin-right: 12rpx;
  opacity: 0.6;
}
.search-input {
  flex: 1;
  font-size: var(--font-size-2xl);
  color: var(--text-primary);
}
.search-ph {
  color: var(--text-muted);
}
.search-clear {
  font-size: var(--font-size-2xl);
  color: var(--text-muted);
  padding: 0 8rpx;
}
.type-bar {
  white-space: nowrap;
  margin: 20rpx 32rpx 0;
}
.type-chip {
  display: inline-block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  background: var(--chip-bg);
  padding: 10rpx 28rpx;
  border-radius: var(--radius-full);
  margin-right: 16rpx;
}
.type-chip.on {
  color: var(--text-inverse);
  background: var(--color-assess);
}
.empty-search {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-search-icon {
  font-size: 64rpx;
  opacity: 0.5;
}
.empty-search-text {
  margin-top: 16rpx;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
}
.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-sm);
  padding: 40rpx 40rpx 40rpx;
}