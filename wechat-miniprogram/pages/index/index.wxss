.hero {
  padding: 48rpx 40rpx 32rpx;
  background: linear-gradient(135deg, #1e293b, #334155);
}
.hero-title {
  display: block;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  margin-top: 12rpx;
}
.group {
  margin: 24rpx 32rpx 0;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  margin: 16rpx 4rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.item-body {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.item-head {
  display: flex;
  align-items: center;
}
.item-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #1e293b;
}
.badge-free {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #16a34a;
  background: #dcfce7;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.badge-paid {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #d97706;
  background: #fef3c7;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.item-desc {
  display: block;
  font-size: 25rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}
.item-meta {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}
.dot {
  margin: 0 10rpx;
}
.arrow {
  color: #cbd5e1;
  font-size: 44rpx;
  margin-left: 8rpx;
}
.footer {
  text-align: center;
  color: #94a3b8;
  font-size: 22rpx;
  padding: 40rpx;
}
