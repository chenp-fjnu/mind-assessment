/* ============================================
   首页样式 - 使用统一设计系统
   ============================================ */

.scroll-page {
  background: var(--bg-primary);
  min-height: 100vh;
}

/* ============================================
   Hero 区 - 统一品牌渐变，白字清晰可读
   ============================================ */
.hero {
  padding: 60rpx 24rpx 52rpx;
  background: var(--grad-hero);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(80rpx);
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(20, 184, 166, 0.1);
  border-radius: 50%;
  filter: blur(80rpx);
}
.home-search {
  margin: 24rpx 32rpx 8rpx;
}
.home-search-input {
  width: 100%;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--text-primary);
  font-size: var(--font-size-body);
  border: 1rpx solid var(--border);
}
.home-search-input::placeholder {
  color: var(--text-muted);
}
.hero-title {
  position: relative;
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-hero);
  font-weight: var(--font-weight-extrabold);
  letter-spacing: -1rpx;
  line-height: var(--line-height-tight);
}
.hero-sub {
  position: relative;
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--font-size-lg);
  margin-top: 14rpx;
  font-weight: var(--font-weight-normal);
  line-height: var(--line-height-normal);
}
.hero-stats {
  position: relative;
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  flex-wrap: wrap;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 22rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-xl);
  backdrop-filter: blur(20rpx);
}
.stat-num { color: var(--text-inverse); font-size: var(--font-size-4xl); font-weight: var(--font-weight-extrabold); line-height: 1; }
.stat-label { color: rgba(255,255,255,0.85); font-size: var(--font-size-xs); margin-top: 4rpx; }

/* Dark mode hero adjustments */
.theme-dark .hero::before {
  background: rgba(255, 255, 255, 0.05);
}
.theme-dark .hero::after {
  background: rgba(76, 196, 176, 0.08);
}
.theme-dark .stat-item {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}

/* ============================================
   通用 Section
   ============================================ */
.section { margin: 40rpx 20rpx 0; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18rpx; }
.section-title { font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: var(--text-primary); }
.section-desc { font-size: var(--font-size-sm); color: var(--text-tertiary); margin-top: 4rpx; }

/* ============================================
   热门推荐：网格 2列，白字清晰
   ============================================ */
.hot-section { margin-top: 24rpx; }
.hot-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx;
  padding: 0 20rpx 20rpx;
}
.hot-card {
  position: relative; height: 128rpx; border-radius: var(--radius-xl);
  overflow: hidden; box-shadow: var(--shadow-md);
  background: var(--bg-card);
  border: 1rpx solid var(--border-light);
}
.hot-card-content {
  position: relative; display: flex; flex-direction: column; height: 100%;
  padding: 22rpx; color: var(--text-primary);
}
.hot-icon-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.hot-icon-wrap {
  width: 48rpx; height: 48rpx; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; background: var(--color-brand-50);
}
.hot-icon { font-size: 26rpx; color: var(--color-brand); }
.hot-kind {
  display: inline-block; padding: 3rpx 10rpx; font-size: 16rpx;
  font-weight: var(--font-weight-semibold); border-radius: var(--radius-full); white-space: nowrap;
  background: var(--bg-brand-strong); color: var(--color-brand);
}
.hot-name { font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 热门卡片图标区分色 */
.hot-card[data-kind="assess"] .hot-icon-wrap { background: var(--color-assess-light); }
.hot-card[data-kind="assess"] .hot-icon { color: var(--color-assess); }
.hot-card[data-kind="assess"] .hot-kind { background: var(--color-assess-light); color: var(--color-assess); }
.hot-card[data-kind="method"] .hot-icon-wrap { background: var(--color-method-light); }
.hot-card[data-kind="method"] .hot-icon { color: var(--color-method); }
.hot-card[data-kind="method"] .hot-kind { background: var(--color-method-light); color: var(--color-method); }
.hot-card[data-kind="train"] .hot-icon-wrap { background: var(--color-train-light); }
.hot-card[data-kind="train"] .hot-icon { color: var(--color-train); }
.hot-card[data-kind="train"] .hot-kind { background: var(--color-train-light); color: var(--color-train); }

/* ============================================
   三大板块入口 - 与热门卡片完全同色
   ============================================ */
.divider { height: 1rpx; background: var(--grad-divider); margin: 28rpx 20rpx; }
.sections { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14rpx; padding: 0 20rpx 36rpx; }
.section-block {
  position: relative; border-radius: var(--radius-xl); overflow: hidden;
  box-shadow: var(--shadow-md);
  padding: 28rpx 16rpx; display: flex; flex-direction: column;
  align-items: center; text-align: center; color: var(--text-inverse);
  transition: transform 0.2s, box-shadow 0.2s;
}
.section-block::before { content: ''; position: absolute; inset: 0; opacity: 0.95; border-radius: var(--radius-xl); }
.section-block:active { transform: scale(0.98); box-shadow: var(--shadow-sm); }
.section-icon {
  position: relative; width: 72rpx; height: 72rpx; border-radius: var(--radius-xl);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-bottom: 16rpx;
  background: rgba(255,255,255,0.22); color: var(--text-inverse);
}
.section-info { position: relative; display: flex; flex-direction: column; gap: 4rpx; }
.section-title { font-size: var(--font-size-lg); font-weight: var(--font-weight-extrabold); }
.section-count { font-size: var(--font-size-sm); color: rgba(255,255,255,0.88); }

/* 板块渐变 - 与热门卡片完全一致 */
.assess-block::before { background: var(--grad-assess-entry); }
.method-block::before { background: var(--grad-method-entry); }
.train-block::before { background: var(--grad-train-entry); }

/* Footer */
.footer { text-align: center; color: var(--text-muted); font-size: var(--font-size-xs); padding: 36rpx 24rpx 12rpx; }
.about-link { text-align: center; color: var(--text-brand); font-size: var(--font-size-md); font-weight: var(--font-weight-medium); padding: 0 24rpx 40rpx; }

/* ============================================
   响应式
   ============================================ */
@media (min-width: 768px) {
  .hero { padding: 80rpx 48rpx 68rpx; }
  .hero-title { font-size: 80rpx; }
  .hero-sub { font-size: var(--font-size-md); }
  .hero-stats { gap: 32rpx; }
  .stat-item { padding: 20rpx 30rpx; }
  .stat-num { font-size: var(--font-size-5xl); }
  .stat-label { font-size: var(--font-size-sm); }
  .hot-grid { grid-template-columns: repeat(4, 1fr); }
  .sections { grid-template-columns: repeat(3, 1fr); }
}