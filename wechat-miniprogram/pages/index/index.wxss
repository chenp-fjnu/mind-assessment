.scroll-page {
  min-height: 100vh;
  background: var(--bg-primary);
}
.hero {
  padding: 56rpx 40rpx 40rpx;
  background: var(--grad-hero);
}
.hero-title {
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-hero);
  font-weight: var(--font-weight-extrabold);
  letter-spacing: 4rpx;
  line-height: var(--line-height-tight);
}
.hero-sub {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--font-size-lg);
  line-height: var(--line-height-normal);
}
.home-card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
}
.home-card button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.goal-title,
.status-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-normal);
}
.goal-sub,
.status-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-md);
  line-height: var(--line-height-relaxed);
}
.status-eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: var(--text-brand);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}
.goal-options {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.goal-option {
  min-width: 0;
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-full);
  background: var(--color-brand-50);
  color: var(--color-brand-700);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  line-height: normal;
  white-space: nowrap;
}
.goal-option::after,
.primary-action::after,
.text-action::after {
  border: 0;
}
.goal-more,
.text-action {
  color: var(--text-brand);
  font-size: var(--font-size-sm);
}
.goal-more {
  display: block;
  margin-top: 12rpx;
  padding: 10rpx 8rpx;
}
.other-goals {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-brand);
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-normal);
}
.text-action {
  display: inline-block;
  padding: 8rpx 10rpx;
}
.home-card button.text-action {
  width: 100%;
  min-height: 64rpx;
  margin: 10rpx 0 0;
  padding: 12rpx 16rpx;
}
.browse-action {
  display: block;
  margin: 10rpx auto 0;
  padding: 10rpx 16rpx;
  background: transparent;
  text-align: center;
}
.primary-action {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: var(--grad-hero);
  color: var(--text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  line-height: normal;
  text-align: center;
}
.status-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
.action-divider {
  color: var(--border-medium);
  font-size: var(--font-size-sm);
}
.quick-entries {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin: 24rpx 32rpx 0;
}
.entry-card {
  min-height: 144rpx;
  padding: 18rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-inverse);
  box-shadow: var(--card-shadow);
}
.assess-entry { background: var(--grad-assess-entry); }
.method-entry { background: var(--grad-method-entry); }
.train-entry { background: var(--grad-train-entry); }
.entry-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.22);
}
.entry-icon {
  font-size: var(--font-size-3xl);
}
.entry-title {
  margin-top: 10rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
}
.search-control {
  margin: 20rpx 32rpx 0;
}
.search-toggle {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
}
.search-icon {
  flex: none;
  font-size: var(--font-size-xl);
  opacity: 0.65;
}
.search-label {
  flex: 1;
  color: var(--text-muted);
  font-size: var(--font-size-md);
}
.search-chevron {
  color: var(--text-brand);
  font-size: var(--font-size-xl);
}
.home-search {
  margin: 12rpx 32rpx 0;
}
.home-search-input {
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid var(--input-border);
  border-radius: var(--radius-full);
  background: var(--input-bg);
  box-shadow: var(--search-shadow);
  color: var(--input-text);
  font-size: var(--font-size-md);
}
.home-search-ph {
  color: var(--input-placeholder);
}
.more-toggle {
  min-height: 76rpx;
  margin: 16rpx 32rpx 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-brand);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.section {
  margin: 28rpx 32rpx 0;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  color: var(--text-primary);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
}
.section-more {
  padding: 8rpx 0 8rpx 12rpx;
  color: var(--text-brand);
  font-size: var(--font-size-sm);
}
.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}
.hot-card {
  min-width: 0;
  min-height: 132rpx;
  overflow: hidden;
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  background: var(--card-bg);
  box-shadow: var(--card-shadow);
}
.hot-card-content {
  min-height: 132rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 18rpx 20rpx;
}
.hot-icon-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}
.hot-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: var(--color-brand-50);
}
.hot-icon {
  font-size: var(--font-size-md);
}
.hot-kind {
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-full);
  background: var(--bg-brand-strong);
  color: var(--color-brand);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  white-space: nowrap;
}
.hot-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hot-card-assess .hot-icon-wrap,
.hot-card-assess .hot-kind {
  background: var(--color-assess-light);
}
.hot-card-assess .hot-icon,
.hot-card-assess .hot-kind {
  color: var(--color-assess);
}
.hot-card-method .hot-icon-wrap,
.hot-card-method .hot-kind {
  background: var(--color-method-light);
}
.hot-card-method .hot-icon,
.hot-card-method .hot-kind {
  color: var(--color-method-dark);
}
.hot-card-train .hot-icon-wrap,
.hot-card-train .hot-kind {
  background: var(--color-train-light);
}
.hot-card-train .hot-icon,
.hot-card-train .hot-kind {
  color: var(--color-train-dark);
}
.footer {
  padding: 36rpx 32rpx 12rpx;
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  text-align: center;
}
.about-link {
  padding: 12rpx 24rpx 40rpx;
  color: var(--text-brand);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  text-align: center;
}
@media (min-width: 768px) {
  .hot-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
