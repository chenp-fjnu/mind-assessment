/* ============================================
   首页样式 - 专业统一色系
   设计原则：
   1. 统一基调：以 Indigo 为主色调，三个功能色为同色相不同明度的变体
   2. 温和渐变：降低饱和度，提高明度，确保白字可读
   3. 语义一致：热门卡片与板块入口完全同色
   4. 深浅模式完美适配
   ============================================ */

:root {
  /* ===== 核心品牌色 - Indigo 为统一基调 ===== */
  --brand-50:  #eef2ff;
  --brand-100: #e0e7ff;
  --brand-200: #c7d2fe;
  --brand-300: #a5b4fc;
  --brand-400: #818cf8;
  --brand-500: #6366f1;   /* 主品牌色 */
  --brand-600: #4f46e5;
  --brand-700: #4338ca;
  --brand-800: #3730a3;
  --brand-900: #312e81;

  /* ===== 功能色 - 同色相体系，仅色相微调，明度饱和度统一 ===== */
  /* 测评 - 紫色系 (品牌色微调) */
  --assess-50:  #f5f3ff;
  --assess-100: #ede9fe;
  --assess-400: #a855f7;
  --assess-500: #8b5cf6;    /* 测评主色 */
  --assess-600: #7c3aed;
  --assess-700: #6d28d9;

  /* 方法 - 靛蓝系 (品牌色邻近) */
  --method-50:  #eef2ff;
  --method-100: #e0e7ff;
  --method-400: #818cf8;
  --method-500: #6366f1;    /* 方法主色 = 品牌色 */
  --method-600: #4f46e5;
  --method-700: #4338ca;

  /* 训练 - 青绿系 (品牌色对比色) */
  --train-50:  #f0fdfa;
  --train-100: #ccfbf1;
  --train-400: #2dd4bf;
  --train-500: #14b8a6;     /* 训练主色 */
  --train-600: #0d9488;
  --train-700: #0f766e;

  /* ===== 渐变预设 - 统一透明度与明度，确保白字对比度 ≥ 4.5:1 ===== */
  /* 页面级渐变 - 柔和、专业 */
  --grad-hero: linear-gradient(135deg, #6366f1 0%, #6366f1 50%, #14b8a6 100%);
  
  --grad-assess: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%);
  --grad-method: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
  --grad-train: linear-gradient(135deg, #14b8a6 0%, #2dd4bf 100%);

  /* 卡片/入口渐变 - 更高明度，白字对比度更好 */
  --grad-assess-card: linear-gradient(135deg, #9f67f7 0%, #b87aff 100%);
  --grad-method-card: linear-gradient(135deg, #7c7aff 0%, #a5b4fc 100%);
  --grad-train-card: linear-gradient(135deg, #2dd4bf 0%, #5eead4 100%);

  --grad-assess-entry: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  --grad-method-entry: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  --grad-train-entry: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);

  /* ===== 中性色 ===== */
  --bg-primary: #fafafa;
  --bg-secondary: #f4f4f5;
  --bg-tertiary: #f4f4f5;
  --card: #ffffff;
  --border: #e4e4e7;
  --border-light: #e4e4e7;
  --text: #18181b;
  --text-secondary: #52525b;
  --text-tertiary: #71717a;
  --text-muted: #a1a1aa;
  --muted: #a1a1aa;
  --hover: #f4f4f5;

  /* ===== 阴影 ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(15, 23, 42, 0.07);
  --shadow-lg: 0 16rpx 40rpx rgba(15, 23, 42, 0.09);
  --shadow-xl: 0 24rpx 56rpx rgba(15, 23, 42, 0.11);
  --shadow-glow: 0 0 40rpx rgba(99, 102, 241, 0.12);
}

.scroll-page {
  background: var(--bg-primary);
  min-height: 100vh;
}

/* ============================================
   Hero 区 - 统一品牌渐变，白字清晰可读
   ============================================ */
.hero {
  padding: 60rpx 24rpx 52rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #0d9488 100%);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(80rpx);
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(20, 184, 166, 0.1);
  border-radius: 50%;
  filter: blur(80rpx);
}
.hero-title {
  position: relative;
  display: block;
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.15;
}
.hero-sub {
  position: relative;
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  margin-top: 14rpx;
  font-weight: 400;
  line-height: 1.5;
}
.hero-stats {
  position: relative;
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  flex-wrap: wrap;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 22rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(20rpx);
}
.stat-num { color: #fff; font-size: 36rpx; font-weight: 800; line-height: 1; }
.stat-label { color: rgba(255,255,255,0.85); font-size: 20rpx; margin-top: 4rpx; }

/* ============================================
   通用 Section
   ============================================ */
.section { margin: 40rpx 20rpx 0; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.section-desc { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; }

/* ============================================
   热门推荐：网格 2列，白字清晰
   ============================================ */
.hot-section { margin-top: 24rpx; }
.hot-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx;
  padding: 0 20rpx 20rpx;
}
.hot-card {
  position: relative; height: 128rpx; border-radius: 20rpx;
  overflow: hidden; box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.08);
  background: #fff;
}
.hot-card-bg { position: absolute; inset: 0; opacity: 0.95; }
.hot-card-content {
  position: relative; display: flex; flex-direction: column; height: 100%;
  padding: 22rpx; color: #fff;
}
.hot-icon-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.hot-icon-wrap {
  width: 48rpx; height: 48rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; background: rgba(255,255,255,0.25);
}
.hot-icon { font-size: 26rpx; }
.hot-kind {
  display: inline-block; padding: 3rpx 10rpx; font-size: 16rpx;
  font-weight: 600; border-radius: 999rpx; white-space: nowrap;
  background: rgba(255,255,255,0.28); color: #fff;
}
.hot-name { font-size: 24rpx; font-weight: 700; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 热门卡片渐变 - 与入口一致，高明度保证白字对比度 */
.hot-card[data-kind="assess"] .hot-card-bg { background: linear-gradient(135deg, #9f67f7 0%, #b87aff 100%); }
.hot-card[data-kind="method"] .hot-card-bg { background: linear-gradient(135deg, #7c7aff 0%, #a5b4fc 100%); }
.hot-card[data-kind="train"] .hot-card-bg { background: linear-gradient(135deg, #2dd4bf 0%, #5eead4 100%); }

/* ============================================
   三大板块入口 - 与热门卡片完全同色
   ============================================ */
.divider { height: 1rpx; background: linear-gradient(90deg, transparent, #e4e4e7, transparent); margin: 28rpx 20rpx; }
.sections { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14rpx; padding: 0 20rpx 36rpx; }
.section-block {
  position: relative; border-radius: 18rpx; overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.08);
  padding: 28rpx 16rpx; display: flex; flex-direction: column;
  align-items: center; text-align: center; color: #fff;
  transition: transform 0.2s, box-shadow 0.2s;
}
.section-block::before { content: ''; position: absolute; inset: 0; opacity: 0.95; border-radius: 18rpx; }
.section-block:active { transform: scale(0.98); box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.08); }
.section-icon {
  position: relative; width: 72rpx; height: 72rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-bottom: 16rpx;
  background: rgba(255,255,255,0.22); color: #fff;
}
.section-info { position: relative; display: flex; flex-direction: column; gap: 4rpx; }
.section-title { font-size: 26rpx; font-weight: 800; }
.section-count { font-size: 20rpx; color: rgba(255,255,255,0.88); }

/* 板块渐变 - 与热门卡片完全一致 */
.assess-block::before { background: linear-gradient(135deg, #9f67f7 0%, #b87aff 100%); }
.method-block::before { background: linear-gradient(135deg, #7c7aff 0%, #a5b4fc 100%); }
.train-block::before { background: linear-gradient(135deg, #2dd4bf 0%, #5eead4 100%); }

/* Footer */
.footer { text-align: center; color: #a1a1aa; font-size: 20rpx; padding: 36rpx 24rpx 12rpx; }
.about-link { text-align: center; color: #6366f1; font-size: 22rpx; font-weight: 500; padding: 0 24rpx 40rpx; }

/* ============================================
   Dark Mode - 深色模式渐变更深、更柔和
   ============================================ */
@media (prefers-color-scheme: dark) {
  :root {
    --bg-primary: #09090b; --bg-secondary: #18181b; --card: #18181b;
    --border: #27272a; --text: #fafafa; --text-secondary: #a1a1aa;
    --text-tertiary: #71717a; --text-muted: #71717a; --muted: #71717a;
    --hover: #27272a; --bg-primary: #09090b; --bg-secondary: #18181b;
    --card: #18181b; --border: #27272a; --text: #fafafa;
    --text-secondary: #a1a1aa; --text-tertiary: #71717a;
    --text-muted: #71717a; --muted: #71717a; --hover: #27272a;
    --bg-primary: #09090b; --bg-secondary: #18181b;
    --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.2);
    --shadow-md: 0 8rpx 24rpx rgba(0,0,0,0.25);
    --shadow-lg: 0 16rpx 40rpx rgba(0,0,0,0.3);
    --shadow-xl: 0 24rpx 56rpx rgba(0,0,0,0.35);
  }
  .scroll-page { background: var(--bg-primary); }
  .stat-item { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); }
  .hot-card { box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.3); }
  .hot-card-bg { opacity: 0.88; }
  .hot-icon-wrap { background: rgba(255,255,255,0.12); }
  .hot-kind { background: rgba(255,255,255,0.18); }
  .section-block { color: #fff; }
  .section-block::before { opacity: 0.85; }
  .section-icon { background: rgba(255,255,255,0.12); color: #fff; }
  .hot-card-bg { opacity: 0.88; }
  .hot-icon-wrap { background: rgba(255,255,255,0.12); }
  .hot-kind { background: rgba(255,255,255,0.18); }
  .section-block { color: #fff; }
  .section-block::before { opacity: 0.82; }
  .section-icon { background: rgba(255,255,255,0.1); color: #fff; }
  .divider { background: linear-gradient(90deg, transparent, #27272a, transparent); }
  .section-title { color: #fff; }
  .section-count { color: rgba(255,255,255,0.8); }
  .footer { color: #71717a; }
  .about-link { color: #818cf8; }
  .stat-item { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.08); }
}

/* 响应式 */
@media (min-width: 768px) {
  .hero { padding: 80rpx 48rpx 68rpx; }
  .hero-title { font-size: 60rpx; }
  .hero-sub { font-size: 28rpx; }
  .hero-stats { gap: 32rpx; }
  .stat-item { padding: 20rpx 30rpx; }
  .stat-num { font-size: 42rpx; }
  .stat-label { font-size: 22rpx; }
  .hot-grid { grid-template-columns: repeat(4, 1fr); }
  .sections { grid-template-columns: repeat(3, 1fr); }
}