.hero {
  padding: 56rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #1e293b, #7c3aed);
}
.hero-title {
  display: block;
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: 27rpx;
  margin-top: 16rpx;
  font-weight: 500;
}
.hero-tag {
  display: inline-block;
  margin-top: 22rpx;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
}
.group {
  margin: 24rpx 32rpx 0;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  margin: 16rpx 4rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.item-body {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.item-head {
  display: flex;
  align-items: center;
}
.item-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #1e293b;
}
.badge-free {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #16a34a;
  background: #dcfce7;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.badge-paid {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #d97706;
  background: #fef3c7;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.item-desc {
  display: block;
  font-size: 25rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}
.item-meta {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #64748b;
  margin-top: 12rpx;
}
.dot {
  margin: 0 10rpx;
}
.arrow {
  color: #cbd5e1;
  font-size: 44rpx;
  margin-left: 8rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 0 24rpx;
  height: 72rpx;
  background: var(--card);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}
.search-ph {
  color: var(--muted);
}
.search-clear {
  font-size: 28rpx;
  color: var(--muted);
  padding: 0 8rpx;
}
.type-bar {
  white-space: nowrap;
  margin: 20rpx 32rpx 0;
}
.type-chip {
  display: inline-block;
  font-size: 25rpx;
  color: #475569;
  background: #eef2f7;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}
.type-chip.on {
  color: #fff;
  background: #334155;
}
.empty-search {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-search-icon {
  font-size: 64rpx;
  opacity: 0.5;
}
.empty-search-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #64748b;
}
.footer {
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
  padding: 40rpx 40rpx 0;
}
.about-link {
  text-align: center;
  color: #7c3aed;
  font-size: 25rpx;
  padding: 16rpx 40rpx 40rpx;
}
.history {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
}
.hist-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.hist-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}
.hist-actions {
  display: flex;
  align-items: center;
}
.hist-all {
  font-size: 24rpx;
  color: #475569;
  margin-right: 20rpx;
}
.hist-clear {
  font-size: 24rpx;
  color: #64748b;
}
.hist-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx solid #f1f5f9;
}
.hist-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.hist-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.hist-name {
  font-size: 28rpx;
  color: #1e293b;
}
.hist-time {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.methods-banner {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  background: linear-gradient(135deg, #0d9488, #7c3aed);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.08);
}
.mb-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: rgba(255, 255, 255, 0.18);
  flex-shrink: 0;
}
.mb-body {
  flex: 1;
  margin-left: 22rpx;
  overflow: hidden;
}
.mb-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #fff;
}
.mb-sub {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

@media (prefers-color-scheme: dark) {
  .group-title {
    color: var(--text2);
  }
  .item-name {
    color: var(--text);
  }
  .badge-free {
    color: #4ade80;
    background: #14331f;
  }
  .badge-paid {
    color: #fbbf24;
    background: #3a2c0a;
  }
  .item-desc {
    color: var(--sub);
  }
  .item-meta {
    color: var(--muted);
  }
  .arrow {
    color: #475569;
  }
  .footer {
    color: var(--muted);
  }
  .hist-title {
    color: var(--text);
  }
  .hist-clear {
    color: var(--muted);
  }
  .hist-all {
    color: var(--text2);
  }
  .hist-item {
    border-top-color: var(--border);
  }
  .hist-name {
    color: var(--text);
  }
  .hist-time {
    color: var(--muted);
  }
  .search-bar {
    background: var(--card);
  }
  .search-input {
    color: var(--text);
  }
  .search-ph {
    color: var(--muted);
  }
  .search-clear {
    color: var(--muted);
  }
  .type-chip {
    color: var(--text2);
    background: var(--chip);
  }
  .type-chip.on {
    color: #fff;
    background: #475569;
  }
  .empty-search-text {
    color: var(--muted);
  }
}

.pillars {
  display: flex;
  margin: 24rpx 24rpx 0;
  gap: 16rpx;
}
.pillar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.08);
}
.pillar.assess { background: linear-gradient(135deg, #1e293b, #334155); }
.pillar.method { background: linear-gradient(135deg, #0d9488, #7c3aed); }
.pillar.train { background: linear-gradient(135deg, #f43f5e, #f59e0b); }
.pillar-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: rgba(255, 255, 255, 0.18);
  flex-shrink: 0;
}
.pillar-text { flex: 1; min-width: 0; margin-left: 14rpx; overflow: hidden; }
.pillar-title { display: block; color: #fff; font-size: 26rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pillar-sub { display: block; color: rgba(255, 255, 255, 0.85); font-size: 20rpx; margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pillar .arrow { color: rgba(255, 255, 255, 0.8); flex-shrink: 0; }

.resume-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
}
.resume {
  flex: 1 1 200rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-left: 8rpx solid transparent;
  box-sizing: border-box;
}

.section { margin: 32rpx 32rpx 0; }
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.section-title { font-size: 30rpx; font-weight: 700; color: #1e293b; }
.section-more { font-size: 24rpx; color: #7c3aed; }
.card-row { white-space: nowrap; }
.mini-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: 28rpx 20rpx;
  margin-right: 20rpx;
  background: var(--card);
  border: 3rpx solid transparent;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.06);
  vertical-align: top;
}
.mini-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.mini-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1e293b;
  margin-top: 16rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180rpx;
}
.mini-meta { font-size: 22rpx; color: #64748b; margin-top: 6rpx; }

@media (prefers-color-scheme: dark) {
  .section-title { color: var(--text); }
  .mini-name { color: var(--text); }
  .mini-meta { color: var(--muted); }
  .pillar-title { color: #fff; }
}
