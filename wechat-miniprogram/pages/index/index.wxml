<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">心智探索局</text>
    <text class="hero-sub">测评 · 方法 · 训练，陪你认识并锻炼心智</text>
    <text class="hero-tag">{{moduleCount}} 套测评表 · {{methodCount}} 个方法 · {{gameCount}} 个训练</text>
  </view>

  <view wx:if="{{hotPicks.length}}" class="section hot-section">
    <view class="section-head">
      <text class="section-title">🔥 热门推荐</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card hot-card"
        wx:for="{{hotPicks}}"
        wx:key="index"
        wx:for-item="h"
        bindtap="goHot"
        data-item="{{h}}"
        style="border-color:{{h.tint}};"
        role="button"
        aria-label="{{h.name}}"
      >
        <view class="mini-icon hot-icon" style="background:{{h.tint}};">{{h.icon}}</view>
        <text class="mini-name">{{h.name}}</text>
        <text class="mini-meta hot-tag">{{h.kindLabel}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">心理测评</text>
      <text class="section-more" bindtap="goAssess" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredAssess}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goDetail"
        data-id="{{m.id}}"
        style="border-color:{{m.tint}};"
        role="button"
        aria-label="{{m.name}}"
      >
        <view class="mini-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <text class="mini-name">{{m.name}}</text>
        <text class="mini-meta">{{m.questionCount}} 题</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">精选方法</text>
      <text class="section-more" bindtap="goMethods" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredMethods}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goMethodDetail"
        data-id="{{m.id}}"
        style="border-color:{{m.tint}};"
        role="button"
        aria-label="{{m.name}}"
      >
        <view class="mini-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <text class="mini-name">{{m.name}}</text>
        <text class="mini-meta">{{m.interactive ? '可练习' : '方法'}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">脑力训练</text>
      <text class="section-more" bindtap="goTrain" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredGames}}"
        wx:key="id"
        wx:for-item="g"
        bindtap="goGame"
        data-id="{{g.id}}"
        style="border-color:{{g.tint}};"
        role="button"
        aria-label="{{g.name}}"
      >
        <view class="mini-icon" style="background:{{g.tint}};">{{g.icon}}</view>
        <text class="mini-name">{{g.name}}</text>
        <text class="mini-meta">{{g.dimLabel}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
  <view class="about-link" bindtap="goAbout" role="button" aria-label="关于心智探索局">关于心智探索局 ›</view>
</view>