<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">心智探索局</text>
    <text class="hero-sub">认识自己，从一次测评开始</text>
    <text class="hero-tag">14 套专业量表 · 纯前端离线测评</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索量表名称 / 关键字"
      placeholder-class="search-ph"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <scroll-view class="type-bar" scroll-x="true">
    <view
      class="type-chip {{activeType === '' ? 'on' : ''}}"
      bindtap="onType"
      data-type=""
    >全部</view>
    <view
      class="type-chip {{activeType === item.type ? 'on' : ''}}"
      wx:for="{{types}}"
      wx:key="type"
      wx:for-item="item"
      bindtap="onType"
      data-type="{{item.type}}"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{!groups.length}}" class="empty-search">
    <text class="empty-search-icon">🔎</text>
    <text class="empty-search-text">没有找到匹配的量表</text>
  </view>

  <view wx:if="{{history.length}}" class="card history">
    <view class="hist-head">
      <text class="hist-title">最近测评</text>
      <view class="hist-actions">
        <text class="hist-all" bindtap="goAllHistory">全部 ›</text>
        <text class="hist-clear" bindtap="clearHistory">清空</text>
      </view>
    </view>
    <view
      class="hist-item"
      wx:for="{{history}}"
      wx:key="time"
      bindtap="goHistory"
      data-idx="{{index}}"
      role="button"
      aria-label="查看历史测评 {{item.name}}，结果 {{item.summary}}"
    >
      <text class="hist-icon">{{item.icon}}</text>
      <view class="hist-info">
        <text class="hist-name">{{item.name}}</text>
        <text class="hist-time">{{item.timeText}} · {{item.summary}}{{item.level ? ' · ' + item.level : ''}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="type" wx:for-item="g">
    <view class="group-title">{{g.label}}</view>
    <view
      class="card item"
      wx:for="{{g.list}}"
      wx:key="id"
      wx:for-item="m"
      bindtap="goDetail"
      data-id="{{m.id}}"
      role="button"
      aria-label="{{m.name}}，{{m.desc}}，共 {{m.questionCount}} 题，约 {{m.duration}} 分钟"
    >
      <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
      <view class="item-body">
        <view class="item-head">
          <text class="item-name">{{m.name}}</text>
          <text wx:if="{{m.paid}}" class="badge-paid">¥{{m.price}} 付费</text>
          <text wx:else class="badge-free">免费</text>
        </view>
        <text class="item-desc">{{m.desc}}</text>
        <view class="item-meta">
          <text>{{m.questionCount}} 题</text>
          <text class="dot">·</text>
          <text>约 {{m.duration}} 分钟</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
</view>
