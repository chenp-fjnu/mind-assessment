<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">心智测评中心</text>
    <text class="hero-sub">14 套专业量表 · 纯前端离线测评</text>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="type" wx:for-item="g">
    <view class="group-title">{{g.label}}</view>
    <view
      class="card item"
      wx:for="{{g.list}}"
      wx:key="id"
      wx:for-item="m"
      bindtap="goDetail"
      data-id="{{m.id}}"
    >
      <view class="item-icon" style="background:{{m.color}}22;">{{m.icon}}</view>
      <view class="item-body">
        <view class="item-head">
          <text class="item-name">{{m.name}}</text>
          <text wx:if="{{m.paid}}" class="badge-paid">¥{{m.price}}</text>
          <text wx:else class="badge-free">免费</text>
        </view>
        <text class="item-desc">{{m.desc}}</text>
        <view class="item-meta">
          <text>{{m.questionCount}} 题</text>
          <text class="dot">·</text>
          <text>约 {{m.duration}} 分钟</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
</view>
