<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">心智探索局</text>
    <text class="hero-sub">认识自己，从测评与方法开始</text>
    <text class="hero-tag">{{moduleCount}} 套量表 · {{methodCount}} 个方法</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索量表或方法"
      placeholder-class="search-ph"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" role="button" aria-label="清除搜索">✕</text>
  </view>

  <scroll-view class="type-bar" scroll-x="true">
    <text
      wx:for="{{typeChips}}"
      wx:key="key"
      class="type-chip {{activeType === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelectType"
      role="button"
      aria-label="{{item.label}}"
    >{{item.label}}</text>
  </scroll-view>

  <view class="pillars">
    <view class="pillar assess" bindtap="goAssess" role="button" aria-label="去测评">
      <view class="pillar-icon">📋</view>
      <view class="pillar-text">
        <text class="pillar-title">心理测评</text>
        <text class="pillar-sub">看清自己在哪里</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="pillar method" bindtap="goMethods" role="button" aria-label="去方法">
      <view class="pillar-icon">🧰</view>
      <view class="pillar-text">
        <text class="pillar-title">行动方法</text>
        <text class="pillar-sub">每天可用的练习</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{resume}}" class="resume card" bindtap="goResume" role="button" aria-label="继续上次测评">
    <view class="item-icon" style="background:rgba(124,58,237,0.12);">{{resume.icon}}</view>
    <view class="item-body">
      <view class="item-head"><text class="item-name">继续：{{resume.name}}</text></view>
      <text class="item-desc">上次测评于 {{resume.timeText}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">热门测评</text>
      <text class="section-more" bindtap="goAssess" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredAssess}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goDetail"
        data-id="{{m.id}}"
        style="border-color:{{m.tint}};"
        role="button"
        aria-label="{{m.name}}"
      >
        <view class="mini-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <text class="mini-name">{{m.name}}</text>
        <text class="mini-meta">{{m.questionCount}} 题</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">精选方法</text>
      <text class="section-more" bindtap="goMethods" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredMethods}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goMethodDetail"
        data-id="{{m.id}}"
        style="border-color:{{m.tint}};"
        role="button"
        aria-label="{{m.name}}"
      >
        <view class="mini-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <text class="mini-name">{{m.name}}</text>
        <text class="mini-meta">{{m.interactive ? '可练习' : '方法'}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="group">
    <view class="group-title">全部量表（{{filteredList.length}}）</view>
    <view
      wx:for="{{filteredList}}"
      wx:key="id"
      wx:for-item="m"
      class="item card"
      bindtap="goDetail"
      data-id="{{m.id}}"
      role="button"
      aria-label="{{m.name}}"
    >
      <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
      <view class="item-body">
        <view class="item-head">
          <text class="item-name">{{m.name}}</text>
          <text wx:if="{{!m.paid}}" class="badge-free">免费</text>
          <text wx:else class="badge-paid">¥{{m.price}}</text>
        </view>
        <text class="item-desc">{{m.desc}}</text>
        <view class="item-meta">
          <text>{{m.questionCount}} 题</text>
          <text class="dot">·</text>
          <text>{{m.typeLabel}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{filteredList.length === 0}}" class="empty-search">
      <text class="empty-search-icon">🔍</text>
      <text class="empty-search-text">没有找到匹配的量表</text>
    </view>
  </view>

  <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
  <view class="about-link" bindtap="goAbout" role="button" aria-label="关于心智探索局">关于心智探索局 ›</view>
</view>
