<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page">
    <!-- Hero 区 -->
    <view class="hero">
      <text class="hero-title">心智探索局</text>
      <text class="hero-sub">测评 · 方法 · 训练，陪你认识并锻炼心智</text>
      <view class="hero-stats">
        <view class="stat-item">
          <text class="stat-num">{{moduleCount}}</text>
          <text class="stat-label">套测评</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{methodCount}}</text>
          <text class="stat-label">个方法</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{gameCount}}</text>
          <text class="stat-label">个训练</text>
        </view>
      </view>
    </view>

    <!-- 热门推荐：网格布局 2列，精简卡片 -->
    <view wx:if="{{hotPicks.length}}" class="section hot-section">
      <view class="section-head">
        <text class="section-title">🔥 热门推荐</text>
      </view>
      <view class="hot-grid">
        <view
          class="hot-card"
          data-kind="{{h.kind}}"
          wx:for="{{hotPicks}}"
          wx:key="index"
          wx:for-item="h"
          bindtap="goHot"
          data-item="{{h}}"
          role="button"
          aria-label="{{h.name}}，{{h.kindLabel}}"
        >
          <view class="hot-card-content">
            <view class="hot-icon-row">
              <view class="hot-icon-wrap">
                <text class="hot-icon">{{h.icon}}</text>
              </view>
              <text class="hot-kind">{{h.kindLabel}}</text>
            </view>
            <text class="hot-name">{{h.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分隔线 -->
    <view class="divider"></view>

    <!-- 最近探索：跨板块最近记录，去重展示，避免与底部 Tab 入口重复 -->
    <view wx:if="{{recentItems.length}}" class="section recent-section">
      <view class="section-head">
        <text class="section-title">🕘 最近探索</text>
        <text class="section-more" bindtap="goHistory" role="button" aria-label="查看全部记录">全部记录 ›</text>
      </view>
      <view class="hot-grid">
        <view
          class="hot-card"
          data-kind="{{h.kind}}"
          wx:for="{{recentItems}}"
          wx:key="index"
          wx:for-item="h"
          bindtap="goHot"
          data-item="{{h}}"
          role="button"
          aria-label="{{h.name}}，{{h.kindLabel}}"
        >
          <view class="hot-card-content">
            <view class="hot-icon-row">
              <view class="hot-icon-wrap">
                <text class="hot-icon">{{h.icon}}</text>
              </view>
              <text class="hot-kind">{{h.kindLabel}}</text>
            </view>
            <text class="hot-name">{{h.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
    <view class="about-link" bindtap="goAbout" role="button" aria-label="关于心智探索局">关于心智探索局 ›</view>
  </view>
</view>