<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">心智探索局</text>
    <text class="hero-sub">测评 · 方法 · 训练，陪你认识并锻炼心智</text>
    <text class="hero-tag">{{moduleCount}} 套测评表 · {{methodCount}} 个方法 · {{gameCount}} 个训练</text>
  </view>

  <view class="pillars">
    <view class="pillar assess" bindtap="goAssess" role="button" aria-label="去测评">
      <view class="pillar-icon">📋</view>
      <view class="pillar-text">
        <text class="pillar-title">心理测评</text>
        <text class="pillar-sub">看清自己在哪里</text>
      </view>
    </view>
    <view class="pillar method" bindtap="goMethods" role="button" aria-label="去方法">
      <view class="pillar-icon">🧰</view>
      <view class="pillar-text">
        <text class="pillar-title">行动方法</text>
        <text class="pillar-sub">每天可用的练习</text>
      </view>
    </view>
    <view class="pillar train" bindtap="goTrain" role="button" aria-label="去训练">
      <view class="pillar-icon">🧠</view>
      <view class="pillar-text">
        <text class="pillar-title">脑力训练</text>
        <text class="pillar-sub">{{gameCount}} 个游戏练起来</text>
      </view>
    </view>
  </view>

  <view wx:if="{{resumes.length}}" class="resume-list">
    <view
      wx:for="{{resumes}}"
      wx:key="type"
      wx:for-item="r"
      class="resume card"
      style="border-left-color:{{r.color}};"
      bindtap="goResumeItem"
      data-item="{{r}}"
      role="button"
      aria-label="{{r.title}}"
    >
      <view class="item-icon" style="background:{{r.color}}1f;">{{r.icon}}</view>
      <view class="item-body">
        <view class="item-head"><text class="item-name">{{r.title}}</text></view>
        <text class="item-desc">{{r.sub}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">热门测评</text>
      <text class="section-more" bindtap="goAssess" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredAssess}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goDetail"
        data-id="{{m.id}}"
        style="border-color:{{m.tint}};"
        role="button"
        aria-label="{{m.name}}"
      >
        <view class="mini-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <text class="mini-name">{{m.name}}</text>
        <text class="mini-meta">{{m.questionCount}} 题</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">精选方法</text>
      <text class="section-more" bindtap="goMethods" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredMethods}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goMethodDetail"
        data-id="{{m.id}}"
        style="border-color:{{m.tint}};"
        role="button"
        aria-label="{{m.name}}"
      >
        <view class="mini-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <text class="mini-name">{{m.name}}</text>
        <text class="mini-meta">{{m.interactive ? '可练习' : '方法'}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">脑力训练</text>
      <text class="section-more" bindtap="goTrain" role="button">全部 ›</text>
    </view>
    <scroll-view class="card-row" scroll-x="true">
      <view
        class="mini-card"
        wx:for="{{featuredGames}}"
        wx:key="id"
        wx:for-item="g"
        bindtap="goGame"
        data-id="{{g.id}}"
        style="border-color:{{g.tint}};"
        role="button"
        aria-label="{{g.name}}"
      >
        <view class="mini-icon" style="background:{{g.tint}};">{{g.icon}}</view>
        <text class="mini-name">{{g.name}}</text>
        <text class="mini-meta">{{g.dimLabel}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="footer">结果仅供自我探索与娱乐，不构成医学诊断</view>
  <view class="about-link" bindtap="goAbout" role="button" aria-label="关于心智探索局">关于心智探索局 ›</view>
</view>
