<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page">
    <view class="profile-hero">
      <button 
        class="avatar-btn" 
        open-type="chooseAvatar" 
        bindchooseavatar="onChooseAvatar"
        aria-label="选择微信头像">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFit"></image>
        <view wx:else class="avatar avatar-fallback">
          <text class="avatar-icon">🧠</text>
        </view>
      </button>

      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        placeholder-class="nickname-ph"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        aria-label="昵称"
        maxlength="20"
      />
    </view>

    <view class="card form">
      <view class="row">
        <text class="label">性别</text>
        <picker class="picker" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="picker-value">{{genderOptions[genderIndex]}} <text class="arrow">›</text></view>
        </picker>
      </view>
      <view class="row">
        <text class="label">生日</text>
        <picker class="picker" mode="date" value="{{birthday}}" bindchange="onBirthdayChange">
          <view class="picker-value">
            <text wx:if="{{birthday}}">{{birthday}}（{{ageText}}）</text>
            <text wx:else>未设置</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="card meta">
      <text class="meta-line">用户 ID：{{userId}}</text>
      <text class="meta-line" wx:if="{{createdText}}">创建于：{{createdText}}</text>
      <text class="meta-tip">资料仅保存在本机，接入账号后可同步到云端。</text>
    </view>

    <view class="actions">
      <button class="btn save-btn" bindtap="save" type="primary" aria-label="保存">保存</button>
    </view>
  </view>

  <view class="privacy-mask" wx:if="{{showPrivacy}}">
    <view class="privacy-pop">
      <view class="privacy-title">隐私授权提示</view>
      <view class="privacy-content">
        设置头像、昵称需要使用你的微信头像与昵称信息。本程序所有题目、计分与结果均在你的设备本地完成，不会上传任何数据。
        <text class="privacy-link" bindtap="onOpenPrivacy">《用户隐私保护指引》</text>
      </view>
      <view class="privacy-btns">
        <button class="privacy-btn refuse" bindtap="onPrivacyDisagree">暂不允许</button>
        <button class="privacy-btn agree" id="agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgree">同意并继续</button>
      </view>
    </view>
  </view>
</view>