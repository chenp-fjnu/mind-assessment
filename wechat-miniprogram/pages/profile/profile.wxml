<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page">
    <view class="profile-hero">
      <button 
        class="avatar-btn" 
        open-type="chooseAvatar" 
        bindchooseavatar="onChooseAvatar" 
        bindtap="onAvatarTap"
        aria-label="选择头像">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-fallback">
          <text class="avatar-icon">🧠</text>
        </view>
      </button>
      <view class="avatar-hint">点击更换头像</view>
      
      <input
        class="nickname-input"
        type="nickname"
        placeholder="点击设置昵称"
        placeholder-class="nickname-ph"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        aria-label="昵称"
        maxlength="20"
      />
    </view>

    <view class="card form">
      <view class="row">
        <text class="label">性别</text>
        <picker class="picker" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="picker-value">{{genderOptions[genderIndex]}} <text class="arrow">›</text></view>
        </picker>
      </view>
      <view class="row">
        <text class="label">生日</text>
        <picker class="picker" mode="date" value="{{birthday}}" bindchange="onBirthdayChange">
          <view class="picker-value">
            <text wx:if="{{birthday}}">{{birthday}}（{{ageText}}）</text>
            <text wx:else>未设置</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="card meta">
      <text class="meta-line">用户 ID：{{userId}}</text>
      <text class="meta-line" wx:if="{{createdText}}">创建于：{{createdText}}</text>
      <text class="meta-tip">资料仅保存在本机，接入账号后可同步到云端。</text>
    </view>

    <view class="actions">
      <button class="btn save-btn" bindtap="save" type="primary" aria-label="保存">保存</button>
    </view>
  </view>
</view>