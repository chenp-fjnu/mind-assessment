.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 24rpx;
}

.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.avatar-fallback {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  background: var(--bg-brand);
}

.avatar-actions {
  display: flex;
  margin-top: 24rpx;
}

.avatar-btn.ghost {
  margin: 0 10rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-size-base);
  color: var(--text-brand);
  background: var(--bg-brand);
  border-radius: var(--radius-full);
}

.avatar-btn.ghost::after {
  border: none;
}

.nickname-input {
  margin-top: 24rpx;
  width: 60%;
  min-width: 320rpx;
  max-width: 520rpx;
  text-align: center;
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--border-light);
}

.nickname-ph {
  color: var(--text-muted);
}

.form {
  margin: 24rpx 32rpx 0;
  padding: 8rpx 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: var(--font-size-lg);
  color: var(--text-secondary);
}

.picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.picker-value {
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  display: flex;
  align-items: center;
}

.arrow {
  margin-left: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-size-xl);
}

.meta {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-line {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  word-break: break-all;
}

.meta-tip {
  margin-top: 8rpx;
  font-size: var(--font-size-xs);
  color: var(--text-muted);
}

.actions {
  margin: 40rpx 32rpx 24rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  font-size: var(--font-size-lg);
}
