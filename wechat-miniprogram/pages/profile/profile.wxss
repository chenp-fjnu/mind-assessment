/* ============================================
   个人资料页 - 完整样式 (参考微信官方/StarBuddy最佳实践)
   ============================================ */

.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
}

/* ===== 头像按钮 - 核心样式重置 (微信官方最佳实践) ===== */
.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  /* 微信 button 默认样式完全重置 - 关键！ */
  -webkit-appearance: none;
  appearance: none;
  -webkit-tap-highlight-color: transparent;
}

/* 去除 button 伪元素边框 */
.avatar-btn::after {
  border: none;
  display: none;
}

/* 点击态反馈 */
.avatar-btn:active {
  opacity: 0.8;
}

/* 头像图片 */
.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-primary-lighter, #e8ebf5);
  display: block;
  background: var(--bg-brand, #f3f4f8);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 头像占位符 */
.avatar-fallback {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-brand, #f3f4f8);
  border: 4rpx solid var(--color-primary-lighter, #e8ebf5);
}

.avatar-icon {
  font-size: 80rpx;
  line-height: 1;
}

/* 头像提示文字 */
.avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted, #9e9e9e);
  text-align: center;
}

/* ===== 昵称输入框 ===== */
.nickname-input {
  margin-top: 24rpx;
  width: 70%;
  min-width: 320rpx;
  max-width: 520rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary, #1f1f1f);
  padding: 16rpx 0;
  border: none;
  border-bottom: 2rpx solid var(--border-light, #ededed);
  background: transparent;
  font-family: inherit;
}

.nickname-input:focus {
  border-bottom-color: var(--color-primary, #5a5fc7);
  outline: none;
}

.nickname-ph {
  color: var(--text-muted, #9e9e9e);
}

/* ===== 表单卡片 ===== */
.form {
  margin: 32rpx 32rpx 0;
  padding: 16rpx 24rpx;
  background: var(--bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1px solid var(--border-light, #ededed);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--border-light, #ededed);
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-secondary, #4a4a4a);
}

.picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.picker-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary, #1f1f1f);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.arrow {
  margin-left: 12rpx;
  color: var(--text-muted, #9e9e9e);
  font-size: 36rpx;
}

/* ===== 元信息卡片 ===== */
.meta {
  margin: 32rpx 32rpx 0;
  padding: 24rpx;
  background: var(--bg-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1px solid var(--border-light, #ededed);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-line {
  font-size: 26rpx;
  color: var(--text-tertiary, #6b6b6b);
  word-break: break-all;
}

.meta-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted, #9e9e9e);
}

/* ===== 保存按钮 ===== */
.actions {
  margin: 48rpx 32rpx 40rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background: var(--color-primary, #5a5fc7);
  color: #ffffff;
  border: none;
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* ===== 隐私授权弹窗 ===== */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.privacy-pop {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-content {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #576b95;
}

.privacy-btns {
  display: flex;
}

.privacy-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.agree {
  background: var(--color-primary, #5a5fc7);
  color: #ffffff;
}

.privacy-btn.refuse {
  background: #f2f2f2;
  color: #333;
  margin-right: 20rpx;
}

/* ===== 响应式适配 ===== */
@media (max-width: 360px) {
  .avatar-btn { width: 180rpx; height: 180rpx; }
  .avatar, .avatar-fallback { width: 180rpx; height: 180rpx; }
  .nickname-input { font-size: 32rpx; }
  .label { font-size: 28rpx; }
}