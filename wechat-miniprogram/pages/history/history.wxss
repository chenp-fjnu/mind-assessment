/* ============================================
   历史记录页 - 统一设计系统
   ============================================ */

.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx 8rpx;
}
.tabs {
  display: flex;
  margin: 16rpx 32rpx 0;
  padding: 6rpx;
  background: var(--chip-bg);
  border-radius: var(--radius-full);
}
.tab {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-lg);
  color: var(--text-tertiary);
  padding: 14rpx 0;
  border-radius: var(--radius-full);
}
.tab.on {
  background: var(--card-bg);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  box-shadow: var(--shadow-sm);
}
.search {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 0;
  padding: 0 24rpx;
  background: var(--search-bg);
  border-radius: var(--radius-full);
  box-shadow: var(--search-shadow);
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-size-lg);
  color: var(--text-primary);
}
.search-clear {
  font-size: var(--font-size-lg);
  color: var(--text-tertiary);
  padding: 0 8rpx;
}
.m-tag {
  font-size: var(--font-size-sm);
  color: var(--color-method-dark);
  background: var(--color-method-light);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  margin-left: 14rpx;
}
.t-tag {
  font-size: var(--font-size-sm);
  color: var(--color-brand-700);
  background: var(--color-brand-100);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  margin-left: 14rpx;
}
.title {
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}
.clear {
  font-size: var(--font-size-md);
  color: var(--text-muted);
}
.bar-actions {
  display: flex;
  align-items: center;
}
.export {
  font-size: var(--font-size-md);
  color: var(--color-brand);
  margin-right: 28rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}
.empty-icon {
  font-size: 96rpx;
}
.empty-text {
  font-size: var(--font-size-3xl);
  color: var(--text-tertiary);
  margin-top: 24rpx;
  font-weight: var(--font-weight-semibold);
}
.empty-sub {
  font-size: var(--font-size-md);
  color: var(--text-muted);
  margin-top: 12rpx;
}
.list {
  padding: 16rpx 32rpx 48rpx;
}
.filter-bar {
  white-space: nowrap;
  padding: 8rpx 24rpx 4rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  margin-right: 16rpx;
  background: var(--chip-bg);
  color: var(--chip-text);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
}
.chip.on {
  background: var(--color-brand);
  color: var(--text-inverse);
}
.chip-icon {
  margin-right: 8rpx;
}
.section {
  margin: 16rpx 32rpx 0;
}
.section-head {
  margin-bottom: 12rpx;
}
.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}
.in-progress-section {
  margin-top: 8rpx;
}
.in-progress-section .h-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
}
.in-progress-tag {
  background: var(--color-train);
  color: var(--text-inverse);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
}
.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 10rpx 0;
}
.progress-text {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}
.progress-bar {
  flex: 1;
  height: 8rpx;
  background: var(--progress-bg);
  border-radius: var(--radius-full);
  overflow: hidden;
}
.h-del {
  font-size: var(--font-size-md);
  color: var(--text-error);
  padding: 8rpx 16rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.brand-foot {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-sm);
  padding: 32rpx;
}
.hist-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.h-icon {
  font-size: 48rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.h-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.h-head {
  display: flex;
  align-items: center;
}
.h-name {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.h-level {
  font-size: var(--font-size-xs);
  color: var(--text-inverse);
  background: var(--color-brand);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  margin-left: 14rpx;
}
.h-sum {
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 8rpx;
}
.h-time {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
  margin-top: 4rpx;
}