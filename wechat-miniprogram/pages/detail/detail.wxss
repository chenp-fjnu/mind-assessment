.banner {
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}
.banner-icon {
  font-size: 80rpx;
}
.banner-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 16rpx;
}
.banner-short {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.card.section {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}
.sec-text {
  display: block;
  font-size: 27rpx;
  color: #475569;
  line-height: 1.7;
  margin-top: 16rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.tag {
  font-size: 23rpx;
  color: #475569;
  background: #f1f5f9;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
}
.free-tag {
  color: #16a34a;
  background: #dcfce7;
}
.paid-tag {
  color: #d97706;
  background: #fef3c7;
}
.resume {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eff6ff;
}
.resume-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.resume-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
}
.resume-sub {
  font-size: 23rpx;
  color: #475569;
  margin-top: 6rpx;
}
.resume-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}
.hist-row {
  display: flex;
  margin-top: 20rpx;
}
.hist-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid #f1f5f9;
}
.hist-col:last-child {
  border-right: none;
}
.hist-col-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e293b;
}
.hist-col-label {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}
.row {
  display: flex;
  justify-content: space-around;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}
.stat-label {
  font-size: 23rpx;
  color: #64748b;
  margin-top: 6rpx;
}
.tip {
  background: #fffbeb;
}
.tip-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #b45309;
}
.tip-text {
  display: block;
  font-size: 25rpx;
  color: #92701a;
  line-height: 1.7;
  margin-top: 12rpx;
}
.bottom-bar {
  padding: 32rpx;
  margin-top: 24rpx;
}
.start-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
}
.brand-foot {
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
  padding: 32rpx;
}

.invalid {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: var(--bg);
}
.invalid-icon {
  font-size: 96rpx;
}
.invalid-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 24rpx;
}
.invalid-sub {
  font-size: 25rpx;
  color: var(--muted);
  margin-top: 12rpx;
  text-align: center;
}
.invalid .btn.home {
  margin-top: 40rpx;
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
}

@media (prefers-color-scheme: dark) {
  .sec-title {
    color: var(--text);
  }
  .sec-text {
    color: var(--text2);
  }
  .tag {
    color: var(--text2);
    background: var(--chip);
  }
  .free-tag {
    color: #4ade80;
    background: #14331f;
  }
  .brand-foot {
    color: var(--muted);
  }
  .paid-tag {
    color: #fbbf24;
    background: #3a2c0a;
  }
  .resume {
    background: #16243f;
  }
  .resume-title {
    color: #93c5fd;
  }
  .resume-sub {
    color: var(--text2);
  }
  .hist-col {
    border-right-color: var(--border);
  }
  .hist-col-num {
    color: var(--text);
  }
  .hist-col-label {
    color: var(--muted);
  }
  .stat-num {
    color: var(--text);
  }
  .stat-label {
    color: var(--muted);
  }
  .tip {
    background: #2a2410;
  }
  .tip-title {
    color: #fbbf24;
  }
  .tip-text {
    color: #d6b25e;
  }
}
