/* ============================================
   详情页 - 统一设计系统
   ============================================ */

.banner {
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--grad-assess-page);
  color: var(--text-inverse);
}
.banner-icon {
  font-size: 80rpx;
}
.banner-name {
  font-size: var(--font-size-5xl);
  font-weight: var(--font-weight-bold);
  margin-top: 16rpx;
}
.banner-short {
  font-size: var(--font-size-lg);
  opacity: 0.85;
  margin-top: 8rpx;
}
.card.section {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.sec-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}
.sec-text {
  display: block;
  font-size: var(--font-size-lg);
  color: var(--text-tertiary);
  line-height: var(--line-height-relaxed);
  margin-top: 16rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.tag {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  background: var(--bg-tertiary);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  margin: 0 12rpx 12rpx 0;
}
.free-tag {
  color: var(--text-success);
  background: var(--badge-success-bg);
}
.paid-tag {
  color: var(--text-warning);
  background: var(--badge-warning-bg);
}
.resume {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-brand-50);
  padding: 24rpx 32rpx;
  border-radius: var(--radius-xl);
  margin: 24rpx 32rpx 0;
}
.resume-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.resume-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand-700);
}
.resume-sub {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.resume-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-size-lg);
  margin-left: 20rpx;
  background: var(--color-brand);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
}
.hist-row {
  display: flex;
  margin-top: 20rpx;
}
.hist-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid var(--border-light);
}
.hist-col:last-child {
  border-right: none;
}
.hist-col-num {
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}
.hist-col-label {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.row {
  display: flex;
  justify-content: space-around;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: var(--font-size-5xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}
.stat-label {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.tip {
  background: var(--result-note-bg);
  border: 2rpx solid var(--result-note-border);
  border-radius: var(--radius-xl);
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
}
.tip-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--result-note-text);
}
.tip-text {
  display: block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  line-height: var(--line-height-relaxed);
  margin-top: 12rpx;
}
.bottom-bar {
  padding: 32rpx;
  margin-top: 24rpx;
}
.start-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: var(--font-size-xl);
  background: var(--grad-assess-card);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
}
.brand-foot {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-sm);
  padding: 32rpx 40rpx 40rpx;
}
.share-bar {
  display: flex;
  gap: 20rpx;
  margin: 8rpx 32rpx 0;
}
.btn.ghost {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--btn-ghost-bg);
  color: var(--color-brand);
  border: 2rpx solid var(--color-brand);
  font-size: var(--font-size-lg);
  border-radius: var(--radius-xl);
}
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 300px;
  height: 380px;
}

.invalid {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: var(--bg-primary);
}
.invalid-icon {
  font-size: 96rpx;
}
.invalid-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-top: 24rpx;
}
.invalid-sub {
  font-size: var(--font-size-md);
  color: var(--text-muted);
  margin-top: 12rpx;
  text-align: center;
}
.invalid .btn.home {
  margin-top: 40rpx;
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--font-size-xl);
  border-radius: var(--radius-full);
  background: var(--color-brand);
  color: var(--text-inverse);
}

/* 测评·方法·训练 关联 */
.link-intro {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  line-height: var(--line-height-normal);
  margin: 16rpx 0 8rpx;
}
.link-group {
  margin-top: 24rpx;
}
.link-label {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}
.rec {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--border-light);
}
.rec:first-of-type {
  border-top: none;
  padding-top: 0;
}
.rec-icon {
  font-size: var(--font-size-4xl);
  margin-right: 18rpx;
  flex-shrink: 0;
}
.rec-body {
  flex: 1;
  overflow: hidden;
}
.rec-name {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.rec-sum {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
  line-height: var(--line-height-normal);
}
.rec-badge {
  margin-left: 12rpx;
  font-size: var(--font-size-xs);
  color: var(--text-success);
  background: var(--badge-success-bg);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}
.rec-badge.dim-badge {
  color: var(--text-info, #0891b2);
  background: rgba(8, 145, 178, 0.12);
}
.arrow {
  margin-left: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-size-xl);
  flex-shrink: 0;
}