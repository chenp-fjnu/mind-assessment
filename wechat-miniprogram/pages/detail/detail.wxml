<view class="theme-wrapper {{themeClass}}">
  <view wx:if="{{invalid}}" class="invalid">
    <text class="invalid-icon">🧭</text>
    <text class="invalid-title">未找到该测评</text>
    <text class="invalid-sub">请返回首页重新选择</text>
    <button class="btn home" style="background:{{meta.color || '#7c3aed'}};color:{{meta.colorText || '#fff'}};" bindtap="goHome" aria-label="返回首页">返回首页</button>
  </view>

  <view class="scroll-page" wx:elif="{{meta.name}}">
    <view class="banner" style="background:{{meta.gradient}};color:#fff;">
      <text class="banner-icon">{{meta.icon}}</text>
      <text class="banner-name">{{meta.name}}</text>
      <text class="banner-short">{{meta.shortName}}</text>
    </view>

    <view class="card section">
      <text class="sec-title">测评简�?/text>
      <text class="sec-text">{{meta.desc}}</text>
      <view class="tags">
        <text class="tag" wx:for="{{meta.tags}}" wx:key="*this">{{item}}</text>
        <text class="tag free-tag">免费体验</text>
      </view>
    </view>

    <view wx:if="{{meta.reference}}" class="card section">
      <text class="sec-title">参考来源与版本</text>
      <text class="sec-text">{{meta.reference}}</text>
      <text wx:if="{{meta.scoring}}" class="sec-text scoring">{{meta.scoring}}</text>
    </view>

    <view wx:if="{{relatedMethods.length || relatedGames.length}}" class="card section">
      <text class="sec-title">🔗 测评 · 方法 · 训练 关联</text>
      <text class="sec-text link-intro">测评帮你「认识自己」，方法论给出「怎么用」，训练提供「练起来」——三者构成「认�?�?方法 �?练习」的闭环。以下基于本量表主题推荐�?/text>

      <view wx:if="{{relatedMethods.length}}" class="link-group">
        <text class="link-label">🧰 相关方法�?/text>
        <view
          class="rec"
          wx:for="{{relatedMethods}}"
          wx:key="id"
          wx:for-item="m"
          bindtap="goMethod"
          data-id="{{m.id}}"
          role="button"
          aria-label="{{m.name}}，{{m.summary}}"
        >
          <text class="rec-icon">{{m.icon}}</text>
          <view class="rec-body">
            <text class="rec-name">{{m.name}}</text>
            <text class="rec-sum">{{m.summary}}</text>
          </view>
          <text wx:if="{{m.interactive}}" class="rec-badge">可练</text>
          <text class="arrow">�?/text>
        </view>
      </view>

      <view wx:if="{{relatedGames.length}}" class="link-group">
        <text class="link-label">🎮 相关训练</text>
        <view
          class="rec"
          wx:for="{{relatedGames}}"
          wx:key="id"
          wx:for-item="g"
          bindtap="goGame"
          data-id="{{g.id}}"
          role="button"
          aria-label="{{g.name}}，{{g.summary}}"
        >
          <text class="rec-icon">{{g.icon}}</text>
          <view class="rec-body">
            <text class="rec-name">{{g.name}}</text>
            <text class="rec-sum">{{g.summary}}</text>
          </view>
          <text class="rec-badge dim-badge">{{g.dimLabel}}</text>
          <text class="arrow">�?/text>
        </view>
      </view>
    </view>

    <view wx:if="{{history.count}}" class="card section">
      <text class="sec-title">历史成绩</text>
      <view class="hist-row">
        <view class="hist-col">
          <text class="hist-col-num">{{history.last.summary}}</text>
          <text class="hist-col-label">上次结果</text>
        </view>
        <view wx:if="{{history.best}}" class="hist-col">
          <text class="hist-col-num">{{history.best.summary}}</text>
          <text class="hist-col-label">历史最�?/text>
        </view>
        <view class="hist-col">
          <text class="hist-col-num">{{history.count}}</text>
          <text class="hist-col-label">测评次数</text>
        </view>
      </view>
    </view>

    <view class="card section row">
      <view class="stat">
        <text class="stat-num">{{meta.questionCount}}</text>
        <text class="stat-label">题目�?/text>
      </view>
      <view class="stat">
        <text class="stat-num">{{meta.duration}}</text>
        <text class="stat-label">分钟</text>
      </view>
      <view class="stat">
        <text class="stat-num">离线</text>
        <text class="stat-label">无需联网</text>
      </view>
    </view>

    <view class="card section tip">
      <text class="tip-title">温馨提示</text>
      <text class="tip-text">本测评结果基于自陈量表，仅供自我探索与娱乐参考，不构成任何医学诊断或专业建议。请凭第一直觉作答�?/text>
    </view>

    <view class="bottom-bar">
      <button class="btn start-btn" style="background:{{meta.color}};color:{{meta.colorText}};" bindtap="start" aria-label="开始测评：{{meta.name}}">开始测�?/button>
    </view>

    <view class="brand-foot">心智探索局 · 测评 · 方法 · 训练</view>

    <view class="share-bar">
      <button class="btn ghost" bindtap="saveCard" aria-label="保存为图�?>保存为图�?/button>
      <button class="btn ghost" open-type="share" aria-label="分享给好�?>分享给好�?/button>
    </view>

    <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
  </view>
</view>
