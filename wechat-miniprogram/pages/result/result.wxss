.head {
  padding: 48rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}
.head-icon {
  font-size: 64rpx;
}
.head-name {
  font-size: 32rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.primary-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 28rpx 0 12rpx;
}
.primary-value {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
  word-break: break-all;
  text-align: center;
}
.primary-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.level-badge {
  font-size: 26rpx;
  color: #fff;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}
.head-desc {
  font-size: 25rpx;
  opacity: 0.9;
  text-align: center;
  line-height: 1.6;
  max-width: 90%;
}
.card.sec {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 20rpx;
}
.group,
.dim,
.sub {
  margin-bottom: 24rpx;
}
.group-head,
.dim-head,
.sub-head {
  display: flex;
  justify-content: space-between;
  font-size: 27rpx;
  color: #334155;
  margin-bottom: 10rpx;
}
.group-num,
.dim-pct,
.sub-num {
  color: #64748b;
}
.bar {
  height: 18rpx;
  background: #eef2f7;
  border-radius: 999rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.4s;
}
.bipolar {
  margin-bottom: 28rpx;
}
.bp-name {
  font-size: 27rpx;
  color: #334155;
  font-weight: 600;
}
.bp-bar {
  display: flex;
  height: 44rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 10rpx 0;
}
.bp-left {
  background: #cbd5e1;
  color: #1e293b;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
}
.bp-right {
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 12rpx;
  min-width: 40rpx;
}
.bp-desc {
  font-size: 23rpx;
  color: #94a3b8;
}
.dim-text {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}
.interp {
  margin-bottom: 24rpx;
}
.interp-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}
.interp-text {
  display: block;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.7;
  margin-top: 8rpx;
}
.disclaimer {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  padding: 32rpx 40rpx 0;
  line-height: 1.6;
}
.bottom-bar {
  display: flex;
  justify-content: space-between;
  padding: 32rpx 32rpx 48rpx;
}
.btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
}
.btn.ghost {
  background: #e2e8f0;
  color: #475569;
}
