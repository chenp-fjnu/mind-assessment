/* ============================================
   结果页 - 统一设计系统
   ============================================ */

.head {
  padding: 48rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--grad-hero);
  color: var(--text-inverse);
}
.head-icon {
  font-size: 64rpx;
}
.head-name {
  font-size: var(--font-size-2xl);
  opacity: 0.9;
  margin-top: 8rpx;
}
.primary-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 28rpx 0 12rpx;
}
.primary-value {
  font-size: var(--font-size-7xl);
  font-weight: var(--font-weight-extrabold);
  line-height: var(--line-height-tight);
  word-break: break-all;
  text-align: center;
}
.primary-value.mid {
  font-size: var(--font-size-5xl);
}
.primary-value.small {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
}
.primary-label {
  font-size: var(--font-size-lg);
  opacity: 0.85;
  margin-top: 8rpx;
}
.level-badge {
  font-size: var(--font-size-lg);
  color: var(--text-inverse);
  padding: 6rpx 24rpx;
  border-radius: var(--radius-full);
  margin-bottom: 12rpx;
}
.head-desc {
  font-size: var(--font-size-md);
  opacity: 0.9;
  text-align: center;
  line-height: var(--line-height-relaxed);
  max-width: 90%;
}
.test-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  margin: 20rpx 32rpx 0;
}
.test-time {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}
.test-gap {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-left: 20rpx;
}
.card.sec {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.sec-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}
.rec {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--border-light);
}
.rec:first-of-type {
  border-top: none;
  padding-top: 0;
}
.rec-icon {
  font-size: var(--font-size-4xl);
  margin-right: 18rpx;
  flex-shrink: 0;
}
.rec-body {
  flex: 1;
  overflow: hidden;
}
.rec-name {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.rec-sum {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
  line-height: var(--line-height-normal);
}
.rec-badge {
  margin-left: 12rpx;
  font-size: var(--font-size-xs);
  color: var(--text-success);
  background: var(--badge-success-bg);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}
.group,
.dim,
.sub {
  margin-bottom: 24rpx;
}
.group-head,
.dim-head,
.sub-head {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-lg);
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.group-num,
.dim-pct,
.sub-num {
  color: var(--text-tertiary);
}
.bar {
  height: 18rpx;
  background: var(--result-bar-bg);
  border-radius: var(--radius-full);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.4s;
}
.bipolar {
  margin-bottom: 28rpx;
}
.bp-name {
  font-size: var(--font-size-lg);
  color: var(--text-secondary);
  font-weight: var(--font-weight-semibold);
}
.bp-bar {
  display: flex;
  height: 44rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 10rpx 0;
}
.bp-left {
  background: var(--result-bipolar-left);
  color: var(--text-primary);
  font-size: var(--font-size-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
}
.bp-right {
  color: var(--text-inverse);
  font-size: var(--font-size-sm);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 12rpx;
  min-width: 40rpx;
}
.bp-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}
.dim-text {
  display: block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: var(--line-height-normal);
}
.interp {
  margin-bottom: 24rpx;
}
.interp-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.interp-text {
  display: block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  line-height: var(--line-height-relaxed);
  margin-top: 8rpx;
}
.disclaimer {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  text-align: center;
  padding: 32rpx 40rpx 0;
  line-height: var(--line-height-relaxed);
}
.note-box {
  margin: 20rpx 32rpx 0;
  padding: 22rpx 26rpx;
  background: var(--result-note-bg);
  border: 2rpx solid var(--result-note-border);
  border-radius: var(--radius-xl);
  font-size: var(--font-size-md);
  color: var(--result-note-text);
  line-height: var(--line-height-relaxed);
}
.brand-foot {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-sm);
  padding: 24rpx 40rpx 40rpx;
}
.trend-canvas {
  width: 100%;
  height: 240rpx;
  margin-top: 8rpx;
}
.trend-delta {
  display: block;
  text-align: center;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  margin-top: 8rpx;
}
.trend-delta.up {
  color: var(--text-success);
}
.trend-delta.down {
  color: var(--text-error);
}
.trend-delta.flat {
  color: var(--text-tertiary);
}
.trend-range {
  display: block;
  text-align: center;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.cat-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  padding: 14rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.cat-sum {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.cat-time {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}
.bottom-bar {
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx 48rpx;
}
.btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--font-size-xl);
  border-radius: var(--radius-full);
  width: 100%;
}
.btn.save {
  background: var(--color-brand-700);
  color: var(--text-inverse);
}
.btn.ghost {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  width: 46%;
}
.btn.home {
  width: 46%;
  background: var(--color-brand);
  color: var(--text-inverse);
}
.card-canvas {
  position: fixed;
  top: -9999rpx;
  left: 0;
  width: 600rpx;
  height: 800rpx;
}
.invalid {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: var(--bg-primary);
}
.invalid-icon {
  font-size: 96rpx;
}
.invalid-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-top: 24rpx;
}
.invalid-sub {
  font-size: var(--font-size-md);
  color: var(--text-muted);
  margin-top: 12rpx;
  text-align: center;
}
.invalid .btn.home {
  margin-top: 40rpx;
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--font-size-xl);
  border-radius: var(--radius-full);
}