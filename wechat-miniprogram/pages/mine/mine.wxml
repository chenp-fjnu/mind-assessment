<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page">
    <view class="mine-hero" bindtap="goProfile" role="button" aria-label="编辑个人信息">
      <view class="mine-avatar">
        <image wx:if="{{profileAvatar}}" class="mine-avatar-img" src="{{profileAvatar}}" mode="aspectFill"></image>
        <text wx:else>🧠</text>
      </view>
      <text class="mine-name">{{profileName}}</text>
    </view>

    <view class="menu">
      <view class="card menu-item" bindtap="goProfile" role="button" aria-label="个人信息">
        <view class="menu-icon">👤</view>
        <view class="menu-body">
          <text class="menu-name">个人信息</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="card menu-item" bindtap="goHistory" role="button" aria-label="我的记录">
        <view class="menu-icon">📑</view>
        <view class="menu-body">
          <text class="menu-name">我的记录</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="card menu-item" bindtap="goAbout" role="button" aria-label="关于心智探索局">
        <view class="menu-icon">ℹ️</view>
        <view class="menu-body">
          <text class="menu-name">关于心智探索局</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="card menu-section-title">
        <text>外观</text>
      </view>

      <view class="card menu-item" bindtap="setThemeAuto" catchtap="setThemeAuto" role="button" aria-label="跟随系统主题 {{themeMode==='auto'?'✓    ':''}}">
        <view class="menu-icon theme-icon">🖥️</view>
        <view class="menu-body">
          <text class="menu-name">跟随系统</text>
        </view>
        <view class="theme-check {{themeMode==='auto'?'show':''}}">✓</view>
      </view>

      <view class="card menu-item" bindtap="setThemeLight" catchtap="setThemeLight" role="button" aria-label="浅色模式 {{themeMode==='light'?'✓    ':''}}">
        <view class="menu-icon theme-icon">☀️</view>
        <view class="menu-body">
          <text class="menu-name">浅色模式</text>
        </view>
        <view class="theme-check {{themeMode==='light'?'show':''}}">✓</view>
      </view>

      <view class="card menu-item" bindtap="setThemeDark" catchtap="setThemeDark" role="button" aria-label="深色模式 {{themeMode==='dark'?'✓    ':''}}">
        <view class="menu-icon theme-icon">🌙</view>
        <view class="menu-body">
          <text class="menu-name">深色模式</text>
        </view>
        <view class="theme-check {{themeMode==='dark'?'show':''}}">✓</view>
      </view>
    </view>

    <view class="footer">结果与练习仅供自我探索，不构成专业建议；数据仅保存在本机，未启用云同步</view>
  </view>
</view>