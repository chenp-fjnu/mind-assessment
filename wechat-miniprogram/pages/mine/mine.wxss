/* ============================================
   我的页面 - 统一设计系统
   ============================================ */

.mine-hero {
  padding: 64rpx 40rpx 40rpx;
  background: var(--grad-hero);
}
.mine-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--text-inverse);
}
.mine-avatar-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: block;
}
.mine-name {
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-bold);
  margin-top: 20rpx;
}
.mine-sub {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--font-size-md);
  margin-top: 8rpx;
}

/* Dark mode mine hero */
.theme-dark .mine-avatar {
  background: rgba(255, 255, 255, 0.1);
}
.menu { margin: 24rpx 32rpx 0; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 18rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-xxl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: var(--color-brand-50);
  color: var(--color-brand);
  flex-shrink: 0;
}
.menu-body { flex: 1; margin-left: 22rpx; overflow: hidden; }
.menu-name { font-size: var(--font-size-2xl); color: var(--text-primary); font-weight: var(--font-weight-semibold); }
.menu-sub { font-size: var(--font-size-sm); color: var(--text-tertiary); margin-top: 6rpx; }

.menu-section-title {
  padding: 20rpx 28rpx 8rpx;
  margin-top: 12rpx;
  margin-bottom: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  border-radius: 0;
}
.menu-section-title text {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
  font-weight: var(--font-weight-semibold);
}

.theme-icon {
  background: var(--color-method-light) !important;
  color: var(--color-method) !important;
}
.theme-check {
  position: absolute;
  right: 50rpx;
  font-size: 24rpx;
  color: var(--color-brand);
  opacity: 0;
  transition: opacity 0.2s;
  pointer-events: none;
}
.theme-check.show {
  opacity: 1;
}

.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  padding: 36rpx 24rpx 12rpx;
}