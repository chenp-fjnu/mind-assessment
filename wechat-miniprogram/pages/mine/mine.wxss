@import "../../pages/index/index.wxss";
.mine-hero {
  padding: 64rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #1e293b, #7c3aed);
}
.mine-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.mine-name {
  display: block;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 20rpx;
}
.mine-sub {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}
.menu { margin: 24rpx 32rpx 0; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 18rpx;
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: rgba(124, 58, 237, 0.12);
  flex-shrink: 0;
}
.menu-body { flex: 1; margin-left: 22rpx; overflow: hidden; }
.menu-name { font-size: 30rpx; color: #1e293b; font-weight: 600; }
.menu-sub { font-size: 23rpx; color: #64748b; margin-top: 6rpx; }
