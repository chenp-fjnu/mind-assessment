<view class="theme-wrapper {{themeClass}}">
  <view wx:if="{{mode === 'hub'}}" class="scroll-page">
  <view class="hero">
    <text class="hero-title">互动练习</text>
    <text class="hero-sub">挑一个方法，马上开始填写练习</text>
  </view>

  <view class="group">
    <view
      class="card item"
      wx:for="{{list}}"
      wx:key="id"
      wx:for-item="m"
      bindtap="goForm"
      data-id="{{m.id}}"
      role="button"
      aria-label="{{m.name}}"
    >
      <view class="item-icon" style="background:{{m.color}};">{{m.icon}}</view>
      <view class="item-body">
        <text class="item-name">{{m.name}}</text>
        <text class="item-desc">{{m.summary}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer">练习仅保存在本机，仅你可见</view>
</view>

<view wx:elif="{{mode === 'form' && method}}" class="scroll-page">
  <view class="head" style="background:{{method.color}};">
    <text class="head-icon">{{method.icon}}</text>
    <text class="head-name">{{method.name}}</text>
    <text class="head-cat">{{method.category}}</text>
    <text class="head-sum">{{method.summary}}</text>
  </view>

  <view class="card sec">
    <text class="sec-title">互动练习</text>
    <view class="field" wx:for="{{formFields}}" wx:key="key" wx:for-item="f" wx:for-index="idx">
      <text class="field-label">{{f.label}}</text>
      <textarea
        wx:if="{{f.type === 'textarea'}}"
        class="field-input"
        placeholder="{{f.placeholder}}"
        placeholder-class="ph"
        value="{{f.value}}"
        bindinput="onInput"
        data-key="{{f.key}}"
        data-idx="{{idx}}"
        auto-height
        maxlength="-1"
      />
      <view wx:elif="{{f.type === 'scale'}}" class="scale-row">
        <slider
          class="scale"
          min="{{f.min}}"
          max="{{f.max}}"
          value="{{f.value}}"
          bindchange="onScale"
          data-key="{{f.key}}"
          data-idx="{{idx}}"
          activeColor="{{method.color}}"
          block-size="20"
          show-value
        />
      </view>
    </view>
    <button class="btn save" style="background:{{method.color}};" bindtap="savePractice" aria-label="保存这次练习">保存这次练习</button>
    <text class="save-tip">练习仅保存在本机，仅你可见</text>
  </view>

  <view class="card sec" wx:if="{{practices.length}}">
    <text class="sec-title">我的练习记录（{{practices.length}}）</text>
    <canvas type="2d" id="practiceTrendCanvas" class="trend-canvas" wx:if="{{practiceTrend && practiceTrend.values && practiceTrend.values.length >= 2}}"></canvas>
    <view class="trend-summary" wx:if="{{practiceTrend && practiceTrend.values && practiceTrend.values.length >= 2}}">
      <text>{{practiceTrend.fieldLabel}}：首次 {{practiceTrend.first}} → 最近 {{practiceTrend.last}}</text>
      <text class="trend-delta {{practiceTrend.delta>0?'up':(practiceTrend.delta<0?'down':'flat')}}">{{practiceTrend.direction}} {{practiceTrend.delta}}</text>
    </view>
    <view class="practice" wx:for="{{practices}}" wx:key="time" wx:for-item="p">
      <text class="practice-time">{{p.timeText}}</text>
      <view class="practice-body" wx:for="{{p.fields}}" wx:key="key" wx:for-item="pf">
        <text class="practice-label">{{pf.label}}</text>
        <text class="practice-value">{{pf.value}}</text>
      </view>
    </view>
  </view>

  <view class="footer">方法用于自我探索与练习，不能替代专业帮助</view>
</view>

<view wx:else class="invalid">
    <text class="invalid-icon">🧩</text>
    <text class="invalid-title">未找到该方法</text>
    <button class="btn home" bindtap="goBack" aria-label="返回方法详情">返回</button>
  </view>
</view>
