/* ============================================
   方法详情页 - 统一设计系统
   ============================================ */

.head {
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  background: var(--grad-method-page);
  color: var(--text-inverse);
}
.head-icon {
  font-size: 72rpx;
}
.head-name {
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-5xl);
  font-weight: var(--font-weight-extrabold);
  margin-top: 16rpx;
}
.head-cat {
  display: inline-block;
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 4rpx 18rpx;
  font-size: var(--font-size-sm);
  color: var(--text-inverse);
  background: rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-full);
}
.head-sum {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--font-size-lg);
  margin-top: 18rpx;
  line-height: var(--line-height-normal);
}
.head-practice {
  align-self: flex-end;
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-inverse);
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-full);
}
.head-practice:active {
  background: rgba(255, 255, 255, 0.3);
}
.sec {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.sec-title {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: 18rpx;
}
.acro {
  display: flex;
  flex-direction: column;
}
.acro-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-light);
}
.acro-item:last-child {
  border-bottom: none;
}
.acro-letter {
  min-width: 64rpx;
  height: 64rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  text-align: center;
}
.acro-body {
  flex: 1;
  overflow: hidden;
}
.acro-en {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}
.acro-zh {
  display: block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 4rpx;
  line-height: var(--line-height-normal);
}
.field {
  margin-bottom: 24rpx;
}
.field-label {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.field-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  font-size: var(--font-size-lg);
  line-height: var(--line-height-normal);
  color: var(--input-text);
  background: var(--input-bg);
  border: 2rpx solid var(--input-border);
  border-radius: var(--radius-xl);
}
.field-input:focus {
  border-color: var(--input-border-focus);
  outline: none;
}
.ph {
  color: var(--input-placeholder);
}
.scale-row {
  padding: 6rpx 8rpx 0;
}
.btn.save {
  margin-top: 8rpx;
  height: 84rpx;
  font-size: var(--font-size-xl);
  border-radius: var(--radius-full);
}
.btn.practice {
  margin-top: 20rpx;
  height: 84rpx;
  font-size: var(--font-size-xl);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  background: var(--color-method);
}
.save-tip {
  display: block;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 14rpx;
}
.content-block {
  margin-bottom: 22rpx;
}
.content-title {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.content-text {
  display: block;
  font-size: var(--font-size-lg);
  color: var(--text-tertiary);
  line-height: var(--line-height-relaxed);
}
.practice {
  padding: 20rpx 0;
  border-top: 2rpx solid var(--border-light);
}
.practice:first-of-type {
  border-top: none;
}
.practice-time {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}
.practice-body {
  margin-bottom: 10rpx;
}
.practice-label {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
  margin-right: 12rpx;
}
.practice-value {
  font-size: var(--font-size-lg);
  color: var(--text-tertiary);
}
.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-md);
  padding: 36rpx 40rpx 40rpx;
}
.invalid {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
}
.invalid-icon {
  font-size: 80rpx;
  opacity: 0.5;
}
.invalid-title {
  margin-top: 20rpx;
  font-size: var(--font-size-2xl);
  color: var(--text-secondary);
}
.btn.home {
  margin-top: 36rpx;
  width: 240rpx;
  height: 80rpx;
  background: var(--color-brand);
  color: var(--text-inverse);
  font-size: var(--font-size-lg);
  border-radius: var(--radius-full);
}
.share-bar {
  display: flex;
  gap: 20rpx;
  margin: 8rpx 32rpx 0;
}
.btn.ghost {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--btn-ghost-bg);
  color: var(--color-brand);
  border: 2rpx solid var(--color-brand);
  font-size: var(--font-size-lg);
  border-radius: var(--radius-xl);
}
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 300px;
  height: 380px;
}

/* 步骤列表 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.step-item {
  display: flex;
  align-items: flex-start;
}
.step-no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  text-align: center;
  line-height: 40rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-extrabold);
  color: var(--text-inverse);
  background: var(--color-method);
  border-radius: 50%;
}
.step-sep {
  flex: none;
  margin-right: 12rpx;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-extrabold);
  color: var(--color-method);
}
.step-text {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  line-height: var(--line-height-relaxed);
}
.example {
  padding: 20rpx 24rpx;
  background: var(--color-method-light);
  border-left: 6rpx solid var(--color-method);
  border-radius: var(--radius-lg);
}
.example-text {
  font-size: var(--font-size-md);
  color: var(--color-method-dark);
  line-height: var(--line-height-relaxed);
}
.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.tip-dot {
  flex: none;
  margin-right: 12rpx;
  font-size: var(--font-size-xl);
  color: var(--color-method);
  line-height: 1.4;
}
.tip-text {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  line-height: var(--line-height-relaxed);
}

/* 练习趋势（首次 → 最近） */
.trend-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.trend-text {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  line-height: 1.5;
}
.trend-delta {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--font-size-lg);
  font-weight: 600;
}
.trend-delta.up { color: var(--color-success); }
.trend-delta.down { color: var(--color-error); }
.trend-delta.flat { color: var(--text-tertiary); }