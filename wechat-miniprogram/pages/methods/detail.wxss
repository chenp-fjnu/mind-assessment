.head {
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
}
.head-icon {
  font-size: 72rpx;
}
.head-name {
  display: block;
  color: #fff;
  font-size: 46rpx;
  font-weight: 800;
  margin-top: 16rpx;
}
.head-cat {
  display: inline-block;
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}
.head-sum {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  margin-top: 18rpx;
  line-height: 1.6;
}
.sec {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
}
.sec-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 18rpx;
}
.field {
  margin-bottom: 24rpx;
}
.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 10rpx;
}
.field-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #1e293b;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
}
.ph {
  color: #94a3b8;
}
.scale-row {
  padding: 6rpx 8rpx 0;
}
.btn.save {
  margin-top: 8rpx;
  height: 84rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
}
.save-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 14rpx;
}
.content-block {
  margin-bottom: 22rpx;
}
.content-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}
.content-text {
  display: block;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.7;
}
.practice {
  padding: 20rpx 0;
  border-top: 2rpx solid #f1f5f9;
}
.practice:first-of-type {
  border-top: none;
}
.practice-time {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}
.practice-body {
  margin-bottom: 10rpx;
}
.practice-label {
  font-size: 25rpx;
  font-weight: 600;
  color: #334155;
  margin-right: 12rpx;
}
.practice-value {
  font-size: 25rpx;
  color: #475569;
}
.footer {
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
  padding: 36rpx 40rpx 40rpx;
}
.invalid {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
}
.invalid-icon {
  font-size: 80rpx;
  opacity: 0.5;
}
.invalid-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #475569;
}
.btn.home {
  margin-top: 36rpx;
  width: 240rpx;
  height: 80rpx;
  background: #7c3aed;
  color: #fff;
  font-size: 28rpx;
}

@media (prefers-color-scheme: dark) {
  .sec-title {
    color: var(--text);
  }
  .field-label {
    color: var(--text2);
  }
  .field-input {
    color: var(--text);
    background: #0f172a;
    border-color: var(--border);
  }
  .ph {
    color: var(--muted);
  }
  .content-title {
    color: var(--text2);
  }
  .content-text {
    color: var(--sub);
  }
  .practice {
    border-top-color: var(--border);
  }
  .practice-time {
    color: var(--muted);
  }
  .practice-label {
    color: var(--text2);
  }
  .practice-value {
    color: var(--sub);
  }
  .footer {
    color: var(--muted);
  }
  .invalid-title {
    color: var(--text2);
  }
}
