<view class="scroll-page">
  <view class="hero">
    <text class="hero-title">方法库</text>
    <text class="hero-sub">把心理学方法，变成每天可用的练习</text>
    <text class="hero-tag">{{count}} 个方法 · {{interactiveCount}} 个可互动练习</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索方法名称 / 关键字"
      placeholder-class="search-ph"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" role="button" aria-label="清除搜索">✕</text>
  </view>

  <scroll-view class="type-bar" scroll-x="true">
    <view class="type-chip {{activeCategory === '' ? 'on' : ''}}" bindtap="onCategory" data-category="">全部</view>
    <view
      class="type-chip {{activeCategory === item.category ? 'on' : ''}}"
      wx:for="{{categories}}"
      wx:key="category"
      wx:for-item="item"
      bindtap="onCategory"
      data-category="{{item.category}}"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{!groups.length}}" class="empty-search">
    <text class="empty-search-icon">🔎</text>
    <text class="empty-search-text">没有找到匹配的方法</text>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="category" wx:for-item="g">
    <view class="group-title">{{g.category}}</view>
    <view
      class="card item"
      wx:for="{{g.list}}"
      wx:key="id"
      wx:for-item="m"
      bindtap="goDetail"
      data-id="{{m.id}}"
      role="button"
      aria-label="{{m.name}}，{{m.summary}}"
    >
      <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
      <view class="item-body">
        <view class="item-head">
          <text class="item-name">{{m.name}}</text>
          <text wx:if="{{m.interactive}}" class="badge-practice">可练习</text>
        </view>
        <text class="item-desc">{{m.summary}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer">方法用于自我探索与练习，不能替代专业帮助</view>
</view>
