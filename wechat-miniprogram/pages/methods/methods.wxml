<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page">
    <view class="hero">
      <text class="hero-title">方法库</text>
      <text class="hero-sub">把实用方法，变成每天可用的练习</text>
      <view class="hero-meta">
        <text class="pill"><text class="num">{{count}}</text> 个方法</text>
        <text class="pill"><text class="num">{{categoryCount}}</text> 个分类</text>
        <text class="pill link" bindtap="goRecords" role="button" aria-label="我的方法练习记录">我的记录 {{methodRecordCount}} ›</text>
      </view>
    </view>

    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索方法名称 / 关键字"
        placeholder-class="search-ph"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" role="button" aria-label="清除搜索">✕</text>
    </view>

    <scroll-view class="type-bar" scroll-x="true">
      <view class="type-chip {{activeCategory === '' ? 'on' : ''}}" bindtap="onCategory" data-category="" aria-label="全部分类">全部</view>
      <view
        class="type-chip {{activeCategory === item.category ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="category"
        wx:for-item="item"
        bindtap="onCategory"
        data-category="{{item.category}}"
        aria-label="{{item.label}}"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{!showAll && !keyword && !activeCategory}}" class="recommendations">
      <view class="group" wx:if="{{newcomerMethods.length}}">
        <view class="group-title">新人首选</view>
        <view class="card item" wx:for="{{newcomerMethods}}" wx:key="id" wx:for-item="m" bindtap="goDetail" data-id="{{m.id}}" role="button" aria-label="{{m.name}}，{{m.summary}}">
          <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
          <view class="item-body">
            <view class="item-head"><text class="item-name">{{m.name}}</text></view>
            <text class="item-desc">{{m.summary}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="group" wx:if="{{recommendedMethods.length}}">
        <view class="group-title">为你推荐</view>
        <view class="card item" wx:for="{{recommendedMethods}}" wx:key="id" wx:for-item="m" bindtap="goDetail" data-id="{{m.id}}" role="button" aria-label="{{m.name}}，{{m.summary}}">
          <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
          <view class="item-body">
            <view class="item-head"><text class="item-name">{{m.name}}</text></view>
            <text class="item-desc">{{m.summary}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <button class="browse-all" bindtap="showAllMethods" aria-label="查看全部 {{count}} 个方法">查看全部 {{count}} 个方法</button>
    </view>

    <view wx:if="{{(keyword || activeCategory) && !groups.length}}" class="empty-search">
      <text class="empty-search-icon">🔎</text>
      <text class="empty-search-text">没有找到匹配的方法</text>
      <button class="empty-action" bindtap="goCourses" aria-label="看看课程路线">看看课程路线</button>
    </view>

    <view wx:if="{{showAll && !keyword && !activeCategory}}" class="collapse-all" bindtap="showRecommendations" role="button" aria-label="收起完整方法列表">收起全部</view>
    <view wx:if="{{showAll || keyword || activeCategory}}" class="group" wx:for="{{groups}}" wx:key="category" wx:for-item="g">
      <view class="group-title">{{g.category}}</view>
      <view
        class="card item"
        wx:for="{{g.list}}"
        wx:key="id"
        wx:for-item="m"
        bindtap="goDetail"
        data-id="{{m.id}}"
        role="button"
        aria-label="{{m.name}}，{{m.summary}}"
      >
        <view class="item-icon" style="background:{{m.tint}};">{{m.icon}}</view>
        <view class="item-body">
          <view class="item-head">
            <text class="item-name">{{m.name}}</text>
            <text wx:if="{{m.interactive}}" class="badge-practice">可练习</text>
          </view>
          <text class="item-desc">{{m.summary}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="footer">方法用于自我探索与练习，不能替代专业帮助</view>
  </view>
</view>