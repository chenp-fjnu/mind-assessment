@import "../../pages/index/index.wxss";

.badge-practice {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #0d9488;
  background: #ccfbf1;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

@media (prefers-color-scheme: dark) {
  .badge-practice {
    color: #5eead4;
    background: #0f3b34;
  }
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.topbar-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}
.topbar-action {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
