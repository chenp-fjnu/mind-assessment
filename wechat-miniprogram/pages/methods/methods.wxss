/* ============================================
   方法页样式 - 统一设计系统
   ============================================ */

.scroll-page {
  background: var(--bg-primary);
  min-height: 100vh;
}

/* Hero */
.hero {
  padding: 48rpx 24rpx 40rpx;
  background: var(--grad-method-page);
}
.hero-title {
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-5xl);
  font-weight: var(--font-weight-extrabold);
  letter-spacing: 2rpx;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: var(--font-size-md);
  margin-top: 10rpx;
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-inverse);
}
.pill .num {
  font-weight: var(--font-weight-bold);
  margin-right: 4rpx;
}
.pill.link {
  background: rgba(255, 255, 255, 0.28);
  color: var(--text-inverse);
  font-weight: var(--font-weight-semibold);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 20rpx 0;
  padding: 0 20rpx;
  height: 68rpx;
  background: var(--search-bg);
  border-radius: var(--radius-full);
  box-shadow: var(--search-shadow);
}
.search-icon {
  font-size: var(--font-size-2xl);
  margin-right: 10rpx;
  opacity: 0.6;
}
.search-input {
  flex: 1;
  font-size: var(--font-size-2xl);
  color: var(--text-primary);
  height: 68rpx;
}
.search-ph {
  color: var(--text-muted);
}
.search-clear {
  font-size: var(--font-size-2xl);
  color: var(--text-muted);
  padding: 0 6rpx;
}

/* 分类筛选 */
.type-bar {
  white-space: nowrap;
  margin: 16rpx 20rpx 0;
  padding-bottom: 4rpx;
}
.type-chip {
  display: inline-block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  background: var(--chip-bg);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  margin-right: 12rpx;
}
.type-chip.on {
  color: var(--text-inverse);
  background: var(--color-method);
}

/* 空状态 */
.empty-search {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx;
}
.empty-search-icon {
  font-size: 64rpx;
  opacity: 0.5;
}
.empty-search-text {
  margin-top: 16rpx;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
}

/* 分组列表 */
.group {
  margin: 24rpx 20rpx 0;
}
.group-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin: 12rpx 4rpx 16rpx;
}
.card {
  background: var(--card-bg);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--card-border);
}
.item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.item-body {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.item-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.item-name {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  max-width: 60%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.badge-practice {
  margin-left: 12rpx;
  font-size: var(--font-size-xs);
  color: var(--color-method-dark);
  background: var(--color-method-light);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
}
.item-desc {
  display: block;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: var(--line-height-normal);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.arrow {
  color: var(--border-medium);
  font-size: 40rpx;
  margin-left: 8rpx;
}

.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  padding: 36rpx 20rpx 20rpx;
}