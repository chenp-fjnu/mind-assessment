.topbar {
  padding: 24rpx 32rpx;
  background: #1e293b;
}
.progress-wrap {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
  transition: width 0.25s;
}
.progress-text {
  display: block;
  text-align: center;
  color: #fff;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.group-label {
  display: block;
  text-align: center;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  margin-top: 6rpx;
}
.q-card {
  margin: 24rpx 32rpx;
  padding: 36rpx 32rpx;
}
.q-index {
  font-size: 24rpx;
  color: #94a3b8;
}
.q-text {
  display: block;
  font-size: 33rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.6;
  margin-top: 12rpx;
  margin-bottom: 28rpx;
}
.scale-list {
  display: flex;
  flex-direction: column;
}
.scale-opt {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  color: #334155;
}
.scale-opt.sel {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 600;
}
.radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid #cbd5e1;
  margin-right: 20rpx;
}
.radio-sel {
  border-color: #2563eb;
  background: #2563eb;
}
.choice-list {
  display: flex;
  flex-direction: column;
}
.choice-opt {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  color: #334155;
}
.choice-opt.sel {
  border-color: #2563eb;
  background: #eff6ff;
}
.opt-key {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #475569;
  text-align: center;
  line-height: 48rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.choice-opt.sel .opt-key {
  background: #2563eb;
  color: #fff;
}
.opt-text {
  flex: 1;
}
.matrix-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.matrix-box {
  width: 100%;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 12rpx;
}
.matrix-canvas {
  width: 100%;
  height: 360rpx;
}
.matrix-tip {
  font-size: 24rpx;
  color: #94a3b8;
  margin: 16rpx 0;
}
.opt-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}
.opt-cell {
  width: 23%;
  margin-bottom: 16rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #fff;
  padding: 6rpx;
}
.opt-cell.sel {
  border-color: #2563eb;
}
.opt-canvas {
  width: 100%;
  height: 120rpx;
}
.nav-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}
.nav-btn {
  width: 48%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
  color: #fff;
}
.nav-btn.ghost {
  background: #e2e8f0;
  color: #475569;
}
.nav-btn[disabled] {
  opacity: 0.5;
}
.target-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.target-canvas {
  width: 220rpx;
  height: 220rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 10rpx;
}
.figopt-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.figopt-cell {
  margin-bottom: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.figopt-cell.sel {
  border-color: #2563eb;
}
.figopt-canvas {
  width: 160rpx;
  height: 160rpx;
  background: #f8fafc;
  border-radius: 10rpx;
}
.figopt-key {
  font-size: 24rpx;
  color: #475569;
  margin-top: 8rpx;
  font-weight: 600;
}
.answered-tip {
  text-align: center;
  color: #94a3b8;
  font-size: 23rpx;
  padding-bottom: 40rpx;
}

@media (prefers-color-scheme: dark) {
  .q-index {
    color: var(--muted);
  }
  .q-text {
    color: var(--text);
  }
  .scale-opt {
    border-color: var(--border);
    color: var(--text2);
  }
  .scale-opt.sel {
    border-color: #3b82f6;
    background: var(--sel-bg);
    color: var(--sel-text);
  }
  .radio {
    border-color: #475569;
  }
  .choice-opt {
    border-color: var(--border);
    color: var(--text2);
  }
  .choice-opt.sel {
    border-color: #3b82f6;
    background: var(--sel-bg);
  }
  .opt-key {
    background: var(--chip);
    color: var(--text2);
  }
  .choice-opt.sel .opt-key {
    background: #3b82f6;
    color: #fff;
  }
  .matrix-box {
    background: var(--card);
    border-color: var(--border);
  }
  .matrix-tip {
    color: var(--muted);
  }
  .opt-cell {
    border-color: var(--border);
    background: var(--card);
  }
  .opt-cell.sel {
    border-color: #3b82f6;
  }
  .nav-btn.ghost {
    background: var(--border);
    color: var(--text2);
  }
  .target-canvas {
    background: #1e293b;
    border-color: var(--border);
  }
  .figopt-cell {
    border-color: var(--border);
    background: var(--card);
  }
  .figopt-cell.sel {
    border-color: #3b82f6;
  }
  .figopt-canvas {
    background: #1e293b;
  }
  .figopt-key {
    color: var(--text2);
  }
  .answered-tip {
    color: var(--muted);
  }
}
