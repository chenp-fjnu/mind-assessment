/* ============================================
   测评题目页 - 统一设计系统
   ============================================ */

.topbar {
  padding: 24rpx 32rpx;
  background: var(--color-brand-700);
}
.progress-wrap {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-full);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: var(--text-inverse);
  border-radius: var(--radius-full);
  transition: width 0.25s;
}
.progress-text {
  display: block;
  text-align: center;
  color: var(--text-inverse);
  font-size: var(--font-size-lg);
  margin-top: 12rpx;
}
.group-label {
  display: block;
  text-align: center;
  color: rgba(255, 255, 255, 0.75);
  font-size: var(--font-size-md);
  margin-top: 6rpx;
}
.group-label.time-left {
  color: var(--color-train-100);
}
.q-card {
  margin: 24rpx 32rpx;
  padding: 36rpx 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.q-index {
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
}
.q-text {
  display: block;
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  line-height: var(--line-height-relaxed);
  margin-top: 12rpx;
  margin-bottom: 28rpx;
}
.scale-list {
  display: flex;
  flex-direction: column;
}
.scale-opt {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  margin-bottom: 18rpx;
  font-size: var(--font-size-2xl);
  color: var(--text-secondary);
}
.scale-opt.sel {
  border-color: var(--color-brand);
  background: var(--color-brand-50);
  color: var(--color-brand-700);
  font-weight: var(--font-weight-semibold);
}
.radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-medium);
  margin-right: 20rpx;
}
.radio-sel {
  border-color: var(--color-brand);
  background: var(--color-brand);
}
.choice-list {
  display: flex;
  flex-direction: column;
}
.choice-opt {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  margin-bottom: 18rpx;
  font-size: var(--font-size-2xl);
  color: var(--text-secondary);
}
.choice-opt.sel {
  border-color: var(--color-brand);
  background: var(--color-brand-50);
}
.opt-key {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-tertiary);
  color: var(--text-tertiary);
  text-align: center;
  line-height: 48rpx;
  font-size: var(--font-size-lg);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.choice-opt.sel .opt-key {
  background: var(--color-brand);
  color: var(--text-inverse);
}
.opt-text {
  flex: 1;
}
.matrix-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.matrix-box {
  width: 100%;
  background: var(--card-bg);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  padding: 12rpx;
}
.matrix-canvas {
  width: 100%;
  height: 360rpx;
}
.matrix-tip {
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin: 16rpx 0;
}
.opt-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}
.opt-cell {
  width: 23%;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-lg);
  background: var(--card-bg);
  padding: 6rpx;
}
.opt-cell.sel {
  border-color: var(--color-brand);
}
.opt-canvas {
  width: 100%;
  height: 120rpx;
}
.nav-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}
.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  width: 48%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--font-size-xl);
  border-radius: var(--radius-full);
  color: var(--text-inverse);
}
.nav-btn.ghost {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}
.nav-btn[disabled] {
  opacity: 0.5;
}
.target-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.target-canvas {
  width: 220rpx;
  height: 220rpx;
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  padding: 10rpx;
}
.figopt-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.figopt-cell {
  margin-bottom: 20rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  background: var(--card-bg);
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.figopt-cell.sel {
  border-color: var(--color-brand);
}
.figopt-canvas {
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-lg);
}
.figopt-key {
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  font-weight: var(--font-weight-bold);
}
/* 矩阵选项字母：画布下方可见，不在画布内遮挡图案 */
.opt-key-label {
  display: block;
  text-align: center;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 6rpx;
  font-weight: var(--font-weight-bold);
}
.answered-tip {
  text-align: center;
  color: var(--text-tertiary);
  font-size: var(--font-size-md);
  padding-bottom: 40rpx;
}

/* ========== multi 多选题（找相同 / 类比 / 找不同） ========== */
.group-label.total-left {
  color: #fde68a;
}
.target-canvas.wide {
  width: 100%;
  height: 340rpx;
}
.multi-wrap {
  display: flex;
  flex-direction: column;
}
.multi-fig-wrap {
  position: relative;
  width: 100%;
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  overflow: hidden;
}
.multi-canvas {
  display: block;
  width: 100%;
  height: 100%;
}
.multi-hit-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-auto-rows: 1fr;
}
.multi-hit {
  border: 4rpx solid transparent;
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}
.multi-hit.sel {
  border-color: var(--color-brand);
  background: rgba(37, 99, 235, 0.08);
}
.multi-check {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid var(--border-medium);
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.multi-check.on {
  background: var(--color-brand);
  border-color: var(--color-brand);
}
.choice-opt .multi-check.on::after {
  content: '';
  display: block;
  width: 12rpx;
  height: 20rpx;
  border: solid #ffffff;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
  margin: 2rpx 0 0 8rpx;
}
.multi-hint {
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  margin-top: 20rpx;
  text-align: center;
}