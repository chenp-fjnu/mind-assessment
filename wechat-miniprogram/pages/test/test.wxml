<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page">
    <view class="topbar" style="background:{{meta.color}};color:{{meta.colorText}};">
      <view class="progress-wrap">
        <view class="progress-bar" style="width:{{progress}}%;"></view>
      </view>
      <text class="progress-text">{{current+1}} / {{total}}</text>
      <text wx:if="{{groupLabel}}" class="group-label">{{groupLabel}}</text>
      <text wx:if="{{hasTimeLimit}}" class="group-label time-left">⏱ {{timeLeft}}s</text>
      <text wx:if="{{hasTotalTime}}" class="group-label total-left">整卷剩余 ⏱ {{totalTimeText}}</text>
    </view>

    <view class="q-card card">
      <text class="q-index">第 {{current+1}} 题</text>
      <text class="q-text">{{q.prompt || '请观察下方图形，选择正确的一项'}}</text>

      <!-- 测评表题 -->
      <view wx:if="{{qType==='scale'}}" class="scale-list">
        <view
          class="scale-opt {{answers[current]===idx?'sel':''}}"
          wx:for="{{q.scale.labels}}"
          wx:key="idx"
          wx:for-index="idx"
          wx:for-item="label"
          bindtap="selectAnswer"
          data-index="{{idx}}"
          role="button"
          aria-label="选项 {{label}}{{answers[current]===idx?'，已选':''}}"
        >
          <view class="radio {{answers[current]===idx?'radio-sel':''}}"></view>
          <text>{{label}}</text>
        </view>
      </view>

      <!-- 选择题 -->
      <view wx:elif="{{qType==='choice'}}" class="choice-list">
        <block wx:if="{{q.matrix}}">
          <view class="target-box">
            <text class="matrix-tip">目标图案（选出与之相同的选项）</text>
            <canvas type="2d" id="targetCanvas" class="target-canvas"></canvas>
          </view>
          <view wx:if="{{showFigureOptions}}" class="figopt-grid">
            <view
              class="figopt-cell {{answers[current]===idx?'sel':''}}"
              style="{{optStyle}}"
              wx:for="{{figureOptions}}"
              wx:key="idx"
              wx:for-index="idx"
              bindtap="selectAnswer"
              data-index="{{idx}}"
              role="button"
              aria-label="图形选项 {{['A','B','C','D','E','F'][idx]}}{{answers[current]===idx?'，已选':''}}"
            >
              <canvas type="2d" id="figopt{{idx}}" class="figopt-canvas" role="img" aria-label="图形选项 {{['A','B','C','D','E','F'][idx]}} 图案"></canvas>
              <text class="figopt-key">{{['A','B','C','D','E','F'][idx]}}</text>
            </view>
          </view>
          <view wx:else class="choice-list">
            <view
              class="choice-opt {{answers[current]===idx?'sel':''}}"
              wx:for="{{q.options}}"
              wx:key="idx"
              wx:for-index="idx"
              wx:for-item="opt"
              bindtap="selectAnswer"
              data-index="{{idx}}"
              role="button"
              aria-label="选项 {{['A','B','C','D','E','F'][idx]}}：{{opt}}{{answers[current]===idx?'，已选':''}}"
            >
              <text class="opt-key">{{['A','B','C','D','E','F'][idx]}}</text>
              <text class="opt-text">{{opt}}</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <view
            class="choice-opt {{answers[current]===idx?'sel':''}}"
            wx:for="{{q.options}}"
            wx:key="idx"
            wx:for-index="idx"
            wx:for-item="opt"
            bindtap="selectAnswer"
            data-index="{{idx}}"
            role="button"
            aria-label="选项 {{['A','B','C','D','E','F'][idx]}}：{{opt}}{{answers[current]===idx?'，已选':''}}"
          >
            <text class="opt-key">{{['A','B','C','D','E','F'][idx]}}</text>
            <text class="opt-text">{{opt}}</text>
          </view>
        </block>
      </view>

      <!-- 多选题（找相同 / 类比 / 找不同）：点按切换选中，不自动跳题 -->
      <view wx:elif="{{qType==='multi'}}" class="multi-wrap">
        <view wx:if="{{q.matrix || q.analogy}}" class="target-box">
          <text class="matrix-tip">{{q.analogy ? '上图：第一个图形经某种变化成为第二个；下图：第三个图形经同样变化应为？' : '目标图案（选出与之完全相同的图形，可多选）'}}</text>
          <canvas type="2d" id="targetCanvas" class="target-canvas {{q.analogy ? 'wide' : ''}}" role="img" aria-label="题目目标图案"></canvas>
        </view>

        <!-- 图形多选：整块网格画在单个 canvas，透明覆盖层承接点击与选中框 -->
        <view wx:if="{{multiFigures}}" class="multi-fig-wrap" style="height:{{multiFigHeight}}rpx;">
          <canvas type="2d" id="multiCanvas" class="multi-canvas" role="img" aria-label="可多选的图形选项网格"></canvas>
          <view class="multi-hit-grid" style="grid-template-columns:repeat({{multiCols}},1fr);">
            <view
              wx:for="{{multiSel}}"
              wx:key="idx"
              wx:for-index="idx"
              class="multi-hit {{item ? 'sel' : ''}}"
              data-idx="{{idx}}"
              bindtap="toggleMulti"
              role="checkbox"
              aria-checked="{{item}}"
              aria-label="图形选项 {{['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O','P','Q','R'][idx]}}{{item ? '，已选中' : ''}}"
            ></view>
          </view>
        </view>

        <!-- 文本多选 -->
        <view wx:else class="choice-list">
          <view
            class="choice-opt {{multiSel[idx] ? 'sel' : ''}}"
            wx:for="{{q.options}}"
            wx:key="idx"
            wx:for-index="idx"
            bindtap="toggleMulti"
            data-idx="{{idx}}"
            role="checkbox"
            aria-checked="{{multiSel[idx]}}"
            aria-label="选项 {{['A','B','C','D','E','F'][idx]}}：{{item}}{{multiSel[idx] ? '，已选中' : ''}}"
          >
            <text class="opt-key">{{['A','B','C','D','E','F'][idx]}}</text>
            <text class="opt-text">{{item}}</text>
            <view class="multi-check {{multiSel[idx] ? 'on' : ''}}"></view>
          </view>
        </view>

        <view class="multi-hint">本题可多选：点按切换选中，选好后点「{{current === total - 1 ? '提交' : '下一题'}}」</view>
      </view>

      <!-- 矩阵题（SPM） -->
      <view wx:elif="{{qType==='matrix'}}" class="matrix-wrap">
        <view class="matrix-box">
          <canvas type="2d" id="matrixCanvas" class="matrix-canvas" role="img" aria-label="图形规律题目"></canvas>
        </view>
        <text class="matrix-tip">请选择能补全规律的选项</text>
        <view class="opt-grid">
          <view
            class="opt-cell {{answers[current]===idx?'sel':''}}"
            style="{{optStyle}}"
            wx:for="{{q.options}}"
            wx:key="idx"
            wx:for-index="idx"
            wx:for-item="o"
            bindtap="selectAnswer"
            data-index="{{idx}}"
            role="button"
            aria-label="选项 {{['A','B','C','D','E','F'][idx]}}{{answers[current]===idx?'，已选':''}}"
          >
            <canvas type="2d" id="opt{{idx}}" class="opt-canvas" role="img" aria-label="选项 {{['A','B','C','D','E','F'][idx]}} 图案"></canvas>
            <text class="opt-key-label">{{['A','B','C','D','E','F'][idx]}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="nav-bar">
      <button class="nav-btn ghost" bindtap="prev" disabled="{{current===0}}" aria-label="上一题">上一题</button>
      <button class="nav-btn primary" style="background:{{meta.color}};color:{{meta.colorText}};" bindtap="next" aria-label="{{current===total-1 ? '提交测评' : '下一题'}}">
        {{current===total-1 ? '提交' : '下一题'}}
      </button>
    </view>

    <view class="answered-tip">已作答 {{answeredCount}} / {{total}}{{qType === 'multi' ? '（多选题，选好后点「下一题」）' : '（选完后自动跳下一题）'}}</view>
  </view>
</view>