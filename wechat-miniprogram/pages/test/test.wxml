<view class="scroll-page">
  <view class="topbar" style="background:{{meta.color}};color:{{meta.colorText}};">
    <view class="progress-wrap">
      <view class="progress-bar" style="width:{{progress}}%;"></view>
    </view>
    <text class="progress-text">{{current+1}} / {{total}}</text>
    <text wx:if="{{groupLabel}}" class="group-label">{{groupLabel}}</text>
    <text wx:if="{{hasTimeLimit}}" class="group-label time-left">⏱ {{timeLeft}}s</text>
  </view>

  <view class="q-card card">
    <text class="q-index">第 {{current+1}} 题</text>
    <text class="q-text">{{q.prompt || '请观察下方图形，选择正确的一项'}}</text>

    <!-- 量表题 -->
    <view wx:if="{{qType==='scale'}}" class="scale-list">
      <view
        class="scale-opt {{answers[current]===idx?'sel':''}}"
        wx:for="{{q.scale.labels}}"
        wx:key="idx"
        wx:for-index="idx"
        wx:for-item="label"
        bindtap="selectAnswer"
        data-index="{{idx}}"
        role="button"
        aria-label="选项 {{label}}{{answers[current]===idx?'，已选':''}}"
      >
        <view class="radio {{answers[current]===idx?'radio-sel':''}}"></view>
        <text>{{label}}</text>
      </view>
    </view>

    <!-- 选择题 -->
    <view wx:elif="{{qType==='choice'}}" class="choice-list">
      <block wx:if="{{q.matrix}}">
        <view class="target-box">
          <text class="matrix-tip">目标图案（选出与之相同的选项）</text>
          <canvas type="2d" id="targetCanvas" class="target-canvas"></canvas>
        </view>
        <view wx:if="{{showFigureOptions}}" class="figopt-grid">
          <view
            class="figopt-cell {{answers[current]===idx?'sel':''}}"
            style="{{optStyle}}"
            wx:for="{{figureOptions}}"
            wx:key="idx"
            wx:for-index="idx"
            bindtap="selectAnswer"
            data-index="{{idx}}"
            role="button"
            aria-label="图形选项 {{['A','B','C','D','E','F'][idx]}}{{answers[current]===idx?'，已选':''}}"
          >
            <canvas type="2d" id="figopt{{idx}}" class="figopt-canvas" role="img" aria-label="图形选项 {{['A','B','C','D','E','F'][idx]}} 图案"></canvas>
            <text class="figopt-key">{{['A','B','C','D','E','F'][idx]}}</text>
          </view>
        </view>
        <view wx:else class="choice-list">
          <view
            class="choice-opt {{answers[current]===idx?'sel':''}}"
            wx:for="{{q.options}}"
            wx:key="idx"
            wx:for-index="idx"
            wx:for-item="opt"
            bindtap="selectAnswer"
            data-index="{{idx}}"
            role="button"
            aria-label="选项 {{['A','B','C','D','E','F'][idx]}}：{{opt}}{{answers[current]===idx?'，已选':''}}"
          >
            <text class="opt-key">{{['A','B','C','D','E','F'][idx]}}</text>
            <text class="opt-text">{{opt}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view
          class="choice-opt {{answers[current]===idx?'sel':''}}"
          wx:for="{{q.options}}"
          wx:key="idx"
          wx:for-index="idx"
          wx:for-item="opt"
          bindtap="selectAnswer"
          data-index="{{idx}}"
          role="button"
          aria-label="选项 {{['A','B','C','D','E','F'][idx]}}：{{opt}}{{answers[current]===idx?'，已选':''}}"
        >
          <text class="opt-key">{{['A','B','C','D','E','F'][idx]}}</text>
          <text class="opt-text">{{opt}}</text>
        </view>
      </block>
    </view>

    <!-- 矩阵题（SPM） -->
    <view wx:elif="{{qType==='matrix'}}" class="matrix-wrap">
      <view class="matrix-box">
        <canvas type="2d" id="matrixCanvas" class="matrix-canvas" role="img" aria-label="图形规律题目"></canvas>
      </view>
      <text class="matrix-tip">请选择能补全规律的选项</text>
      <view class="opt-grid">
        <view
          class="opt-cell {{answers[current]===idx?'sel':''}}"
          style="{{optStyle}}"
          wx:for="{{q.options}}"
          wx:key="idx"
          wx:for-index="idx"
          wx:for-item="o"
          bindtap="selectAnswer"
          data-index="{{idx}}"
          role="button"
          aria-label="选项 {{['A','B','C','D','E','F'][idx]}}{{answers[current]===idx?'，已选':''}}"
        >
          <canvas type="2d" id="opt{{idx}}" class="opt-canvas" role="img" aria-label="选项 {{['A','B','C','D','E','F'][idx]}} 图案"></canvas>
        </view>
      </view>
    </view>
  </view>

  <view class="nav-bar">
    <button class="nav-btn ghost" bindtap="prev" disabled="{{current===0}}" aria-label="上一题">上一题</button>
    <button class="nav-btn primary" style="background:{{meta.color}};color:{{meta.colorText}};" bindtap="next" aria-label="{{current===total-1 ? '提交测评' : '下一题'}}">
      {{current===total-1 ? '提交' : '下一题'}}
    </button>
  </view>

  <view class="answered-tip">已作答 {{answeredCount}} / {{total}}（选完后自动跳下一题）</view>
</view>
