<view class="theme-wrapper {{themeClass}}">
  <view wx:if="{{course}}" class="scroll-page">
    <view class="hero">
      <view class="hero-top">
        <view class="hero-icon">{{course.icon}}</view>
        <text class="hero-goal">{{course.goalLabel}}</text>
      </view>
      <text class="hero-title">{{course.name}}</text>
      <text class="hero-sub">{{course.tagline}}</text>
      <view class="hero-meta">
        <text class="pill">约 {{course.totalMinutes}} 分钟（含选做）</text>
        <text class="pill">{{stepCount}} 个步骤</text>
      </view>
      <text class="hero-cadence">{{course.cadence}}</text>
    </view>

    <view class="card section outcome-card">
      <text class="section-title">路线目标</text>
      <text class="section-text">{{course.objective}}</text>
      <text class="outcome-label">为什么这样安排</text>
      <text class="section-text">{{course.why}}</text>
      <text class="outcome-label">完成后带走</text>
      <text class="section-text">{{course.outcome}}</text>
    </view>

    <view wx:if="{{course.disclaimer}}" class="card section notice-card">
      <text class="notice-title">请先了解</text>
      <text class="section-text">{{course.disclaimer}}</text>
    </view>

    <view class="card section progress-card">
      <view class="progress-head">
        <view>
          <text class="section-title">路线进度</text>
          <text class="progress-copy">{{complete ? '必做步骤已完成' : (started ? '按自己的节奏继续' : '准备好时，从任一步开始')}}</text>
        </view>
        <text class="progress-percent">{{percent}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width:{{percent}}%;"></view>
      </view>
      <text class="progress-count">{{completedRequiredCount}} / {{requiredStepCount}} 个必做步骤</text>
    </view>

    <view class="section-heading">
      <text class="section-title">路线步骤</text>
      <text class="section-sub">可以按顺序进行，也可以自由选择；标「可选」的步骤跳过不影响路线完成。</text>
    </view>
    <view class="timeline">
      <view wx:for="{{steps}}" wx:key="id" wx:for-item="step" wx:for-index="stepIndex" class="timeline-item">
        <view class="timeline-rail">
          <view class="step-marker {{step.completed ? 'is-complete' : ''}} {{step.current ? 'is-current' : ''}}">
            {{step.completed ? '✓' : (step.skipped ? '↷' : stepIndex + 1)}}
          </view>
          <view wx:if="{{!step.isLast}}" class="step-line"></view>
        </view>
        <view class="card step-card">
          <view class="step-top">
            <text class="step-number">第 {{stepIndex + 1}} 步</text>
            <text wx:if="{{step.optional}}" class="optional-label">可选</text>
          </view>
          <text class="step-title">{{step.title}}</text>
          <text class="step-name">{{step.name}} · 约 {{step.minutes}} 分钟</text>
          <text class="step-why">{{step.why}}</text>
          <view wx:if="{{step.task}}" class="step-task">
            <text class="step-task-label">本步尝试</text>
            <text class="step-task-text">{{step.task}}</text>
          </view>
          <view wx:if="{{step.isReflection}}" class="reflection-box">
            <text class="reflection-prompt">{{step.prompt}}</text>
            <textarea
              class="reflection-input"
              data-id="{{step.id}}"
              value="{{step.reflection}}"
              maxlength="500"
              auto-height
              placeholder="{{step.placeholder}}"
              bindinput="updateReflection"
              aria-label="{{step.title}}的个人记录"
            />
            <text class="reflection-note">记录仅保存在本机；不必填写敏感信息，留下一项小行动即可。</text>
          </view>
          <text wx:if="{{step.completed}}" class="step-status is-complete">已完成</text>
          <text wx:elif="{{step.skipped}}" class="step-status">已跳过 · 可补做</text>
          <view class="step-actions">
            <button wx:if="{{step.isReflection}}" class="step-button" data-id="{{step.id}}" bindtap="saveReflection" aria-label="保存并完成：{{step.title}}">
              {{step.completed ? '更新我的记录' : '保存并完成'}}
            </button>
            <button wx:else class="step-button" data-id="{{step.id}}" bindtap="openStep" aria-label="开始步骤：{{step.title}}">
              {{step.completed ? '再做一次' : (step.skipped ? '补做这一步' : '开始这一步')}}
            </button>
            <button wx:if="{{!step.completed && !step.skipped}}" class="skip-button" data-id="{{step.id}}" bindtap="skipStep" aria-label="暂时跳过：{{step.title}}">跳过</button>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-actions">
      <button class="secondary-button" bindtap="goList" aria-label="返回课程列表">其他课程</button>
      <button class="text-button" bindtap="goHome" aria-label="返回首页">返回首页</button>
    </view>
    <button class="secondary-button share-course-button" open-type="share" aria-label="分享这条课程路线">分享这条课程路线</button>
    <button wx:if="{{started}}" class="reset-button" bindtap="resetProgress" aria-label="清除这条课程的进度">清除课程进度</button>
    <view class="footer">路线进度与课程回顾仅保存在本机；内容用于自我探索与练习，不构成医学诊断或治疗建议。</view>
  </view>

  <view wx:else class="invalid">
    <text class="invalid-icon">🧭</text>
    <text class="invalid-title">没有找到这条路线</text>
    <text class="invalid-sub">可以返回课程列表重新选择。</text>
    <button class="secondary-button" bindtap="goList" aria-label="返回课程列表">返回课程列表</button>
  </view>
</view>
