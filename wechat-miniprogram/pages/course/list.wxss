.course-page {
  background: var(--bg-primary);
}
.hero {
  padding: 56rpx 40rpx 40rpx;
  background: var(--grad-hero);
  color: var(--text-inverse);
}
.hero-eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}
.hero-title {
  display: block;
  margin-top: 8rpx;
  color: var(--text-inverse);
  font-size: var(--font-size-hero);
  font-weight: var(--font-weight-extrabold);
  letter-spacing: 4rpx;
}
.hero-sub {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--font-size-lg);
  line-height: var(--line-height-normal);
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.18);
  color: var(--text-inverse);
  font-size: var(--font-size-sm);
}
.section-heading {
  margin: 24rpx 32rpx 0;
}
.section-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
}
.section-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-normal);
}
.card {
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  background: var(--card-bg);
  box-shadow: var(--card-shadow);
}
.course-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.course-icon {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-size-4xl);
}
.course-heading {
  min-width: 0;
  flex: 1;
}
.recommended-label {
  display: block;
  margin-bottom: 4rpx;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
}
.course-card {
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
}
.course-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
}
.arrow {
  flex: none;
  color: var(--border-medium);
  font-size: var(--font-size-4xl);
}
.course-tagline {
  display: -webkit-box;
  margin-top: 16rpx;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: var(--font-size-md);
  line-height: var(--line-height-normal);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}
.meta-chip {
  padding: 5rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--bg-tertiary);
  color: var(--text-tertiary);
  font-size: var(--font-size-xs);
}
.persona-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}
.persona-label {
  flex: none;
  color: var(--text-brand);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}
.course-persona {
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-normal);
}
.progress-row {
  margin-top: 18rpx;
}
.progress-copy {
  display: flex;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: var(--font-size-xs);
}
.progress-label {
  color: var(--text-tertiary);
}
.progress-track {
  height: 10rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--progress-bg);
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-brand);
}
.course-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin: 22rpx 0 0;
  border-radius: var(--radius-full);
  background: var(--grad-hero);
  color: var(--text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  line-height: normal;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.course-button::after {
  border: 0;
}
.empty-card {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  color: var(--text-secondary);
  font-size: var(--font-size-md);
  line-height: var(--line-height-normal);
}
.footer {
  padding: 36rpx 32rpx 40rpx;
  color: var(--text-muted);
  text-align: center;
  font-size: var(--font-size-xs);
  line-height: var(--line-height-normal);
}
