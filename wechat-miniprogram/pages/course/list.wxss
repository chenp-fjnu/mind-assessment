.course-page {
  padding: 24rpx;
  background: var(--bg-primary);
}
.intro-card,
.course-card,
.empty-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-xl);
  background: var(--bg-card);
}
.intro-title,
.course-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
}
.intro-desc,
.course-tagline,
.course-persona,
.progress-text,
.empty-card {
  display: block;
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-normal);
}
.goal-label,
.recommended-label {
  display: inline-block;
  margin-top: 14rpx;
  color: var(--text-brand);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}
.course-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.course-icon {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  color: #fff;
  font-size: 40rpx;
}
.course-heading {
  min-width: 0;
  flex: 1;
}
.recommended-label {
  margin: 0 0 6rpx;
}
.course-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 18rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-xs);
}
.progress-row {
  margin-top: 16rpx;
}
.progress-track {
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--border);
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-brand);
}
.progress-text {
  margin-top: 6rpx;
}
.course-button {
  margin: 20rpx 0 0;
  border-radius: var(--radius-lg);
  background: var(--color-brand);
  color: var(--text-inverse);
  font-size: var(--font-size-md);
}
.course-button::after {
  border: 0;
}
.footer {
  padding: 20rpx 12rpx 42rpx;
  color: var(--text-muted);
  text-align: center;
  font-size: var(--font-size-xs);
}
