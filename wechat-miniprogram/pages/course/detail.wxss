.hero {
  padding: 40rpx 40rpx 44rpx;
  background: var(--grad-hero);
  color: var(--text-inverse);
}
.hero-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.hero-icon {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.18);
  font-size: var(--font-size-4xl);
}
.hero-goal {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-full);
  color: var(--text-inverse);
  font-size: var(--font-size-sm);
}
.hero-title {
  display: block;
  margin-top: 20rpx;
  color: var(--text-inverse);
  font-size: var(--font-size-5xl);
  font-weight: var(--font-weight-extrabold);
  line-height: var(--line-height-tight);
}
.hero-sub {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: var(--font-size-md);
  line-height: var(--line-height-relaxed);
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}
.pill {
  padding: 7rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.18);
  color: var(--text-inverse);
  font-size: var(--font-size-sm);
}
.hero-cadence {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-normal);
}
.card {
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  background: var(--card-bg);
  box-shadow: var(--card-shadow);
}
.section {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
}
.section-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
}
.section-text {
  display: block;
  margin-top: 12rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-md);
  line-height: var(--line-height-relaxed);
}
.outcome-label {
  display: block;
  margin-top: 24rpx;
  color: var(--text-brand);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
}
.notice-card {
  border-color: var(--result-note-border);
  background: var(--result-note-bg);
}
.notice-title {
  display: block;
  color: var(--result-note-text);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
}
.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.progress-copy {
  display: block;
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
}
.progress-percent {
  flex: none;
  color: var(--text-brand);
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
}
.progress-track {
  height: 12rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--progress-bg);
}
.progress-fill {
  height: 100%;
  border-radius: var(--radius-full);
  background: var(--color-brand);
  transition: width 0.2s ease;
}
.progress-count {
  display: block;
  margin-top: 10rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-xs);
  text-align: right;
}
.section-heading {
  margin: 28rpx 32rpx 12rpx;
}
.section-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
}
.timeline {
  margin: 0 32rpx;
}
.timeline-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.timeline-rail {
  width: 52rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.step-marker {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-full);
  background: var(--bg-card);
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
}
.step-marker.is-current {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: var(--text-inverse);
}
.step-marker.is-complete {
  border-color: var(--badge-success-bg);
  background: var(--badge-success-bg);
  color: var(--text-success);
}
.step-line {
  width: 2rpx;
  flex: 1;
  min-height: 20rpx;
  background: var(--border-light);
}
.step-card {
  min-width: 0;
  flex: 1;
  margin-bottom: 20rpx;
  padding: 24rpx;
}
.step-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.step-number {
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
}
.optional-label {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background: var(--badge-warning-bg);
  color: var(--text-warning);
  font-size: var(--font-size-xs);
}
.step-title {
  display: block;
  margin-top: 8rpx;
  color: var(--text-primary);
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-normal);
}
.step-name {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
}
.step-why {
  display: block;
  margin-top: 10rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
}
.step-task {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--bg-brand);
}
.step-task-label {
  display: block;
  color: var(--text-brand);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
}
.step-task-text {
  display: block;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
}
.reflection-box {
  margin-top: 16rpx;
}
.reflection-prompt {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  line-height: var(--line-height-relaxed);
}
.reflection-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--border-medium);
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  color: var(--text-primary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
}
.reflection-note {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  line-height: var(--line-height-normal);
}
.step-status {
  display: inline-block;
  margin-top: 12rpx;
  color: var(--text-warning);
  font-size: var(--font-size-xs);
}
.step-status.is-complete {
  color: var(--text-success);
}
.step-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}
.step-button,
.skip-button,
.secondary-button,
.text-button,
.reset-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 0;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  line-height: normal;
  text-align: center;
}
.step-button {
  min-width: 0;
  flex: 1;
  background: var(--color-brand);
  color: var(--text-inverse);
  box-shadow: var(--shadow-sm);
  font-weight: var(--font-weight-semibold);
}
.skip-button,
.secondary-button {
  border: 1rpx solid var(--border-medium);
  padding: 0 22rpx;
  background: var(--bg-card);
  color: var(--btn-secondary-text);
  font-weight: var(--font-weight-medium);
}
.step-button::after,
.skip-button::after,
.secondary-button::after,
.text-button::after {
  border: 0;
}
.bottom-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 8rpx 32rpx 0;
}
.bottom-actions button {
  flex: 1;
}
.text-button {
  border: 1rpx solid var(--border-focus);
  background: var(--color-brand-50);
  color: var(--color-brand-700);
  font-weight: var(--font-weight-semibold);
}
.reset-button {
  min-width: 220rpx;
  margin: 20rpx auto 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--border-light);
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}
.reset-button::after {
  border: 0;
}
.footer {
  padding: 16rpx 36rpx 40rpx;
  color: var(--text-muted);
  font-size: var(--font-size-xs);
  line-height: var(--line-height-normal);
  text-align: center;
}
.invalid {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: var(--bg-primary);
}
.invalid-icon {
  font-size: 88rpx;
}
.invalid-title {
  margin-top: 24rpx;
  color: var(--text-primary);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
}
.invalid-sub {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-size-md);
  text-align: center;
}
.invalid .secondary-button {
  margin-top: 32rpx;
  padding: 0 32rpx;
}
