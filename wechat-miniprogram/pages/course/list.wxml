<view class="theme-wrapper {{themeClass}}">
  <view class="scroll-page course-page">
    <view class="intro-card">
      <text class="intro-title">按自己的节奏开始</text>
      <text class="intro-desc">每条路线都由现有测评、方法或训练组成。可以跳过步骤，也可以随时回到完整内容库。</text>
      <text wx:if="{{goalLabel}}" class="goal-label">你的选择：{{goalLabel}}</text>
    </view>

    <view wx:for="{{courses}}" wx:key="id" wx:for-item="course" class="course-card">
      <view class="course-head">
        <view class="course-icon" style="background:{{course.color}};">{{course.icon}}</view>
        <view class="course-heading">
          <text wx:if="{{course.recommended}}" class="recommended-label">为你推荐</text>
          <text class="course-title">{{course.name}}</text>
          <text class="course-tagline">{{course.tagline}}</text>
        </view>
      </view>
      <text class="course-persona">适合：{{course.persona}}</text>
      <view class="course-meta">
        <text>约 {{course.totalMinutes}} 分钟</text>
        <text>{{course.steps.length}} 个步骤</text>
      </view>
      <view wx:if="{{course.started}}" class="progress-row">
        <view class="progress-track"><view class="progress-fill" style="width:{{course.percent}}%;"></view></view>
        <text class="progress-text">{{course.complete ? '必做步骤已完成' : course.completedRequiredCount + '/' + course.requiredStepCount + ' 个必做步骤'}}</text>
      </view>
      <button class="course-button" data-id="{{course.id}}" bindtap="openCourse" aria-label="查看课程：{{course.name}}">
        {{course.started ? '继续 / 查看路线' : '查看路线'}}
      </button>
    </view>

    <view wx:if="{{empty}}" class="empty-card">
      <text>暂时没有可用课程，可以直接浏览测评、方法或训练。</text>
    </view>
    <view class="footer">课程用于自我探索与练习，不构成诊断或治疗建议。</view>
  </view>
</view>
