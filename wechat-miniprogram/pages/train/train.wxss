/* ============================================
   训练列表页 - 统一设计系统
   ============================================ */

.hero {
  padding: 56rpx 40rpx 40rpx;
  background: var(--grad-train-page);
}
.hero-title {
  display: block;
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.92);
  font-size: 27rpx;
  margin-top: 16rpx;
  font-weight: 500;
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}
.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
}
.pill .num {
  font-weight: 700;
  margin-right: 4rpx;
}
.pill.link {
  background: rgba(255, 255, 255, 0.26);
  color: #fff;
  font-weight: 600;
}
.group {
  margin: 24rpx 32rpx 0;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin: 16rpx 4rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.item-body {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}
.item-head {
  display: flex;
  align-items: center;
}
.item-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.item-desc {
  display: block;
  font-size: 25rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  line-height: 1.5;
}
.item-meta {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}
.arrow {
  color: var(--border-medium);
  font-size: 44rpx;
  margin-left: 8rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 0 24rpx;
  height: 72rpx;
  background: var(--card);
  border-radius: 999rpx;
  box-shadow: var(--shadow-sm);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.search-ph {
  color: var(--text-muted);
}
.search-clear {
  font-size: 28rpx;
  color: var(--text-muted);
  padding: 0 8rpx;
}
.type-bar {
  white-space: nowrap;
  margin: 20rpx 32rpx 0;
}
.type-chip {
  display: inline-block;
  font-size: 25rpx;
  color: var(--text-tertiary);
  background: var(--bg-tertiary);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}
.type-chip.on {
  color: #fff;
  background: var(--color-train);
}
.empty-search {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-search-icon {
  font-size: 64rpx;
  opacity: 0.5;
}
.empty-search-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: 22rpx;
  padding: 40rpx 40rpx 40rpx;
}

@media (prefers-color-scheme: dark) {
  .group-title { color: var(--text-secondary); }
  .item-name { color: var(--text-primary); }
  .item-desc { color: var(--text-tertiary); }
  .item-meta { color: var(--text-tertiary); }
  .arrow { color: var(--border-medium); }
  .footer { color: var(--text-muted); }
  .search-bar { background: var(--card); }
  .search-input { color: var(--text-primary); }
  .search-ph { color: var(--text-muted); }
  .search-clear { color: var(--text-muted); }
  .type-chip { color: var(--text-tertiary); background: var(--bg-tertiary); }
  .type-chip.on { color: #fff; background: var(--color-train); }
  .empty-search-text { color: var(--text-tertiary); }
}