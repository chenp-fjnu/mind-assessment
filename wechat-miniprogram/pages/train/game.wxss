/* ============================================
   训练游戏详情页 - 统一设计系统
   ============================================ */

.hero {
  padding: calc(96rpx + env(safe-area-inset-top)) 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: var(--grad-train-page);
}
.back {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 28rpx;
  font-size: 30rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.16);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}
.h-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}
.hero-title {
  display: block;
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}
.hero-tag {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}
.levels {
  margin: 28rpx 32rpx 0;
}
.lv-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}
.lv-bar {
  white-space: nowrap;
  margin-top: 14rpx;
}
.lv-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}
.lv-chip .lv-best {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}
.lv-chip.on {
  color: #fff;
  background: var(--color-train);
  border-color: var(--color-train);
}
.lv-chip.on .lv-best {
  opacity: 0.9;
}
.board {
  width: 94vw;
  max-width: 760rpx;
  max-height: 60vh;
  aspect-ratio: 1 / 1;
  margin: 24rpx auto 0;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}
.result {
  margin: 28rpx 32rpx 0;
  padding: 32rpx;
}
.res-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.res-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.res-chip {
  flex: 1 1 30%;
  min-width: 150rpx;
  background: var(--bg-tertiary);
  border-radius: 18rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.res-val {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.res-lab {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.trend {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
}
.res-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.btn-primary,
.btn-ghost {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
.btn-ghost {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}
.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: 22rpx;
  padding: 40rpx 40rpx 40rpx;
}

@media (prefers-color-scheme: dark) {
  .lv-title { color: var(--text-secondary); }
  .lv-chip { color: var(--text-tertiary); }
  .res-title { color: var(--text-primary); }
  .res-val { color: var(--text-primary); }
  .res-lab { color: var(--text-tertiary); }
  .trend { color: var(--text-tertiary); }
  .btn-ghost { color: var(--text-secondary); }
  .footer { color: var(--text-muted); }
}