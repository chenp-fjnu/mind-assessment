/* ============================================
   训练游戏详情页 - 统一设计系统
   ============================================ */

.hero {
  padding: calc(96rpx + env(safe-area-inset-top)) 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: var(--grad-train-page);
}
.back {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 28rpx;
  font-size: var(--font-size-2xl);
  color: var(--text-inverse);
  background: rgba(255, 255, 255, 0.16);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
}
.h-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-xxl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}
.hero-title {
  display: block;
  color: var(--text-inverse);
  font-size: var(--font-size-5xl);
  font-weight: var(--font-weight-extrabold);
  letter-spacing: 2rpx;
}
.hero-sub {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: var(--font-size-md);
  margin-top: 12rpx;
  line-height: var(--line-height-normal);
}
.hero-tag {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 22rpx;
  font-size: var(--font-size-sm);
  color: var(--text-inverse);
  background: rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-full);
}
.levels {
  margin: 28rpx 32rpx 0;
}
.lv-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
}
.lv-bar {
  white-space: nowrap;
  margin-top: 14rpx;
}
.lv-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  background: var(--chip-bg);
  border: 2rpx solid var(--border-light);
  padding: 12rpx 26rpx;
  border-radius: var(--radius-full);
  margin-right: 16rpx;
}
.lv-chip .lv-best {
  font-size: var(--font-size-xs);
  opacity: 0.8;
  margin-top: 4rpx;
}
.lv-chip.on {
  color: var(--text-inverse);
  background: var(--color-train);
  border-color: var(--color-train);
}
.lv-chip.on .lv-best {
  opacity: 0.9;
}
.board {
  position: relative;
  width: 94vw;
  max-width: 760rpx;
  max-height: 60vh;
  aspect-ratio: 1 / 1;
  margin: 24rpx auto 0;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}
/* 全屏模式：棋盘占满整屏，方格类游戏随 boardWidth 自动放大，便于点击 */
.board.fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  max-width: none;
  max-height: none;
  aspect-ratio: auto;
  margin: 0;
  z-index: 1000;
  border-radius: 0;
  padding: calc(env(safe-area-inset-top) + 24rpx) 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
}
.fs-toggle {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  right: 24rpx;
  z-index: 2;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-inverse);
  background: rgba(15, 23, 42, 0.55);
  border-radius: var(--radius-full);
}
.result {
  margin: 28rpx 32rpx 0;
  padding: 32rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}
.res-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}
.res-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.res-chip {
  flex: 1 1 30%;
  min-width: 150rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-xxl);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.res-val {
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-extrabold);
  color: var(--text-primary);
}
.res-lab {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.trend {
  margin-top: 24rpx;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
  text-align: center;
}
.res-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.btn-primary,
.btn-ghost {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-extrabold);
  color: var(--text-inverse);
}
.btn-primary {
  background: var(--color-train);
}
.btn-ghost {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}
.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-size-sm);
  padding: 40rpx 40rpx 40rpx;
}