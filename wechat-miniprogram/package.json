{
  "name": "mind-assessment-miniprogram",
  "version": "1.0.0",
  "description": "心智探索局",
  "private": true,
  "scripts": {
    "test": "node test/smoke.js",
    "test:simulate": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "validate": "node scripts/check-meta.js && node scripts/check-game-player.js",
    "test:all": "node scripts/check-meta.js && node scripts/check-game-player.js && node test/smoke.js && jest --coverage --forceExit",
    "lint": "eslint \"**/*.js\" --ignore-pattern node_modules --ignore-pattern utils/questions.js",
    "lint:strict": "eslint \"**/*.js\" --ignore-pattern node_modules --ignore-pattern utils/questions.js --max-warnings 0",
    "format": "prettier --write \"**/*.{js,json,wxml,wxss}\"",
    "format:check": "prettier --check \"**/*.{js,json,wxml,wxss}\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  }
}
