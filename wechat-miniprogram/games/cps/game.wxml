<view class="cps">
  <view class="info" wx:if="{{phase === 'play'}}">剩余 {{leftText}}s ｜ {{cpsText}} CPS</view>
  <view class="info" wx:else>限时 {{duration}} 秒挑战</view>

  <view
    class="big {{phase === 'play' ? 'on' : ''}} {{flash ? 'flash' : ''}}"
    bindtap="onTap"
    role="button"
    aria-label="{{phase === 'play' ? '点击计数' : '开始连点'}}"
  >
    <block wx:if="{{phase === 'idle'}}">
      <text class="start-label">点击开始</text>
      <text class="start-sub">开始后尽快连点</text>
    </block>
    <block wx:else>
      <text class="n">{{clicks}}</text>
      <text class="t">次</text>
    </block>
  </view>

  <view wx:if="{{phase === 'idle'}}" class="tip">在 {{duration}} 秒内尽可能快地连点，测你的 CPS（每秒点击数）</view>
  <view wx:if="{{phase === 'play'}}" class="tip">快点！越快越好</view>
</view>
