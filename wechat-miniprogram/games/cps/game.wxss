.cps {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 30rpx;
}
.big {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background: var(--chip);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.05s;
}
.big.on {
  background: #fde68a;
}
.big:active {
  transform: scale(0.96);
}
.n {
  font-size: 120rpx;
  font-weight: 800;
  color: var(--text);
}
.t {
  font-size: 28rpx;
  color: var(--sub);
}
.tip {
  margin-top: 30rpx;
  color: var(--sub);
  font-size: 24rpx;
}
