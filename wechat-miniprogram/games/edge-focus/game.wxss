.ef {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 20rpx;
}
.stage {
  width: 100%;
  height: 56vmin;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  width: 56vmin;
  height: 56vmin;
  padding: 8rpx;
  box-sizing: border-box;
  background: var(--bg2);
  border-radius: 20rpx;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 44rpx;
  color: var(--text);
}
.grid.ok .cell { background: #dcfce7; }
.grid.bad .cell { background: #fee2e2; }
.space {
  width: 320rpx;
  height: 110rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0ea5e9;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 55rpx;
  box-shadow: 0 6rpx 0 #0284c7;
}
.space:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #0284c7;
}
.tip {
  margin-top: 20rpx;
  color: var(--sub);
  font-size: 24rpx;
  text-align: center;
}
.btn-start {
  margin-top: 24rpx;
  padding: 22rpx 72rpx;
  background: #0ea5e9;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 0 #0284c7;
}
.btn-start:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #0284c7;
}
