.breath-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  box-sizing: border-box;
  flex: 1;
  width: 100%;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}

.round {
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.breath-circle-wrapper {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0;
}

.breath-circle {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
  box-shadow: 0 0 60rpx rgba(56, 189, 248, 0.4), inset 0 0 40rpx rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.phase-label {
  font-size: 40rpx;
  font-weight: 600;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.phase-timer {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

.idle-text, .done-text {
  text-align: center;
  color: #6b7280;
}

.idle-text text, .done-text text {
  display: block;
}

.hint {
  font-size: 24rpx;
  margin-top: 12rpx !important;
  color: #9ca3af !important;
}

.complete {
  font-size: 40rpx !important;
  font-weight: 600 !important;
  color: #38bdf8 !important;
  margin-bottom: 16rpx !important;
}

.phase-indicators {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 0;
  flex-wrap: wrap;
  justify-content: center;
}

.phase-dot {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.phase-dot.active {
  background: #38bdf8;
  color: white;
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.5);
}

.controls {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.btn-primary, .btn-secondary {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  min-width: 180rpx;
}

.btn-primary {
  background: #38bdf8;
  color: white;
  border: none;
}

.btn-primary[disabled] {
  background: #9ca3af;
}

.btn-secondary {
  background: white;
  color: #6b7280;
  border: 2rpx solid #d1d5db;
}

.btn-secondary[disabled] {
  color: #d1d5db;
  border-color: #e5e7eb;
}