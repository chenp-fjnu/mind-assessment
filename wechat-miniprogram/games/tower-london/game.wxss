.tl {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 16rpx;
}
.goal {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.gl {
  font-size: 24rpx;
  color: var(--sub);
}
.gpegs {
  display: flex;
  gap: 12rpx;
}
.gpeg {
  width: 96rpx;
  min-height: 80rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  padding: 6rpx;
}
.pegs {
  display: flex;
  gap: 14rpx;
  width: 100%;
  justify-content: space-around;
}
.peg {
  flex: 1;
  height: 320rpx;
  background: #e2e8f0;
  border-radius: 0 0 16rpx 16rpx;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  padding-top: 10rpx;
  border-top: 8rpx solid #94a3b8;
}
.peg.sel {
  border-top-color: var(--accent);
}
.ball {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-top: 8rpx;
}
.tip {
  margin-top: 20rpx;
  color: var(--sub);
  font-size: 24rpx;
  text-align: center;
}
