.stroop {
  width: 100%;
  text-align: center;
}
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.word {
  font-size: 120rpx;
  font-weight: 800;
  margin: 30rpx 0 10rpx;
  letter-spacing: 8rpx;
}
.progress {
  color: var(--sub);
  font-size: 26rpx;
  margin-bottom: 36rpx;
}
.opts {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
}
.opt {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.12);
}
.opt-label {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}
.hint {
  margin-top: 30rpx;
  color: var(--sub);
  font-size: 24rpx;
}
.done-tip {
  text-align: center;
  color: var(--sub);
  padding: 60rpx 0;
}
