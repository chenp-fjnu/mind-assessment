.bb {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ring {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.12);
  border: 6rpx solid #10b981;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 1s linear;
  margin: 40rpx 0 10rpx;
}
.ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.phase {
  font-size: 44rpx;
  font-weight: 700;
  color: #10b981;
}
.count {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.1;
}
.hint {
  color: var(--sub);
  font-size: 26rpx;
  margin: 16rpx 0 30rpx;
}
.ctrls {
  display: flex;
  gap: 20rpx;
}
.btn-start,
.btn-stop {
  padding: 18rpx 60rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.btn-start {
  background: #10b981;
}
.btn-stop {
  background: #ef4444;
}
