.fr {
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip {
  text-align: center;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 20rpx;
  line-height: 1.8;
}

.tip .progress {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.sw {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin: 0 8rpx;
  vertical-align: middle;
}

.grid {
  display: grid;
  gap: 6rpx;
  max-width: 680rpx;
  margin: 0 auto;
}

.cell {
  aspect-ratio: 1;
  border-radius: 8rpx;
  transition: transform 0.1s, opacity 0.1s, box-shadow 0.1s;
  border: 2rpx solid transparent;
}

.cell:active {
  transform: scale(0.96);
}

.cell.hit {
  opacity: 0.5;
  border-color: #10b981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.3);
}

.cell.wrong {
  animation: shake 0.3s ease;
  border-color: #ef4444;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-6rpx); }
  75% { transform: translateX(6rpx); }
}

/* 开始界面 */
.start-screen {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.start-card {
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  text-align: center;
  max-width: 500rpx;
  width: 90%;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.rule-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.rule-label {
  font-size: 28rpx;
  color: #374151;
}

.rule-color {
  font-size: 32rpx;
  font-weight: 700;
  color: #db2777;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 32rpx;
}

.btn-start, .btn-restart {
  width: 100%;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #db2777 0%, #be185d 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(219, 39, 119, 0.3);
}

.btn-restart {
  background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
  box-shadow: 0 4rpx 16rpx rgba(107, 114, 128, 0.3);
}

/* 完成界面 */
.done-screen {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.done-card {
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  text-align: center;
  max-width: 500rpx;
  width: 90%;
}

.complete {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #10b981;
  margin-bottom: 16rpx;
}

.stats {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.game-screen {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}