<view class="connect">
  <view class="stage" catchtouchmove="preventScroll">
    <!-- 左侧进度列：当前要点到的数字（蓝）+ 前两个（浅），常驻不抖动 -->
    <view class="rail">
      <view class="bubble ghost" wx:if="{{next - 1 > 1}}">{{next - 1}}</view>
      <view class="bubble ghost" wx:if="{{next - 2 > 1}}">{{next - 2}}</view>
      <view class="bubble cur">{{next < total ? next : total}}</view>
    </view>

    <view
      class="board"
      style="display:grid;grid-template-columns:repeat({{size}},1fr);gap:12rpx;justify-content:center;"
    >
      <view
        wx:for="{{cells}}"
        wx:key="idx"
        class="cell {{item.found ? 'found' : ''}} {{pop === index ? 'pop' : ''}} {{shakeIdx === index ? 'wrong' : ''}}"
        data-n="{{item.n}}"
        data-idx="{{index}}"
        bindtap="onTap"
        role="button"
        aria-label="{{item.found ? '已选中' : '数字 ' + item.n}}"
        style="width:100%;height:{{cellH}}rpx;font-size:{{fontSize}}rpx;"
      >
        <text wx:if="{{!item.found}}">{{item.n}}</text>
      </view>
    </view>
  </view>

  <view class="hint">
    <text class="hint-progress">已连 {{foundCount}} / {{total}}</text>
    <text class="hint-combo {{combo >= 3 ? 'hot' : ''}}">连击 {{combo}}</text>
    <text class="hint-err" wx:if="{{errors > 0}}">失误 {{errors}}</text>
  </view>
</view>
