.sm {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pads {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  width: 440rpx;
}
.pad {
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  opacity: 0.55;
  transition: opacity 0.1s, transform 0.1s;
}
.pad.p0 { background: #ef4444; }
.pad.p1 { background: #22c55e; }
.pad.p2 { background: #3b82f6; }
.pad.p3 { background: #eab308; }
.pad.flash {
  opacity: 1;
  transform: scale(1.04);
}
.bar {
  margin-top: 28rpx;
  color: var(--sub);
  font-size: 26rpx;
}
