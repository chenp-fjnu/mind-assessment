.sm {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 16rpx;
}
.pads {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  justify-content: center;
}
.pad {
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  opacity: 0.55;
  transition: opacity 0.1s, transform 0.1s;
}
.pad.p0 { background: #ef4444; }
.pad.p1 { background: #22c55e; }
.pad.p2 { background: #3b82f6; }
.pad.p3 { background: #eab308; }
.pad.flash {
  opacity: 1;
  transform: scale(1.04);
}
.bar {
  margin-top: 28rpx;
  color: var(--sub);
  font-size: 26rpx;
  text-align: center;
}

/* 开始界面 */
.start-screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: var(--card-bg, #fff);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text1);
  margin-bottom: 12rpx;
}
.desc {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 32rpx;
}
.pads.demo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 24rpx 0;
  justify-content: center;
}
.pads.demo .pad {
  opacity: 1;
}
.hint {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 32rpx;
}
.btn-start {
  width: 80%;
  max-width: 320rpx;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(239, 68, 68, 0.4);
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}