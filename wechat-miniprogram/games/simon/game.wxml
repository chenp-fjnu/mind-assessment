<view class="sm">
  <!-- 开始界面 -->
  <view wx:if="{{phase === 'idle'}}" class="start-screen">
    <text class="title">序列记忆</text>
    <text class="desc">记住并复述色块闪烁顺序</text>
    <view class="pads demo">
      <view wx:for="{{4}}" wx:key="*this" class="pad p{{index}}" style="width:{{padSize}}rpx;height:{{padSize}}rpx;"></view>
    </view>
    <text class="hint">{{seq.length || 3}} 步序列</text>
    <button class="btn-start" bindtap="start">开始游戏</button>
  </view>

  <!-- 游戏界面 -->
  <view wx:elif="{{phase !== 'idle'}}" class="game-screen">
    <view class="pads" style="grid-template-columns:1fr 1fr;gap:20rpx;justify-content:center;">
      <view
        wx:for="{{4}}"
        wx:key="*this"
        class="pad p{{index}} {{flash === index ? 'flash' : ''}}"
        data-d="{{index}}"
        bindtap="onPad"
        role="button"
        aria-label="色块 {{index}}"
        style="width:{{padSize}}rpx;height:{{padSize}}rpx;"
      ></view>
    </view>
    <view class="bar">
      <text wx:if="{{phase === 'show'}}">记住闪烁顺序…</text>
      <text wx:if="{{phase === 'input'}}">复述顺序（{{inputIdx}}/{{seq.length}}）</text>
      <text wx:if="{{phase === 'done'}}">完成！正确 {{correct}} / {{seq.length}}</text>
    </view>
  </view>
</view>
