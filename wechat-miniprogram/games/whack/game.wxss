.wh {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wh.shake {
  animation: shake 0.4s;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-10rpx); }
  30% { transform: translateX(12rpx); }
  45% { transform: translateX(-14rpx); }
  60% { transform: translateX(10rpx); }
  75% { transform: translateX(-6rpx); }
}
.info {
  display: flex;
  gap: 28rpx;
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 24rpx;
}
.info-item {
  font-weight: 600;
}
.info-item.combo.hot {
  color: #f97316;
  transform: scale(1.08);
}
.grid {
  display: grid;
  gap: 18rpx;
  width: 100%;
  justify-content: center;
}
.hole {
  aspect-ratio: 1 / 1;
  background: #94a3b8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  position: relative;
}
.hole.up {
  background: #fb923c;
  transform: scale(1.06);
  box-shadow: 0 6rpx 16rpx rgba(249, 115, 22, 0.45);
}
.hole.bomb {
  background: #ef4444;
  box-shadow: 0 6rpx 16rpx rgba(239, 68, 68, 0.5);
}
.mole {
  font-size: 72rpx;
  transform: translateY(-6rpx);
  animation: rise 160ms ease-out;
}
.pop {
  font-size: 72rpx;
  animation: pop 320ms ease-out;
}
@keyframes rise {
  from { transform: translateY(20rpx) scale(0.6); opacity: 0; }
  to { transform: translateY(-6rpx) scale(1); opacity: 1; }
}
@keyframes pop {
  0% { transform: scale(0.4); opacity: 0; }
  40% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 0; }
}
.tip {
  margin-top: 24rpx;
  color: var(--sub);
  font-size: 24rpx;
}
.start-btn {
  margin-top: 28rpx;
  padding: 18rpx 64rpx;
  background: #f97316;
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}
