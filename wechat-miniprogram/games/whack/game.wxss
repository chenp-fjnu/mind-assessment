.wh {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 24rpx;
}
.grid {
  display: grid;
  gap: 18rpx;
  width: 100%;
}
.hole {
  aspect-ratio: 1 / 1;
  background: #cbd5e1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.hole.up {
  background: #fdba74;
}
.mole {
  transform: translateY(-6rpx);
}
.tip {
  margin-top: 24rpx;
  color: var(--sub);
  font-size: 24rpx;
}
