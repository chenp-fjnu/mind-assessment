.nm {
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  width: 100%;
}

.tip {
  text-align: center;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
}

.grid {
  display: grid;
  gap: 4rpx;
  justify-content: center;
  margin: 0 auto;
}

.cell {
  aspect-ratio: 1;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  background: #f8fafc;
  transition: all 0.1s ease;
}

.cell:active {
  transform: scale(0.97);
}

.cell.cur {
  background: #dbeafe;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.3);
  z-index: 1;
}

.cell.exit {
  background: #fef3c7;
}

.cell.visited {
  background: #f1f5f9;
}

.cell.wall-flash {
  animation: wallFlash 0.15s ease;
}

@keyframes wallFlash {
  0% { background: #fecaca; }
  50% { background: #ef4444; color: white; }
  100% { background: #fecaca; }
}

/* 开始界面 */
.start-screen {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.start-card {
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  text-align: center;
  max-width: 500rpx;
  width: 90%;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.btn-start, .btn-restart {
  width: 100%;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.3);
}

.btn-restart {
  background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
  box-shadow: 0 4rpx 16rpx rgba(107, 114, 128, 0.3);
}

/* 完成界面 */
.done-screen {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.done-card {
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  text-align: center;
  max-width: 500rpx;
  width: 90%;
}

.complete {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #10b981;
  margin-bottom: 24rpx;
}

.stats {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  color: #374151;
}

.game-screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
}