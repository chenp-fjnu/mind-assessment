.schulte {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.board {
  width: 100%;
  margin: 0 auto;
}
.opts {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}
.mark-toggle {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--border-light);
  border-radius: 999rpx;
  background: var(--card-bg);
}
.mark-toggle.on {
  border-color: var(--border-light);
}
.mark-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  margin-right: 10rpx;
}
.mark-toggle.on .mark-dot {
  background: #7c3aed;
}
.mark-label {
  color: var(--text-secondary);
  font-size: 24rpx;
}
.mark-state {
  color: var(--text-tertiary);
  font-size: 24rpx;
  margin-left: 8rpx;
}
.cell {
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  font-weight: 700;
  color: var(--text-primary);
  transition: background 0.12s, color 0.12s, border-color 0.12s;
}
.cell.found {
  background: rgba(124, 58, 237, 0.14);
  border-color: transparent;
  color: var(--text-tertiary);
}
.hint {
  margin-top: 24rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 26rpx;
}