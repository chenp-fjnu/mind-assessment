.schulte {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.board {
  width: 100%;
  margin: 0 auto;
}
.opts {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}
.mark-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.mark-label {
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-right: 16rpx;
}
/* 仿 iOS 风格拨动开关 */
.ios-switch {
  position: relative;
  width: 96rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(120, 120, 128, 0.32);
  transition: background 0.25s ease;
  box-sizing: border-box;
}
.ios-switch.on {
  background: #34c759;
}
.ios-thumb {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
  transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1);
}
.ios-switch.on .ios-thumb {
  transform: translateX(40rpx);
}
.cell {
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  font-weight: 700;
  color: var(--text-primary);
  transition: background 0.12s, color 0.12s, border-color 0.12s;
}
.cell.found {
  background: rgba(124, 58, 237, 0.14);
  border-color: transparent;
  color: var(--text-tertiary);
}
.hint {
  margin-top: 24rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 26rpx;
}