.schulte {
  width: 100%;
}
.board {
  width: 100%;
  margin: 0 auto;
}
.cell {
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  transition: background 0.12s, color 0.12s;
}
.cell.found {
  background: rgba(124, 58, 237, 0.14);
  border-color: transparent;
}
.hint {
  margin-top: 24rpx;
  text-align: center;
  color: var(--sub);
  font-size: 26rpx;
}
