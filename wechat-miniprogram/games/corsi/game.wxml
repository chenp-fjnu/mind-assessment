<view class="co">
  <view class="grid" style="grid-template-columns:repeat({{cols}},1fr);gap:18rpx;justify-content:center;">
    <view
      wx:for="{{blocks}}"
      wx:key="*this"
      class="blk {{flash === index ? 'flash' : ''}}"
      data-idx="{{index}}"
      bindtap="onTap"
      role="button"
      aria-label="方块 {{index}}"
      style="width:{{cellSize}}rpx;height:{{cellSize}}rpx;"
    ></view>
  </view>
  <view class="bar">
    <text wx:if="{{phase === 'show'}}">记住点亮顺序…</text>
    <text wx:if="{{phase === 'input'}}">依序点出（{{inputIdx}}/{{seq.length}}）</text>
    <text wx:if="{{phase === 'idle'}}">记住并复述方块顺序</text>
    <text wx:if="{{phase === 'done'}}">完成！</text>
  </view>
</view>