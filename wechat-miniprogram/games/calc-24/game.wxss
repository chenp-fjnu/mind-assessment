.c24 {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 24rpx;
}
.info {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}
.target {
  font-size: 40rpx;
  font-weight: 700;
  color: #0891b2;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}
.cards {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.card {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition:
    opacity 0.15s ease,
    transform 0.1s ease;
}
.card:active {
  transform: scale(0.94);
}
.card.used {
  opacity: 0.3;
  border-style: dashed;
  box-shadow: none;
}
.expr {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 14rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-lg);
  margin-bottom: 12rpx;
}
.expr.bad {
  border-color: var(--text-error);
  animation: c24-shake 0.35s ease;
}
@keyframes c24-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  75% {
    transform: translateX(10rpx);
  }
}
.tok.num {
  color: var(--text-primary);
}
.tok.op {
  color: #0891b2;
}
.ph {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-muted);
}
.ans {
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
  background: var(--bg-brand);
  border-radius: var(--radius-md);
  margin-bottom: 8rpx;
  overflow-wrap: anywhere;
}
.ops {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.opbtn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-md);
  transition: transform 0.1s ease;
}
.opbtn:active {
  transform: scale(0.94);
  background: var(--interactive-active);
}
.acts {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.3fr;
  gap: 14rpx;
}
.act {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  transition: transform 0.1s ease;
}
.act:active {
  transform: scale(0.96);
}
.act.ghost {
  color: var(--text-secondary);
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-light);
}
.act.go {
  color: #fff;
  background: #0891b2;
  font-size: 44rpx;
}
.tip {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding: 0 24rpx;
}
