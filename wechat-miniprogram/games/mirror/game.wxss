.mr {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 16rpx;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 24rpx;
}
.pair {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  width: 100%;
}
.pat {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  width: 42vw;
  max-width: 42vh;
}
.pc {
  aspect-ratio: 1 / 1;
  background: #e2e8f0;
  border-radius: 6rpx;
}
.pc.on {
  background: #0ea5e9;
}
.vs {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--sub);
}

/* 开始界面 */
.start-screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: var(--card-bg, #fff);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text1);
  margin-bottom: 12rpx;
}
.desc {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 32rpx;
}
.pair.demo {
  margin: 24rpx 0;
  gap: 24rpx;
}
.pair.demo .pat {
  width: 36vw;
  max-width: 36vh;
}
.pair.demo .vs {
  color: #0ea5e9;
  font-weight: 700;
}
.btn-start {
  width: 80%;
  max-width: 320rpx;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(14, 165, 233, 0.4);
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pair {
  margin-bottom: 24rpx;
}
.pair .vs {
  transition: color 0.2s;
}
.answers {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.abtn {
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.abtn.yes {
  background: #22c55e;
}
.abtn.no {
  background: #64748b;
}
.abtn:active {
  transform: scale(0.96);
}

/* 反馈 */
.feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.feedback.correct {
  background: rgba(34, 197, 94, 0.1);
}
.feedback.wrong {
  background: rgba(239, 68, 68, 0.1);
}
.feedback .correct {
  color: #22c55e;
  font-size: 36rpx;
  font-weight: 700;
}
.feedback .wrong {
  color: #ef4444;
  font-size: 36rpx;
  font-weight: 700;
}
.feedback text:last-child {
  color: var(--text2);
  font-size: 26rpx;
}

/* 完成界面 */
.done-screen {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: var(--card-bg, #fff);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}
.done-screen .title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text1);
  margin-bottom: 24rpx;
}
.stats {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}
.stats text {
  font-size: 28rpx;
  color: var(--text2);
}
.btn-restart {
  width: 80%;
  max-width: 320rpx;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(14, 165, 233, 0.4);
}
