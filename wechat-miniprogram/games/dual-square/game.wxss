.ds {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 20rpx;
}
.stage {
  width: 100%;
  height: 50vmin;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  width: 48vmin;
  height: 48vmin;
  padding: 8rpx;
  box-sizing: border-box;
  background: var(--bg2);
  border-radius: 20rpx;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 52rpx;
  color: #6366f1;
  font-weight: 700;
}
.fb {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--text);
}
.glyph {
  font-size: 72rpx;
  opacity: 0.5;
}
.space {
  width: 320rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #6366f1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 55rpx;
  box-shadow: 0 6rpx 0 #4f46e5;
}
.space:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #4f46e5;
}
.tip {
  margin-top: 20rpx;
  color: var(--sub);
  font-size: 24rpx;
  text-align: center;
  padding: 0 24rpx;
}
.hl {
  color: #6366f1;
  font-weight: 600;
}
.btn-start {
  margin-top: 24rpx;
  padding: 22rpx 72rpx;
  background: #6366f1;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 0 #4f46e5;
}
.btn-start:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #4f46e5;
}
