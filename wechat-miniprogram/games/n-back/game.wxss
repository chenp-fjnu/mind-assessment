.nb {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--text-primary, #1f2937);
}

.screen-card,
.game-screen {
  width: 100%;
  max-width: 720rpx;
  box-sizing: border-box;
}

.screen-card {
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: var(--card-bg, #fff);
  box-shadow: 0 6rpx 28rpx rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.eyebrow {
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 800;
}

.desc {
  margin-top: 12rpx;
  color: var(--text-secondary, #64748b);
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.setting {
  width: 100%;
  margin-top: 28rpx;
}

.setting-title,
.panel-label,
.answer-label {
  display: block;
  color: var(--text-secondary, #64748b);
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.option-row {
  display: flex;
  gap: 12rpx;
}

.option {
  flex: 1;
  padding: 16rpx 8rpx;
  border: 2rpx solid var(--border-light, #e2e8f0);
  border-radius: 14rpx;
  color: var(--text-secondary, #64748b);
  background: var(--bg-tertiary, #f8fafc);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.option.active {
  color: #6d28d9;
  border-color: #8b5cf6;
  background: rgba(139, 92, 246, 0.1);
}

.setting-hint {
  display: block;
  margin-top: 12rpx;
  color: var(--text-tertiary, #94a3b8);
  font-size: 22rpx;
  line-height: 1.45;
}

.summary {
  width: 100%;
  margin: 28rpx 0 20rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary, #f8fafc);
  display: flex;
  justify-content: space-around;
}

.summary view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-label {
  color: var(--text-tertiary, #94a3b8);
  font-size: 22rpx;
}

.summary-value {
  color: var(--text-primary, #1f2937);
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  width: 100%;
  margin: 0;
  padding: 16rpx 24rpx;
  border: 0;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #6d28d9);
  box-shadow: 0 6rpx 18rpx rgba(109, 40, 217, 0.22);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.primary-button[disabled] {
  color: #94a3b8;
  background: #e2e8f0;
  box-shadow: none;
}

.game-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.header {
  width: 100%;
  padding: 8rpx 4rpx;
}

.round-label,
.round-meta {
  display: block;
}

.round-label {
  font-size: 30rpx;
  font-weight: 800;
}

.round-meta {
  margin-top: 4rpx;
  color: var(--text-tertiary, #94a3b8);
  font-size: 22rpx;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: var(--border-light, #e2e8f0);
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: #8b5cf6;
  transition: width 0.2s ease;
}

.stimulus-panel {
  width: 100%;
  min-height: 250rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--card-bg, #fff);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.panel-label {
  margin: 0;
}

.grid {
  display: grid;
  justify-content: center;
}

.cell {
  box-sizing: border-box;
  border: 2rpx solid var(--border-light, #e2e8f0);
  border-radius: 12rpx;
  background: var(--bg-tertiary, #f8fafc);
  transition:
    background 0.12s,
    transform 0.12s;
}

.cell.on {
  transform: scale(1.04);
  border-color: #8b5cf6;
  background: #8b5cf6;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.25);
}

.auditory-panel {
  min-height: 220rpx;
}

.letter-display {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #6d28d9);
  font-size: 46rpx;
  font-weight: 800;
}

.letter-display.showing {
  transform: scale(1.04);
}

.panel-hint,
.status-message,
.feedback-hint {
  color: var(--text-tertiary, #94a3b8);
  font-size: 22rpx;
}

.status-message {
  padding: 8rpx 0;
}

.answer-card,
.feedback-card {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--card-bg, #fff);
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.answer-title,
.feedback-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.answer-group + .answer-group {
  margin-top: 18rpx;
}

.answer-label {
  margin-bottom: 10rpx;
}

.answer-options {
  display: flex;
  gap: 12rpx;
}

.answer-option {
  flex: 1;
  padding: 16rpx;
  border: 2rpx solid var(--border-light, #e2e8f0);
  border-radius: 14rpx;
  color: var(--text-secondary, #64748b);
  background: var(--bg-tertiary, #f8fafc);
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.answer-option.selected {
  color: #6d28d9;
  border-color: #8b5cf6;
  background: rgba(139, 92, 246, 0.1);
}

.submit-button {
  margin-top: 24rpx;
}

.feedback-row,
.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.feedback-row + .feedback-row {
  margin-top: 10rpx;
}

.feedback-row.correct {
  color: #15803d;
  background: rgba(34, 197, 94, 0.12);
}

.feedback-row.wrong {
  color: #b91c1c;
  background: rgba(239, 68, 68, 0.1);
}

.feedback-hint {
  display: block;
  margin-top: 18rpx;
  text-align: center;
}

.result-card {
  gap: 12rpx;
}

.result-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #22c55e;
  font-size: 40rpx;
  font-weight: 800;
}

.score-card {
  width: 100%;
  margin: 16rpx 0 6rpx;
  padding: 24rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(139, 92, 246, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.score-label,
.result-footnote {
  color: var(--text-tertiary, #94a3b8);
  font-size: 22rpx;
}

.score-value {
  color: #6d28d9;
  font-size: 64rpx;
  line-height: 1.2;
  font-weight: 800;
}

.score-detail {
  color: var(--text-secondary, #64748b);
  font-size: 22rpx;
}

.result-row {
  width: 100%;
  box-sizing: border-box;
  color: var(--text-secondary, #64748b);
  background: var(--bg-tertiary, #f8fafc);
}

.result-row text:last-child {
  color: var(--text-primary, #1f2937);
  font-weight: 700;
}

.result-footnote {
  margin: 4rpx 0 12rpx;
}
