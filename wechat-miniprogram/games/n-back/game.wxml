<view class="nb">
  <view wx:if="{{phase === 'idle'}}" class="screen-card">
    <view class="eyebrow">工作记忆训练</view>
    <text class="title">N-Back</text>
    <text class="desc">判断当前刺激是否与 {{n}} 步前相同。开头 {{n}} 个刺激用于熟悉节奏，不用作答。</text>

    <view class="setting">
      <text class="setting-title">训练模式</text>
      <view class="option-row">
        <view class="option {{mode === 'dual' ? 'active' : ''}}" data-mode="dual" bindtap="onModeChange" role="button">双重</view>
        <view class="option {{mode === 'visual' ? 'active' : ''}}" data-mode="visual" bindtap="onModeChange" role="button">仅视觉</view>
        <view class="option {{mode === 'auditory' ? 'active' : ''}}" data-mode="auditory" bindtap="onModeChange" role="button">仅听觉</view>
      </view>
      <text class="setting-hint">{{idleTip}}</text>
    </view>

    <view wx:if="{{mode !== 'auditory'}}" class="setting">
      <text class="setting-title">视觉网格</text>
      <view class="option-row">
        <view class="option {{gridSize === 'small' ? 'active' : ''}}" data-size="small" bindtap="onGridSizeChange" role="button">3 × 3</view>
        <view class="option {{gridSize === 'medium' ? 'active' : ''}}" data-size="medium" bindtap="onGridSizeChange" role="button">4 × 4</view>
      </view>
    </view>

    <view class="summary">
      <view><text class="summary-label">难度</text><text class="summary-value">N = {{n}}</text></view>
      <view><text class="summary-label">轮数</text><text class="summary-value">{{trials}} 轮</text></view>
    </view>
    <button class="primary-button" bindtap="start">开始训练</button>
  </view>

  <view wx:elif="{{phase === 'done'}}" class="screen-card result-card">
    <view class="result-icon">✓</view>
    <text class="title">训练完成</text>
    <text class="desc">N = {{n}} · {{modeLabel}} · {{trials}} 轮</text>
    <view class="score-card">
      <text class="score-label">本次得分</text>
      <text class="score-value">{{score}}</text>
      <text class="score-detail">总体正确率 {{Math.round(result.accuracy * 100)}}% · {{result.correct}} / {{result.total}} 项正确</text>
    </view>
    <view wx:if="{{mode !== 'auditory'}}" class="result-row">
      <text>视觉正确率</text><text>{{Math.round(result.visualAccuracy * 100)}}%</text>
    </view>
    <view wx:if="{{mode !== 'visual'}}" class="result-row">
      <text>听觉正确率</text><text>{{Math.round(result.auditoryAccuracy * 100)}}%</text>
    </view>
    <text wx:if="{{result.avgRt}}" class="result-footnote">平均作答用时 {{result.avgRt}} ms</text>
    <button class="primary-button" bindtap="replay">再练一次</button>
  </view>

  <view wx:else class="game-screen">
    <view class="header">
      <view>
        <text wx:if="{{stimulusIdx < n}}" class="round-label">熟悉阶段 · 第 {{stimulusIdx + 1}} / {{n}} 个刺激</text>
        <text wx:if="{{phase === 'feedback'}}" class="round-label">本轮反馈</text>
        <text wx:if="{{stimulusIdx >= n && phase !== 'feedback'}}" class="round-label">第 {{roundIdx + 1}} / {{trials}} 轮</text>
        <text class="round-meta">N = {{n}} · {{modeLabel}}</text>
      </view>
      <view class="progress-track"><view class="progress-value" style="width:{{roundIdx / trials * 100}}%;"></view></view>
    </view>

    <view wx:if="{{mode !== 'auditory'}}" class="stimulus-panel">
      <text class="panel-label">视觉位置</text>
      <view class="grid" style="grid-template-columns:repeat({{gridCols}}, {{cellSize}}rpx);gap:12rpx;">
        <block wx:for="{{gridCols * gridCols}}" wx:key="*this">
          <view class="cell {{phase === 'show' && index === shownPos ? 'on' : ''}}"
            style="width:{{cellSize}}rpx;height:{{cellSize}}rpx;"></view>
        </block>
      </view>
    </view>

    <view wx:if="{{mode !== 'visual'}}" class="stimulus-panel auditory-panel">
      <text class="panel-label">听觉字母</text>
      <view class="letter-display {{phase === 'show' ? 'showing' : ''}}">♫</view>
      <text class="panel-hint">{{phase === 'show' ? '听辨并记住字母，不显示文字提示' : '听觉刺激将通过语音播放'}}</text>
    </view>

    <view wx:if="{{phase === 'show'}}" class="status-message">
      <text wx:if="{{stimulusIdx < n}}">建立记忆基准…</text>
      <text wx:else>记住刺激…</text>
    </view>
    <view wx:if="{{phase === 'warmup'}}" class="status-message">熟悉阶段，不需要作答</view>

    <view wx:if="{{phase === 'answer'}}" class="answer-card">
      <text class="answer-title">与 {{n}} 步前相比，当前刺激是否相同？</text>
      <view wx:if="{{mode !== 'auditory'}}" class="answer-group">
        <text class="answer-label">视觉位置</text>
        <view class="answer-options">
          <view class="answer-option {{hasVisualAnswer && selectedVisual ? 'selected' : ''}}" data-match="1" bindtap="onVisualAnswer" role="button">相同</view>
          <view class="answer-option {{hasVisualAnswer && !selectedVisual ? 'selected' : ''}}" data-match="0" bindtap="onVisualAnswer" role="button">不同</view>
        </view>
      </view>
      <view wx:if="{{mode !== 'visual'}}" class="answer-group">
        <text class="answer-label">听觉字母</text>
        <view class="answer-options">
          <view class="answer-option {{hasAuditoryAnswer && selectedAuditory ? 'selected' : ''}}" data-match="1" bindtap="onAuditoryAnswer" role="button">相同</view>
          <view class="answer-option {{hasAuditoryAnswer && !selectedAuditory ? 'selected' : ''}}" data-match="0" bindtap="onAuditoryAnswer" role="button">不同</view>
        </view>
      </view>
      <button class="primary-button submit-button" disabled="{{!canSubmit}}" bindtap="submitAnswer">确认答案</button>
    </view>

    <view wx:if="{{phase === 'feedback'}}" class="feedback-card">
      <text class="feedback-title">第 {{roundIdx}} 轮</text>
      <view wx:if="{{lastResult.visual}}" class="feedback-row {{lastResult.visual.ok ? 'correct' : 'wrong'}}">
        <text>视觉</text>
        <text>你选：{{lastResult.visual.said ? '相同' : '不同'}} · 正确：{{lastResult.visual.expected ? '相同' : '不同'}}</text>
      </view>
      <view wx:if="{{lastResult.auditory}}" class="feedback-row {{lastResult.auditory.ok ? 'correct' : 'wrong'}}">
        <text>听觉</text>
        <text>你选：{{lastResult.auditory.said ? '相同' : '不同'}} · 正确：{{lastResult.auditory.expected ? '相同' : '不同'}}</text>
      </view>
      <text class="feedback-hint">继续保持节奏…</text>
    </view>
  </view>
</view>
