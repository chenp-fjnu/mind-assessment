.vs {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tip {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  margin-bottom: 20rpx;
}
.grid {
  display: grid;
  gap: 10rpx;
  justify-content: center;
}
.cell {
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
  transition: transform 0.05s;
}
.cell:active {
  transform: scale(0.98);
}