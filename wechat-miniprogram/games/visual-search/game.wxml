<view class="vs">
  <view class="tip">找出颜色不同的那一个（误点 {{errors}}）</view>
  <view class="grid" style="grid-template-columns:repeat({{size}},1fr);">
    <view
      wx:for="{{cells}}"
      wx:key="index"
      class="cell"
      style="background:{{item}};"
      data-idx="{{index}}"
      bindtap="onTap"
      role="button"
      aria-label="色块"
    ></view>
  </view>
</view>
