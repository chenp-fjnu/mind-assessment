<view class="vs">
  <view class="tip">
    <text>找出颜色不同的那一个</text>
    <text class="sub">第 {{trialIdx + 1}}/{{trials}}  ·  误点 {{errors}}  ·  {{size}}×{{size}}</text>
  </view>
  <view class="grid" style="grid-template-columns:repeat({{size}},1fr);gap:10rpx;justify-content:center;">
    <view
      wx:for="{{cells}}"
      wx:for-index="index"
      wx:key="index"
      class="cell {{item.correct ? 'correct' : ''}} {{item.wrong ? 'wrong' : ''}}"
      style="background:{{item.color}};width:100%;height:{{cellH}}rpx;"
      data-idx="{{index}}"
      bindtap="onTap"
      role="button"
      aria-label="色块"
    ></view>
  </view>
</view>