<view class="dd">
  <view class="info">第 {{idx + 1}} / {{trials}} 题</view>
  <view wx:if="{{phase === 'play' && cur}}" class="row">
    <view
      class="arrow {{cur.cue}}"
      aria-label="箭头"
    >{{cur.dir === 1 ? '→' : '←'}}</view>
  </view>
  <view wx:if="{{phase === 'play'}}" class="sides">
    <view class="side" data-side="l" bindtap="onPick" role="button" aria-label="左">←</view>
    <view class="side" data-side="r" bindtap="onPick" role="button" aria-label="右">→</view>
  </view>
  <view wx:if="{{phase === 'idle'}}" class="tip">蓝=按方向 · 红=按反方向</view>
  <view wx:if="{{phase === 'done'}}" class="tip">完成！</view>
</view>
