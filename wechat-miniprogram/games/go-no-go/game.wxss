.gng {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.info {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 20rpx;
}
.stage {
  width: 100%;
  height: 60vmin;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stim {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
}
.stim.go { background: #22c55e; }
.stim.nogo { background: #ef4444; }
.placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
}
.tap {
  width: 300rpx;
  height: 120rpx;
  margin-top: 10rpx;
}
.tip {
  margin-top: 20rpx;
  color: var(--sub);
  font-size: 24rpx;
}
