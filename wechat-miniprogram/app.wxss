/* ============================================
   全局设计系统 - 统一色彩、间距、阴影、圆角、字体
   所有页面必须通过 CSS 变量使用颜色，禁止硬编码
   单一事实来源：此文件定义所有语义化变量
   支持 .theme-light / .theme-dark 类切换，配合 theme-store.js
   ============================================ */

page {
  min-height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  overflow-x: hidden;
}

.scroll-page {
  min-height: 100vh;
  background: var(--bg-primary);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  overflow-x: hidden;
}

/* ============================================
   CSS 变量定义 - 浅色模式 (默认)
   ============================================ */
.theme-wrapper,
.theme-wrapper.theme-light,
.theme-wrapper.theme-dark,
page {
  min-height: 100vh;
  /* ===== 背景层级 ===== */
  --bg-primary: #fefefe;           /* 页面主背景 - 更柔和的白 */
  --bg-secondary: #fafafa;         /* 区块背景 */
  --bg-tertiary: #f5f5f5;          /* 卡片悬浮/悬停/输入框背景 - 更淡 */
  --bg-inverted: #18181b;          /* 深色背景 */
  --bg-brand: #f3f4f8;             /* 品牌浅色背景 - 极淡灰蓝 */
  --bg-brand-strong: #e8ebf5;      /* 品牌强背景 - 淡灰蓝 */
  --bg-card: #ffffff;              /* 卡片背景 */

  /* ===== 文字层级 ===== */
  --text-primary: #1f1f1f;         /* 主标题 - 稍软化 */
  --text-secondary: #4a4a4a;       /* 副标题/正文 - 更柔和 */
  --text-tertiary: #6b6b6b;        /* 辅助文字/描述 */
  --text-muted: #9e9e9e;           /* 占位/禁用 */
  --text-inverse: #ffffff;         /* 深色背景上 */
  --text-brand: #5a5fc7;           /* 品牌色文字 - 降低饱和度 */
  --text-link: #6b70d1;            /* 链接 - 更柔和 */
  --text-success: #22a86a;         /* 成功 - 稍暗淡 */
  --text-warning: #e09010;         /* 警告 - 稍暗淡 */
  --text-error: #d94a4a;           /* 错误 - 稍暗淡 */

  /* ===== 边框/分割线 ===== */
  --border-light: #ededed;         /* 默认边框 - 更淡 */
  --border-medium: #e0e0e0;        /* 强调边框 - 更淡 */
  --border-dark: #ccc;             /* 重边框 - 更淡 */
  --border-focus: #9aa0e8;         /* 聚焦态 - 更柔和 */
  --border-divider: #ededed;       /* 分割线 */

  /* ===== 交互状态 ===== */
  --interactive-hover: #f5f5f5;
  --interactive-active: #eeeeee;
  --interactive-disabled: #ededed;
  --focus-ring: #b8bbe8;

  /* ===== 阴影 ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  --shadow-lg: 0 16rpx 40rpx rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 24rpx 56rpx rgba(0, 0, 0, 0.06);
  --shadow-glow: 0 0 40rpx rgba(99, 102, 241, 0.08);
  --shadow-glow-assess: 0 0 40rpx rgba(139, 92, 246, 0.1);
  --shadow-glow-method: 0 0 40rpx rgba(6, 182, 212, 0.1);
  --shadow-glow-train: 0 0 40rpx rgba(245, 158, 11, 0.1);

  /* ===== 圆角 ===== */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-xxl: 24rpx;
  --radius-full: 999rpx;

  /* ===== 间距 ===== */
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 20rpx;
  --spacing-xl: 24rpx;
  --spacing-xxl: 32rpx;
  --spacing-xxxl: 40rpx;

  /* ===== 功能色 - 测评 (紫色系 - 清淡版) ===== */
  --color-assess-50: #faf8ff;
  --color-assess-100: #f3efff;
  --color-assess-400: #b897e8;
  --color-assess: #9b7dd8;         /* 主色 - 降低饱和度提高明度 */
  --color-assess-600: #8a6bd0;
  --color-assess-700: #7959c8;
  --color-assess-light: #faf8ff;   /* 浅色背景 - 极淡 */
  --color-assess-dark: #8a6bd0;    /* 深色文字 */
  --color-assess-darker: #7959c8;  /* 更深文字 */

  /* ===== 功能色 - 方法 (青绿色系 - 清淡版) ===== */
  --color-method-50: #f5fdfb;
  --color-method-100: #e8faf3;
  --color-method-400: #5ed8c6;
  --color-method: #4cc4b0;         /* 主色 - 降低饱和度提高明度 */
  --color-method-600: #42b5a2;
  --color-method-700: #38a694;
  --color-method-light: #f5fdfb;   /* 浅色背景 - 极淡 */
  --color-method-dark: #42b5a2;    /* 深色文字 */
  --color-method-darker: #38a694;  /* 更深文字 */

  /* ===== 功能色 - 训练 (琥珀/橙色系 - 清淡版) ===== */
  --color-train-50: #fefdf5;
  --color-train-100: #fdf8e8;
  --color-train-400: #f4c84d;
  --color-train: #e8b438;          /* 主色 - 降低饱和度提高明度 */
  --color-train-600: #d8a330;
  --color-train-700: #c89228;
  --color-train-light: #fefdf5;    /* 浅色背景 - 极淡 */
  --color-train-dark: #d8a330;     /* 深色文字 */
  --color-train-darker: #c89228;   /* 更深文字 */

  /* ===== 品牌色 (Indigo - 清淡版) ===== */
  --color-brand-50: #f3f4f8;
  --color-brand-100: #e8ebf5;
  --color-brand-400: #9aa0e8;
  --color-brand: #7d83d8;          /* 主品牌色 - 降低饱和度 */
  --color-brand-600: #6b70c8;
  --color-brand-700: #5a5fc7;

  /* ===== 渐变预设 ===== */
  --grad-hero: linear-gradient(135deg, #7d83d8 0%, #9b7dd8 50%, #4cc4b0 100%);
  --grad-assess-page: linear-gradient(135deg, #9b7dd8 0%, #b897e8 100%);
  --grad-method-page: linear-gradient(135deg, #4cc4b0 0%, #42b5a2 100%);
  --grad-train-page: linear-gradient(135deg, #e8b438 0%, #f4c84d 100%);
  --grad-assess-card: linear-gradient(135deg, rgba(155,125,216,0.85) 0%, rgba(184,151,232,0.85) 100%);
  --grad-method-card: linear-gradient(135deg, rgba(76,196,176,0.85) 0%, rgba(66,181,162,0.85) 100%);
  --grad-train-card: linear-gradient(135deg, rgba(232,180,56,0.85) 0%, rgba(244,200,77,0.85) 100%);
  --grad-assess-entry: linear-gradient(135deg, #9b7dd8 0%, #8a6bd0 100%);
  --grad-method-entry: linear-gradient(135deg, #4cc4b0 0%, #42b5a2 100%);
  --grad-train-entry: linear-gradient(135deg, #e8b438 0%, #d8a330 100%);
  --grad-divider: linear-gradient(90deg, transparent, var(--border-light), transparent);

  /* ===== 语义化组合色 ===== */
  /* 卡片 */
  --card-bg: var(--bg-card);
  --card-border: var(--border-light);
  --card-shadow: var(--shadow-md);

  /* 按钮 */
  --btn-primary-bg: var(--color-brand);
  --btn-primary-text: var(--text-inverse);
  --btn-secondary-bg: var(--bg-tertiary);
  --btn-secondary-text: var(--text-secondary);
  --btn-ghost-bg: transparent;
  --btn-ghost-text: var(--text-brand);
  --btn-ghost-border: var(--color-brand);
  --btn-disabled-bg: var(--interactive-disabled);
  --btn-disabled-text: var(--text-muted);

  /* 标签/徽章 */
  --badge-assess-bg: var(--color-assess-light);
  --badge-assess-text: var(--color-assess-darker);
  --badge-method-bg: var(--color-method-light);
  --badge-method-text: var(--color-method-darker);
  --badge-train-bg: var(--color-train-light);
  --badge-train-text: var(--color-train-darker);
  --badge-success-bg: #eefaf1;
  --badge-success-text: #22a86a;
  --badge-warning-bg: #fefaf0;
  --badge-warning-text: #e09010;
  --badge-error-bg: #fef0f0;
  --badge-error-text: #d94a4a;

  /* 输入框 */
  --input-bg: var(--bg-tertiary);
  --input-border: var(--border-light);
  --input-border-focus: var(--border-focus);
  --input-text: var(--text-primary);
  --input-placeholder: var(--text-muted);

  /* 搜索栏 */
  --search-bg: var(--bg-card);
  --search-shadow: var(--shadow-sm);

  /* 筛选芯片 */
  --chip-bg: var(--bg-tertiary);
  --chip-text: var(--text-tertiary);
  --chip-active-bg: var(--color-brand);
  --chip-active-text: var(--text-inverse);

  /* 进度条 */
  --progress-bg: var(--bg-tertiary);
  --progress-fill-assess: var(--color-assess);
  --progress-fill-method: var(--color-method);
  --progress-fill-train: var(--color-train);

  /* 结果页特定 */
  --result-head-bg: var(--grad-hero);
  --result-card-bg: var(--bg-card);
  --result-bar-bg: var(--bg-tertiary);
  --result-bipolar-left: var(--bg-tertiary);
  --result-bipolar-right-assess: var(--color-assess);
  --result-bipolar-right-method: var(--color-method);
  --result-bipolar-right-train: var(--color-train);
  --result-note-bg: #fefaf0;
  --result-note-border: #f4c84d;
  --result-note-text: #c89228;

  /* 字体大小系统 */
  --font-size-xs: 20rpx;
  --font-size-sm: 22rpx;
  --font-size-base: 24rpx;
  --font-size-md: 26rpx;
  --font-size-lg: 28rpx;
  --font-size-xl: 30rpx;
  --font-size-2xl: 32rpx;
  --font-size-3xl: 36rpx;
  --font-size-4xl: 40rpx;
  --font-size-5xl: 48rpx;
  --font-size-6xl: 52rpx;
  --font-size-7xl: 64rpx;
  --font-size-hero: 72rpx;

  /* 字重 */
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --font-weight-extrabold: 800;

  /* 行高 */
  --line-height-tight: 1.15;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.7;
  --line-height-loose: 1.8;
}

/* ============================================
   深色模式变量覆盖 - 通过 .theme-wrapper.theme-dark 类激活
   ============================================ */
.theme-wrapper.theme-dark {
  /* 背景层级 */
  --bg-primary: #0a0a0c;
  --bg-secondary: #141416;
  --bg-tertiary: #1e1e20;
  --bg-inverted: #fafafa;
  --bg-brand: rgba(125, 131, 216, 0.1);
  --bg-brand-strong: rgba(125, 131, 216, 0.15);
  --bg-card: #141416;

  /* 文字层级 */
  --text-primary: #f0f0f0;
  --text-secondary: #b8b8b8;
  --text-tertiary: #888888;
  --text-muted: #6a6a6a;
  --text-inverse: #0a0a0c;
  --text-brand: #a8acf0;
  --text-link: #b0b4e8;
  --text-success: #5ed98f;
  --text-warning: #f0c858;
  --text-error: #e88080;

  /* 边框/分割线 */
  --border-light: #2a2a2e;
  --border-medium: #38383c;
  --border-dark: #4a4a4e;
  --border-focus: #9aa0e8;
  --border-divider: #2a2a2e;

  /* 交互状态 */
  --interactive-hover: #1a1a1c;
  --interactive-active: #222224;
  --interactive-disabled: #2a2a2e;
  --focus-ring: #b8bbe8;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  --shadow-lg: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
  --shadow-xl: 0 24rpx 56rpx rgba(0, 0, 0, 0.35);
  --shadow-glow: 0 0 40rpx rgba(125, 131, 216, 0.15);
  --shadow-glow-assess: 0 0 40rpx rgba(155, 125, 216, 0.18);
  --shadow-glow-method: 0 0 40rpx rgba(76, 196, 176, 0.18);
  --shadow-glow-train: 0 0 40rpx rgba(232, 180, 56, 0.18);

  /* 功能色 - 深色模式清淡版 */
  --color-assess-50: rgba(155, 125, 216, 0.1);
  --color-assess-100: rgba(155, 125, 216, 0.15);
  --color-assess-400: #b897e8;
  --color-assess: #9b7dd8;
  --color-assess-600: #b897e8;
  --color-assess-700: #c8afe8;
  --color-assess-light: rgba(155, 125, 216, 0.1);
  --color-assess-dark: #b897e8;
  --color-assess-darker: #c8afe8;

  --color-method-50: rgba(76, 196, 176, 0.1);
  --color-method-100: rgba(76, 196, 176, 0.15);
  --color-method-400: #5ed8c6;
  --color-method: #4cc4b0;
  --color-method-600: #5ed8c6;
  --color-method-700: #7edec8;
  --color-method-light: rgba(76, 196, 176, 0.1);
  --color-method-dark: #5ed8c6;
  --color-method-darker: #7edec8;

  --color-train-50: rgba(232, 180, 56, 0.1);
  --color-train-100: rgba(232, 180, 56, 0.15);
  --color-train-400: #f4c84d;
  --color-train: #e8b438;
  --color-train-600: #f4c84d;
  --color-train-700: #f6d478;
  --color-train-light: rgba(232, 180, 56, 0.1);
  --color-train-dark: #f4c84d;
  --color-train-darker: #f6d478;

  --color-brand-50: rgba(125, 131, 216, 0.1);
  --color-brand-100: rgba(125, 131, 216, 0.15);
  --color-brand-400: #9aa0e8;
  --color-brand: #7d83d8;
  --color-brand-600: #9aa0e8;
  --color-brand-700: #abaef0;

  /* 渐变 - 深色模式更柔和清淡 */
  --grad-hero: linear-gradient(135deg, #7d83d8 0%, #9b7dd8 50%, #4cc4b0 100%);
  --grad-assess-page: linear-gradient(135deg, #9b7dd8 0%, #b897e8 100%);
  --grad-method-page: linear-gradient(135deg, #4cc4b0 0%, #42b5a2 100%);
  --grad-train-page: linear-gradient(135deg, #e8b438 0%, #f4c84d 100%);
  --grad-assess-card: linear-gradient(135deg, rgba(155,125,216,0.8) 0%, rgba(184,151,232,0.8) 100%);
  --grad-method-card: linear-gradient(135deg, rgba(76,196,176,0.8) 0%, rgba(66,181,162,0.8) 100%);
  --grad-train-card: linear-gradient(135deg, rgba(232,180,56,0.8) 0%, rgba(244,200,77,0.8) 100%);
  --grad-assess-entry: linear-gradient(135deg, #9b7dd8 0%, #8a6bd0 100%);
  --grad-method-entry: linear-gradient(135deg, #4cc4b0 0%, #42b5a2 100%);
  --grad-train-entry: linear-gradient(135deg, #e8b438 0%, #d8a330 100%);
  --grad-divider: linear-gradient(90deg, transparent, var(--border-light), transparent);

  /* 语义化组合色 - 深色模式 */
  --card-bg: var(--bg-card);
  --card-border: var(--border-light);
  --card-shadow: var(--shadow-md);

  --btn-primary-bg: var(--color-brand);
  --btn-primary-text: var(--text-inverse);
  --btn-secondary-bg: var(--bg-tertiary);
  --btn-secondary-text: var(--text-secondary);
  --btn-ghost-bg: transparent;
  --btn-ghost-text: var(--text-brand);
  --btn-ghost-border: var(--color-brand-400);
  --btn-disabled-bg: var(--interactive-disabled);
  --btn-disabled-text: var(--text-muted);

  --badge-assess-bg: var(--color-assess-light);
  --badge-assess-text: var(--color-assess-dark);
  --badge-method-bg: var(--color-method-light);
  --badge-method-text: var(--color-method-dark);
  --badge-train-bg: var(--color-train-light);
  --badge-train-text: var(--color-train-dark);
  --badge-success-bg: rgba(34, 168, 106, 0.15);
  --badge-success-text: #5ed98f;
  --badge-warning-bg: rgba(224, 144, 16, 0.15);
  --badge-warning-text: #f0c858;
  --badge-error-bg: rgba(217, 74, 74, 0.15);
  --badge-error-text: #e88080;

  --input-bg: var(--bg-tertiary);
  --input-border: var(--border-light);
  --input-border-focus: var(--border-focus);
  --input-text: var(--text-primary);
  --input-placeholder: var(--text-muted);

  --search-bg: var(--bg-card);
  --search-shadow: var(--shadow-sm);

  --chip-bg: var(--bg-tertiary);
  --chip-text: var(--text-tertiary);
  --chip-active-bg: var(--color-brand);
  --chip-active-text: var(--text-inverse);

  --progress-bg: var(--bg-tertiary);
  --progress-fill-assess: var(--color-assess);
  --progress-fill-method: var(--color-method);
  --progress-fill-train: var(--color-train);

  --result-head-bg: var(--grad-hero);
  --result-card-bg: var(--bg-card);
  --result-bar-bg: var(--bg-tertiary);
  --result-bipolar-left: var(--bg-tertiary);
  --result-bipolar-right-assess: var(--color-assess);
  --result-bipolar-right-method: var(--color-method);
  --result-bipolar-right-train: var(--color-train);
  --result-note-bg: rgba(232, 180, 56, 0.12);
  --result-note-border: #f4c84d;
  --result-note-text: #f0c858;
}

/* ============================================
   通用基础组件
   ============================================ */
.card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: var(--radius-full);
  color: var(--btn-primary-text);
  text-align: center;
  font-weight: var(--font-weight-semibold);
  background: var(--btn-primary-bg);
}

.btn-secondary {
  background: var(--btn-secondary-bg);
  color: var(--btn-secondary-text);
}

.btn-ghost {
  background: var(--btn-ghost-bg);
  color: var(--btn-ghost-text);
  border: 2rpx solid var(--btn-ghost-border);
}

.btn:disabled,
.btn[disabled] {
  background: var(--btn-disabled-bg);
  color: var(--btn-disabled-text);
}

.muted {
  color: var(--text-muted);
}

button::after {
  border: none;
}

/* ============================================
   通用工具类
   ============================================ */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-muted { color: var(--text-muted); }
.text-brand { color: var(--text-brand); }
.text-link { color: var(--text-link); }
.text-inverse { color: var(--text-inverse); }
.text-success { color: var(--text-success); }
.text-warning { color: var(--text-warning); }
.text-error { color: var(--text-error); }

.bg-primary { background: var(--bg-primary); }
.bg-secondary { background: var(--bg-secondary); }
.bg-tertiary { background: var(--bg-tertiary); }
.bg-brand { background: var(--bg-brand); }
.bg-brand-strong { background: var(--bg-brand-strong); }
.bg-card { background: var(--bg-card); }

.border-light { border-color: var(--border-light); }
.border-medium { border-color: var(--border-medium); }
.border-focus { border-color: var(--border-focus); }

.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.shadow-xl { box-shadow: var(--shadow-xl); }

.rounded-sm { border-radius: var(--radius-sm); }
.rounded-md { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-xl { border-radius: var(--radius-xl); }
.rounded-xxl { border-radius: var(--radius-xxl); }
.rounded-full { border-radius: var(--radius-full); }

/* ============================================
   功能色工具类
   ============================================ */
/* 测评 - 紫色系 */
.bg-assess-light { background: var(--color-assess-light); }
.text-assess { color: var(--color-assess-darker); }
.text-assess-dark { color: var(--color-assess-dark); }
.border-assess { border-color: var(--color-assess); }
.badge-assess { background: var(--badge-assess-bg); color: var(--badge-assess-text); }
.grad-assess { background: var(--grad-assess-card); }
.grad-assess-entry { background: var(--grad-assess-entry); }
.grad-assess-page { background: var(--grad-assess-page); }

/* 方法 - 青绿色系 */
.bg-method-light { background: var(--color-method-light); }
.text-method { color: var(--color-method-darker); }
.text-method-dark { color: var(--color-method-dark); }
.border-method { border-color: var(--color-method); }
.badge-method { background: var(--badge-method-bg); color: var(--badge-method-text); }
.grad-method { background: var(--grad-method-card); }
.grad-method-entry { background: var(--grad-method-entry); }
.grad-method-page { background: var(--grad-method-page); }

/* 训练 - 琥珀色系 */
.bg-train-light { background: var(--color-train-light); }
.text-train { color: var(--color-train-darker); }
.text-train-dark { color: var(--color-train-dark); }
.border-train { border-color: var(--color-train); }
.badge-train { background: var(--badge-train-bg); color: var(--badge-train-text); }
.grad-train { background: var(--grad-train-card); }
.grad-train-entry { background: var(--grad-train-entry); }
.grad-train-page { background: var(--grad-train-page); }

/* 品牌色 */
.bg-brand-light { background: var(--color-brand-50); }
.text-brand-main { color: var(--color-brand-600); }
.border-brand { border-color: var(--color-brand); }
.grad-hero { background: var(--grad-hero); }